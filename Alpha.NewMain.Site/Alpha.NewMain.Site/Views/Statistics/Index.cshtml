@using Alpha.NewMain.Site.Models.Views.Report.Statistics;
@using SiteServices = Alpha.NewMain.Site.Services;
@using Alpha.NewMain.Site.App_GlobalResources;
@using Sunplus.Agent.Model.Entities.Permission;
@model StatisticsViewModel
@{
    Layout = "";
    var contentSite = SiteServices.AppSettings.ContentSite;
    var isEvenRow = false;
}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap/css/bootstrap.min.css" />
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/reset.css" />
    @Styles.Render("~/bundle/styles/statistics")
</head>
<body>
    <div class="section-content">
        <div class="container-fluid">
            <div calss="row">
                <div class="col-sm-6 panel">
                    <div class="panel-title"><span></span>@Resources.yourStatistics</div>
                    <div class="panel-content">
                        <div class="row">
                            <div class="col-sm-7">@Model.Label_Outstanding</div>
                            <div class="col-sm-5 text-right">@Html.Raw(Model.Outstanding)</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-7">@Resources.totalOutstanding</div>
                            <div class="col-sm-5 text-right">@Html.Raw(Model.TotalOutstanding)</div>
                        </div>
                        @if (UserPermission.IsShowCasino)
                        {
                            <div class="row">
                                <div class="col-sm-7">@Resources.totalCSTransferOutstanding</div>
                                <div class="col-sm-5 text-right">@Html.Raw(Model.CasinoTransfer)|@Html.Raw(Model.CasinoOutstanding)</div>
                            </div>
                        }
                        @if (UserPermission.IsShowBingo)
                        {
                            <div class="row">
                                <div class="col-sm-7">@Resources.totalBGTransferOutstanding</div>
                                <div class="col-sm-5 text-right">@Html.Raw(Model.BingoTransfer)| @Html.Raw(Model.BingoOutstanding)</div>
                            </div>
                        }
                        @if (UserPermission.IsShowP2P)
                        {
                            <div class="row">
                                <div class="col-sm-7">@Resources.totalP2PTransferOutstanding</div>
                                <div class="col-sm-5 text-right">@Html.Raw(Model.P2PTransfer)| @Html.Raw(Model.P2POutstanding)</div>
                            </div>
                        }
                        <div class="row">
                            <div class="col-sm-12 viewdetail-link total-activeclosedsuspened">
                                @Resources.totalActiveClosedSuspended
                                <img class="viewdetail-icon" alt="@Resources.show" src="~/Content/Images/collapse.png" />
                                <div class="div-detail display-none total-activeclosedsuspened-detail" data-target="total-activeclosedsuspened">
                                    <table class="table-detail">
                                        @if (Model.MemberStatus != null && Model.MemberStatus.Any())
                                        {
                                            foreach (var status in Model.MemberStatus)
                                            {
                                                <tr class="@(isEvenRow ? "odd-row" : "even-row")">
                                                    <td class="align-left">
                                                        @status.Level
                                                    </td>
                                                    <td class="align-right">
                                                        <span class="active bold">
                                                            @status.TotalActive
                                                        </span>
                                                        |<span class="closed bold">
                                                            @status.TotalClosed
                                                        </span>
                                                        |<span class="suspended bold">
                                                            @status.TotalSuspended
                                                        </span>
                                                    </td>
                                                </tr>
                                                isEvenRow = !isEvenRow;
                                            }
                                        }
                                        else
                                        {
                                            <tr class="odd-row"><td colspan="2" class="align-center bold">@Resources.noInfo</td></tr>
                                        }
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12 viewdetail-link top10-winningmembers">
                                @Resources.top10WinningMembers
                                <img class="viewdetail-icon" alt="@Resources.show" src="~/Content/Images/collapse.png" />
                                <div class="div-detail display-none top10-winningmembers-detail" data-target="top10-winningmembers">

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12 viewdetail-link highestturnover">
                                @Resources.highestTurnoverOfTheMonth
                                <img class="viewdetail-icon" alt="@Resources.show" src="~/Content/Images/collapse.png" />
                                <div class="div-detail display-none highestturnover-detail" data-target="highestturnover">

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12 viewdetail-link newmember">
                                @Resources.newMemberOfTheMonth: <span class="bold">@Model.NumberNewMembers</span>
                                <img class="viewdetail-icon" alt="@Resources.show" src="~/Content/Images/collapse.png" />
                                <div class="div-detail display-none newmember-detail" data-target="newmember">

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript" src="/@contentSite/libs/jquery/jquery-1.11.3.min.js"></script>
    <script type="text/javascript" src="/@contentSite/css/bootstrap/js/bootstrap.min.js"></script>
    @Scripts.Render("~/bundles/scripts/statistics")
    <script type="text/javascript">
        var rootUrl = '@Url.Content("~")';
        var resources = {
            username: '@Resources.username',
            winningAmount: '@Resources.winningAmount',
            turnover: '@Resources.turnover',
            createdDate: '@Resources.createdDate',
            givenCredit: '@Resources.givenCredit',
            noInfo: '@Resources.noInfo'
        };
    </script>
</body>
</html>