@using Alpha.NewMain.Site.Services;
@using Sunplus.Agent.Model.Entities;
@using Alpha.NewMain.Site.App_GlobalResources;
@using Alpha.NewMain.Site.Models.Views;
@model MainIndexViewModel
@{
    Layout = "";
    var contentSite = AppSettings.ContentSite;
    var currentUserSession = UserSession.Current;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title></title>
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap/css/bootstrap.min.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap-material/bootstrap-material-design.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap-material/ripples.min.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/Fonts/iconMoon/style.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/reset.css">
    <link type="text/css" rel="stylesheet" href="~/Views/Main/Styles/css/page.css">
    <link type="text/css" rel="stylesheet" href="~/Views/Main/Styles/css/Dashboard.css">
    <link type="text/css" rel="stylesheet" href="~/Views/CustomerProfile/Styles/css/CustomerProfile.css">
    <link type="text/css" rel="stylesheet" href="@("Views/Main/Styles/css/LevelCustomStyle" + currentUserSession.RoleId+ ".css")">
</head>
<body>
    <div id="popup-top" class="display-none">
        <div id="popup-line">
            <a class="top-message">
                <img class="button-close" alt="@Resources.close" title="@Resources.close" />
            </a>
        </div>
        <div class="popup-content">
            <div id="popup-contents" class="messageBlock"></div>
            <div id="popup-contents-2" class="messageBlock"></div>
        </div>
    </div>
    <div class="header">
        <div id="logo" class="header-left">
        </div>
        <div class="header-right">
            <div class="header-right-top">
                <span class="icon-collapse icon-hamburger icon--m c-White"></span>
                <ul class="list-top">
                    <li><span class="icon icon-time opacity-80"></span><span class="txt-top" id="clock"></span></li>
                    <li>
                        <span class="icon icon-flag language-selector langFlag_<%= currentUserSession.LangKey.ToLower() %>"></span>
                        <span class="language-text language-selector"></span>
                        <ul class="list-language">
                            <li class="en-US"><a href="javascript:ChangeLang('en-US')">English</a></li>
                            <li class="zh-TW"><a href="javascript:ChangeLang('zh-TW')">繁體中文</a></li>
                            <li class="zh-CN"><a href="javascript:ChangeLang('zh-CN')">简体中文</a></li>
                            <li class="ja-JP"><a href="javascript:ChangeLang('ja-JP')">日本語</a></li>
                            <li class="th-TH"><a href="javascript:ChangeLang('th-TH')">ภาษาไทย</a></li>
                            <li class="ko-KR"><a href="javascript:ChangeLang('ko-KR')">한국어</a></li>
                            <li class="vi-VN"><a href="javascript:ChangeLang('vi-VN')">Tiếng Việt</a></li>
                        </ul>
                    </li>
                    <li>
                        <span class="icon icon-squares opacity-80 top-right-menu"></span>
                        <ul class="list-setting">
                            <li><a href="_HowToUse/Index.aspx" target="blank"><span class="icon icon-help"></span><%= Resources.HowToUse.Help %></a></li>
                            <li><a href="javascript:Change2Menu('Company/ContactUs/Index')"><span class="icon icon-contactus"></span><%= Resources.Lang.ContactUs %></a></li>
                            <li><a href="ContextualCustomer/ProfilePicture?custId=<%= currentUserSession.CustId %>" target="<%= contentFrame %>"><span class="icon icon-profilepic"></span><%= Resources.ProfilePicture.EditProfilePicture %></a></li>
                            <li><a href="javascript:Change2Menu('_MemberInfo/ChangePassword/ChangePassword.aspx')"><span class="icon icon-lock"></span><%= Resources.Lang.password %></a></li>
                            <li><a href="javascript:Change2Menu('Security/SecurityCode/ChangeSecurityCode')"><span class="icon icon-sercuritycode"></span><%= Resources.Lang.SecurityCode %></a></li>
                        </ul>
                    </li>
                    <li><span class="icon icon-logout opacity-80"></span></li>
                </ul>
            </div>
        </div>
    </div>
    <iframe src="" frameborder="0" id="main" scrolling="auto"
            name="main" width="100%" height="100%" marginwidth="0" marginheight="0" allowtransparency="yes" class="iframe-content"></iframe>

    <script type="text/javascript" src="/@contentSite/libs/jquery/jquery-1.8.2.min.js"></script>
    <script type="text/javascript" src="~/Views/CustomerProfile/Scripts/ViewProfile.js"></script>
    <script type="text/javascript" src="~/Views/Main/Scripts/Dashboard.js"></script>
    <script type="text/javascript">

    </script>
</body>
</html>
