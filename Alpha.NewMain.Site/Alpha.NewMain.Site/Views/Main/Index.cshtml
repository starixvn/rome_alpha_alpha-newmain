@using Alpha.NewMain.Site.Services;
@using Sunplus.Agent.Model.Entities;
@using Alpha.NewMain.Site.App_GlobalResources;
@using Alpha.NewMain.Site.Models.Views;
@model MainIndexViewModel
@{
    Layout = "";
    var contentSite = AppSettings.ContentSite;
    var mainSite = AppSettings.MainSite;
    var currentUserSession = UserSession.Current;
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    var contentFrame = "main";
    var mainPage = Model.IsMainPageFromCookie ? Model.MainPage : "../" + mainSite + "/" + Model.MainPage;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title></title>
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap/css/bootstrap.min.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap-material/bootstrap-material-design.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap-material/ripples.min.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/Fonts/iconMoon/style.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/reset.css">
    <link type="text/css" rel="stylesheet" href="~/Views/Main/Styles/css/page.css">
    <link type="text/css" rel="stylesheet" href="~/Views/Main/Styles/css/Dashboard.css">
    <link type="text/css" rel="stylesheet" href="~/Views/Main/Styles/css/PopupMessage.css">
    <link type="text/css" rel="stylesheet" href="~/Views/CustomerProfile/Styles/css/CustomerProfile.css">
    <link type="text/css" rel="stylesheet" href="~/@("Views/Main/Styles/css/LevelCustomStyle" + currentUserSession.RoleId + ".css")">
</head>
<body>
    <div id="popup-top" class="display-none">
        <div id="popup-line">
            <a class="top-message">
                <img src="~/Views/Main/Styles/Images/icon_close.jpg" class="button-close" alt="@Resources.close" title="@Resources.close" />
            </a>
        </div>
        <div class="popup-content">
            <div id="popup-contents" class="messageBlock"></div>
            <div id="popup-contents-2" class="messageBlock"></div>
        </div>
    </div>
    <div class="header">
        <div id="logo" class="header-left">
        </div>
        <div class="header-right">
            <div class="header-right-top">
                <span class="icon-collapse icon-hamburger icon--m c-White"></span>
                <ul class="list-top">
                    <li><span class="icon icon-time opacity-80"></span><span class="txt-top" id="clock"></span></li>
                    <li>
                        <span class="icon icon-flag language-selector langFlag_@currentUserSession.LangKey.ToLower()"></span>
                        <span class="language-text language-selector"></span>
                        <ul class="list-language">
                            @foreach (var language in Model.Languages)
                            {
                                <li class="@language.LanguageCode"><a class="changelanguage-link" data-value="@language.LanguageCode">@language.LanguageName</a></li>
                            }
                        </ul>
                    </li>
                    <li>
                        <span class="icon icon-squares opacity-80 top-right-menu"></span>
                        <ul class="list-setting">
                            <li><a href="/@mainSite/_HowToUse/Index.aspx" target="blank"><span class="icon icon-help"></span>@Resources.Help</a></li>
                            <li><a href="javascript:dashboardManager.changeMenu('../@mainSite/Company/ContactUs/Index')"><span class="icon icon-contactus"></span>@Resources.ContactUs</a></li>
                            <li><a href="/@mainSite/ContextualCustomer/ProfilePicture?custId=@currentUserSession.CustId" target="@contentFrame"><span class="icon icon-profilepic"></span>@Resources.EditProfilePicture</a></li>
                            <li><a href="javascript:dashboardManager.changeMenu('../@mainSite/_MemberInfo/ChangePassword/ChangePassword.aspx')"><span class="icon icon-lock"></span>@Resources.password</a></li>
                            <li><a href="javascript:dashboardManager.changeMenu('../@mainSite/Security/SecurityCode/ChangeSecurityCode')"><span class="icon icon-sercuritycode"></span>@Resources.SecurityCode</a></li>
                        </ul>
                    </li>
                    <li><span class="icon icon-logout opacity-80"></span></li>
                </ul>
            </div>
            <div class="header-right-bottom">
                <div class="live-status">
                    <span class="icon icon-home c-Primary"></span>
                    <div id="text-news-out">
                        <span id="scroller">
                            <span id="live-message" class="maquee live-message"></span>
                        </span>
                    </div>
                </div>
                <div class="botom-right">
                    <span class="icon icon-add c-Primary special-message"></span>
                    <div class="email-box private-message"><span class="icon icon-message c-Primary"></span><span class="value">0</span></div>
                </div>
            </div>

        </div>
    </div>
    <div class="content">
        <div class="content-right">
            <iframe src="@mainPage" frameborder="0" id="@contentFrame" scrolling="auto"
                    name="main" marginwidth="0" marginheight="0" allowtransparency="yes" class="iframe-content"></iframe>
        </div>
    </div>

    <script type="text/javascript" src="/@contentSite/libs/jquery/jquery-1.8.2.min.js"></script>
    <script type="text/javascript" src="~/Views/CustomerProfile/Scripts/ViewProfile.js"></script>
    <script type="text/javascript" src="~/Views/Main/Scripts/Core.js"></script>
    <script type="text/javascript" src="~/Views/Main/Scripts/Header.js"></script>
    <script type="text/javascript" src="~/Views/Main/Scripts/Dashboard.js"></script>
    <script type="text/javascript">
        var rootUrl = '@Url.Content("~")';
        var mainSite = '@mainSite';
        var contentFrame = "@contentFrame";
        var _resources = {
            language: '@currentUserSession.Language',
            onUserId: '@currentUserSession.OnUserId',
            cookieCurrentURLKey: '@Model.CookieCurrentURLKey',
            baseUrl: '@Model.BaseUrl',
            msgList: @Html.Raw(serializer.Serialize(Model.HotMessages)),

            months:@Html.Raw(serializer.Serialize(Model.MonthNames)),
            year: @DateTime.Now.Year,
            month:@DateTime.Now.Month,
            day:@DateTime.Now.Day,
            hrs:@DateTime.Now.Hour,
            min:@DateTime.Now.Minute,
            sec:@DateTime.Now.Second,
            PM:'@Resources.PM',
            AM:'@Resources.AM'
        };

    </script>
</body>
</html>
