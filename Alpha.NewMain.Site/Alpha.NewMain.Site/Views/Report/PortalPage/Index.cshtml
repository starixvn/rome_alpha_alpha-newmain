@using SiteServices = Alpha.NewMain.Site.Services;
@using Alpha.NewMain.Site.App_GlobalResources;
@using Alpha.NewMain.Site.Models.Views.Report;
@model PortalPageViewModel
@{
    Layout = "";
    var contentSite = SiteServices.AppSettings.ContentSite;
    var balanceInfo = Model.BalanceInfo;
    var announcements = Model.Announcements;
    var isEvenRowAnnouncement = false;
}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap/css/bootstrap.min.css" />
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/reset.css" />
    <link type="text/css" rel="stylesheet" href="~/Content/Report/PortalPage/Styles/css/BalanceInfo.css" />
    <link type="text/css" rel="stylesheet" href="~/Content/Report/PortalPage/Styles/css/Announcement.css" />
    <link type="text/css" rel="stylesheet" href="~/Content/Report/PortalPage/Styles/css/PortalPage.css" />
</head>
<body>
    <div class="section-content">
        <div class="container-fluid">
            <div calss="row">
                <div class="col-sm-6 panel">
                    <div class="panel-title"><span></span>@Resources.balanceInfo</div>
                    <div class="panel-content">
                        <div class="row">
                            <div class="col-sm-7">@balanceInfo.RoleName</div>
                            <div class="col-sm-5 text-right">Supertest1</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-7">@Resources.currency</div>
                            <div class="col-sm-5 text-right">@balanceInfo.Currency</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-7">@Resources.cashBalance</div>
                            <div class="col-sm-5 text-right">@Html.Raw(balanceInfo.HasData ? balanceInfo.CashBalance : string.Empty)</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-7">@Resources.yesterdayCashBalance</div>
                            <div class="col-sm-5 text-right">@Html.Raw(balanceInfo.HasData ? balanceInfo.YesterdayCashBalance : string.Empty)</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-7">@Resources.totalBalance</div>
                            <div class="col-sm-5 text-right">@Html.Raw(balanceInfo.HasData ? balanceInfo.TotalBalance : string.Empty)</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-7">@Resources.yesterdayTotalBalance</div>
                            <div class="col-sm-5 text-right">@Html.Raw(balanceInfo.HasData ? balanceInfo.YesterdayTotalBalance : string.Empty)</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-7">@(Resources.todayWinLoss + " (" + balanceInfo.Today + ")")</div>
                            <div class="col-sm-5 text-right">@Html.Raw(balanceInfo.HasData ? balanceInfo.TodayWinLoss : string.Empty)</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-7">@(Resources.yesterdayWinLoss + " (" + balanceInfo.Yesterday + ")")</div>
                            <div class="col-sm-5 text-right">@Html.Raw(balanceInfo.HasData ? balanceInfo.YesterdayWinLoss : string.Empty)</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-7">@balanceInfo.GivenCreditText</div>
                            <div class="col-sm-5 text-right">@Html.Raw(balanceInfo.HasData ? balanceInfo.GivenCredit : string.Empty)</div>
                        </div>
                        <div class="row">
                            <div class="col-sm-7">@balanceInfo.TotalDownlineCreditText</div>
                            <div class="col-sm-5 text-right">@Html.Raw(balanceInfo.HasData ? balanceInfo.TotalDownlineCredit : string.Empty)</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div id="carousel-example-generic" class="carousel slide" data-ride="carousel">
                        <ol class="carousel-indicators">
                            <li data-target="#carousel-example-generic" data-slide-to="0" class="active"></li>
                            <li data-target="#carousel-example-generic" data-slide-to="1"></li>
                            <li data-target="#carousel-example-generic" data-slide-to="2"></li>
                        </ol>
                        <div class="carousel-inner" role="listbox">
                            <div class="item active">
                                <img src="~/Content/Report/PortalPage/Styles/Images/slide01.png" />
                            </div>
                            <div class="item">
                                <img src="~/Content/Report/PortalPage/Styles/Images/slide02.png" />
                            </div>
                            <div class="item">
                                <img src="~/Content/Report/PortalPage/Styles/Images/slide03.png" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div calss="row">
                <div class="col-sm-12 panel">
                    @if (announcements.IsShowAnnouncementTitle)
                    {
                        <div class="panel-title announcement-title"><span></span>@Resources.announcement</div>
                    }
                    <div class="panel-content announcement-content">
                        @if (announcements.AnnouncementGroup.Any())
                        {
                            foreach (var announcementGroup in announcements.AnnouncementGroup)
                            {
                                <div class="date-item">
                                    <div class="date-announcement">@announcementGroup.GroupId</div>
                                    <div class="date-list-row">
                                        <table class="date-row-item">
                                            <tbody>
                                                @foreach (var announcement in announcementGroup.AnnouncementItems)
                                                {
                                                    <tr class="@(isEvenRowAnnouncement ? "even" : "") announcement-@announcement.Id">
                                                        <td class="col-paddingleft">
                                                            <div>&nbsp;</div>
                                                        </td>
                                                        <td class="col-posttime">
                                                            <div>@announcement.PostTime</div>
                                                        </td>
                                                        <td class="col-message">
                                                            <div class="toogleIcon @(announcement.BriefContent == announcement.FullContent ? "" : "showfullcontent-icon")" data-announcementid="@announcement.Id"></div>
                                                            <div class="col-message announcement-fullcontent display-none">@Html.Raw(announcement.FullContent)</div>
                                                            <div class="col-message announcement-briefcontent">@Html.Raw(announcement.BriefContent)</div>
                                                        </td>
                                                    </tr>
                                                    isEvenRowAnnouncement = !isEvenRowAnnouncement;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }

                            if (announcements.IsShowMoreLink)
                            {
                                <div class="viewmore-link">@Resources.more ...</div>
                            }
                        }
                        else
                        {
                            <div class="no-information">@Resources.noInfo</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript" src="/@contentSite/libs/jquery/jquery-1.11.3.min.js"></script>
    <script type="text/javascript" src="/@contentSite/css/bootstrap/js/bootstrap.min.js"></script>
    <script type="text/javascript" src="~/Views/Shared/Scripts/SharedScripts.js"></script>
    <script type="text/javascript" src="~/Views/Report/PortalPage/Scripts/PortalPage.js"></script>
    <script type="text/javascript">
        var rootUrl = '@Url.Content("~")';
        var isEvenRowAnnouncement = @(isEvenRowAnnouncement ? 1:0);
        var resources = {
            more: '@Resources.more'
        };
    </script>
</body>
</html>