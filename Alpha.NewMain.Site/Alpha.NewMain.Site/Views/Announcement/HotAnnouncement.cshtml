@using Alpha.NewMain.Site.Models.Dtos.Announcement;
@using Alpha.NewMain.Site.App_GlobalResources;
@model HotAnnouncementModel
@{
    Layout = "";
}

@if (string.IsNullOrEmpty(Model.Content))
{
    Html.Raw("-");
}
else if (string.IsNullOrEmpty(Model.Source))
{
    <div id="popup-container-text" style="top: @(Model.Top + "px");
         left: @(Model.Left + "px");"
         class="ui-draggable">
        <div class="@("toptitlepopup_" + Model.LanguagueCode)">
            <div class="advertisement">
                <a href="javascript:;" onclick="announcementManager.removeAnnouncement();" title="@Resources.close">
                    <img src="~/Content/Announcements/Styles/Images/iconClose.png"
                         alt="@Resources.close" class="icon-close" />
                </a>
            </div>
        </div>
        <div class="paddingleft">
            <div class="linebg">
                <div>
                    <div class="message">
                        @Html.Raw(Model.Content)
                    </div>
                </div>
                <div class='lineblue'></div>
                <div class='linewhite'></div>
            </div>
            <div class="bottomborder"></div>
        </div>
    </div>
    <input id="announcement-cookies-id" value="@Model.CookieId" type="hidden" />
    <input id="popup-id" value="@Model.Id" type="hidden" />
}
else {
    <div id="popup-container" style="width: @(Model.Width + "px");
            top: @(Model.Top + "px"); left: @(Model.Left + "px");">
        <iframe frameborder="0" allowtransparency="yes" marginheight="0" marginwidth="0" scrolling="no"
                src="@Model.Source" width="@Model.Width" height="@Model.Height"></iframe>
        <div id="closePopup" class="close-advertisement">
            <a href="javascript:;" onclick="parent.announcementManager.removeAnnouncement();" title="@Resources.close">
                <img src="~/Content/Announcements/Styles/Images/close_button.png"
                     alt="@Resources.close"
                     class="icon-close" />
            </a>
        </div>
        <div class="notshow-advertisement">
            <input type="checkbox" id="chkHide" onclick="announcementManager.doNotShowAnnoucement(this.checked)" />
            <label for="chkHide" class="lblHide">
                @Resources.doNotShowAgain
            </label>
        </div>
    </div>
    <input id="announcement-cookies-id" value="@Model.CookieId" type="hidden" />
    <input id="popup-id" value="@Model.Id" type="hidden" />
}