@model VerifyOtpDifferenceDeviceViewModel

@{
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}

@section css {
    @StaticResources.AssetStyles.Render($"/bundles/common/common")
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/before-home-page")
}

<div class="block">
    <form class="form-SC form-validation" id="otp-form">
        @Html.Action("Languages", "SecurityCode")
        <h1 class="title">OTP</h1>
        <p> @string.Format(Security.OtpHiMessage, Model.UsernameShower)</p>
        <figure class="avatar">
            <img id="logoProfileImg" src='@(string.IsNullOrWhiteSpace(Model.EmbedImage) ? Url.Content("~/assets/images/icon_user_default.png") : Model.EmbedImage)' alt="Avatar" />
            <figcaption><span class="username">@Model.Username</span><br /><span class="nickname">@Model.AlternateUsername</span></figcaption>
        </figure>
        <div class="rowlg">
            <i class="icon-lock"></i>
            <input maxlength="6" type="password" autocomplete="off" class="txt" name="otp" id="txtOTP" placeholder="OTP" />
            <label class="error"></label>
            <i class="validation"></i>
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" id="btn-back" value="@Security.lblBack" />
            <input type="submit" class="btn-submit" value="@Security.Submit" />
        </div>
        <div class="note">
            @Security.OtpDatetimeWarning
        </div>
    </form>
</div>

@Html.Hidden("requiredFieldMessage", Security.alertSecCodeEmpty)
@Html.Hidden("oldMainRootPath", Alpha.Main.Helpers.MicroSites.OldMainUrl())
@Html.Hidden("mainRootPath", Alpha.Main.Helpers.MicroSites.MainUrl())

@section js {
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")

    <script src="@StaticResources.MainSiteScriptUrl("~/assets/bundles/security/otp/verify-otp-difference-device")" type="text/javascript"></script>
}
