@model Alpha.Main.Site.ViewModels.TelegramChatBot.RegisterAccountViewModel


<div class="panel success">
    <div class="panel-heading" role="tab" id="headingAccount">
        <h4 class="panel-title">
            <a role="button" class="color-success" data-toggle="collapse" href="#account" aria-expanded="false" aria-controls="account">
                Set up OTP via Telegram Chatbot
                <span class="icon-check-circle"></span>
            </a>
        </h4>
    </div>
    <div id="account" class="panel-collapse" role="tabpanel" aria-labelledby="headingAccount">
        <div class="panel-body">
            <div class="ml-16">
                <p>Click this button to unlink Telegram Chatbot from your account</p>
                <button class="btn-remove btn-unlink-telegram" id="btnUnsubscribe">@ChatBot.unLink</button>
                <label class="mt-15">
                    <input class="cbkEnableOtp"
                           type="checkbox"
                           @(Model.OtpFunction.Enabled ? "checked" : string.Empty)
                           data-functionId="@Model.OtpFunction.FunctionId"
                           data-functionName="@Model.OtpFunction.FunctionName"
                           data-type="@Model.OtpFunction.Type" />
                    Enable OTP Via Telegram Chatbot
                </label>
            </div>
        </div>
    </div>
</div>


@Html.Hidden("UnsubscribeWarning", ChatBot.UnsubscribeTelegramBotWarning)