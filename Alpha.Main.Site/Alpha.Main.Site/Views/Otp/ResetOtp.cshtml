@model ResetOtpViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.Render($"/bundles/site-main/otp/otp-super")
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/otp/otp"))" rel="stylesheet" type="text/css" />
</head>
<body>
    @if (Model.Result != null)
    {
        <div class="msg @(Model.Result.IsSuccessful ? "msg-success" : "msg-error")">@Model.Result.Message</div>
    }

    @using (Html.BeginForm())
    {
        @Html.HiddenFor(model => model.CustId)
        @Html.HiddenFor(model => model.SubAccountId)
        @Html.HiddenFor(model => model.Username)
        <div>
            @Model.ResetTitle
        </div>
        <div>
            <button id="btn-change-status" class="btn-submit">@Security.Submit</button>
        </div>
            <div>@Security.ResetOtpWarning</div>
    }
</body>
</html>