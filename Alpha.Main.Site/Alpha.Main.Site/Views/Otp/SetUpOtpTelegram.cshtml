@model OtpViewModel
@{
    Layout = null;
}
<div class="panel">
    <div class="panel-heading" role="tab" id="headingEnableDisable">
        <h4 class="panel-title">
            <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion" href="#enableTelegramOTP" aria-expanded="false" aria-controls="collapseTwo">
                Telegram
            </a>
        </h4>
    </div>
    <div id="enableTelegramOTP" class="panel-collapse" role="tabpanel" aria-labelledby="headingEnableDisable">
        <div class="panel-body">
            <div id="change-status-message"></div>
            <ul id="registerTelegramPanel" class="list-requirements">
                <li>
                    <p class="bold">
                        Chatbot" function integrated with this Telegram IM allows you to receive up-to-date significant information of your business conveniently and securely without the
                        need to access to this site. Besides, after installing and enabling OTP, you can also  get OTP via Telegram Chatbot.
                    </p>
                    <div class="download-content">
                        <div class="logo-telegram">
                            <img id="logoTelegram" src="~/Assets/Styles/telegramchatbot/images/telegram.png" />
                            <img class="qr-code hide" id="imgQRCode" src="~/Assets/styles/telegramchatbot/images/telegram-qr-code.jpg" />
                            <a href="#" class="link qr-code-link" id="showQRCode">ShowQRCode</a>
                            <a href="#" class="link qr-code-link hide" id="hideQRCode">HideQRCode</a>
                        </div>
                        <div class="list-download">
                            <h2>Telegram</h2>
                            <p><strong>TelegramMessengerInc</strong></p>
                            <ul class="list-inline">
                                <li>
                                    <a href="https://apps.apple.com/app/telegram-messenger/id686449807" class="btn-download-ios" target="_blank">
                                        <img src="~/Assets/Styles/telegramchatbot/images/apple.png" />
                                    </a>
                                </li>
                                <li>
                                    <a href="https://play.google.com/store/apps/details?id=org.telegram.messenger" target="_blank" class="btn-download-android">
                                        <img src="~/Assets/Styles/telegramchatbot/images/google.png" />
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </li>
                <li>
                    @*<p class="bold">@Html.Raw(ChatBot.StartSettingUp)</p>*@
                    <button class="btn-chatbot btn-gen-qr-code" id="btnGenQRCode">@ChatBot.GeneratePrivateQRCode</button>
                </li>
                <li>
                    <label>
                        <input id="cbkEnableOtp"
                               type="checkbox" />
                        @Security.EnableOtpViaSophos
                    </label>
                </li>
            </ul>
        </div>
    </div>
</div>