@model OtpViewModel
@{
    Layout = null;
}
<div class="panel" id="register-panel" style="@(Model.IsAlreadySetup ? "display:none;" : "")">
    <div class="panel-heading" role="tab" id="headingRegister">
        <h4 class="panel-title">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#registerSophos" aria-expanded="false" aria-controls="collapseTwo">
                @Security.RegisterMobileApplication
            </a>
        </h4>
    </div>

    <div id="registerSophos" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingRegister">
        <div class="panel-body">
            <ul class="list-requirements">
                <li>
                    <strong>@Security.DownloadSophos</strong>
                    <div class="download-content">
                        <div class="logo-sophos">
                            <img src="~/Assets/Styles/otp/images/logo.png" />
                        </div>
                        <div class="list-download">
                            <h2>Sophos Authenticator</h2>
                            <p><strong>Sophos Gmbh</strong></p>
                            <ul class="list-inline">
                                <li><a href="https://itunes.apple.com/vn/app/sophos-authenticator/id864224575?mt=8" class="btn-download-ios" target="_blank" ><img src="~/Assets/Styles/otp/images/apple.png" /></a></li>
                                <li><a href="https://play.google.com/store/apps/details?id=com.sophos.sophtoken&hl=en" target="_blank" class="btn-download-android"><img src="~/Assets/Styles/otp/images/google.png" /></a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="note">
                        <p>@Security.OtherAuthenticators</p>
                        <p class="bold">@Security.OtpDatetimeWarning</p>
                    </div>                    
                </li>
                <li>
                    <strong>@Security.ScanQRCode</strong>
                    <div class="qr-code">
                        <img src="@Html.Raw(Model.CustomerOtp.QrCode)" />
                    </div>
                    <div class="username-customize">
                        <p>@Security.UsernameWarning <strong>@Model.CustomerOtp.OtpUsername</strong>. <a href="#">@Security.ChangeIt</a></p>
                        <form class="form-inline" id="username-form" method="get">
                            <div class="form-group" id="username-message"></div>
                            <div class="form-group">
                                <label>Account</label>
                                <input maxlength="30" type="text" class="txt form-control" name="username" id="username" value="@Model.CustomerOtp.OtpUsername" />
                                <input type="submit" class="btn-submit" id="btnChangeUsername" value="@Security.RegenerateQR" />
                            </div>
                        </form>
                    </div>
                    <div class="panel-group manualQRCode" id="manualQRCode" role="tablist" aria-multiselectable="true">
                        <div class="panel">
                            <div class="panel-heading" role="tab" id="headingQR">
                                <h4 class="panel-title">
                                    <a class="collapsed" role="button" data-toggle="collapse" data-parent="#manualQRCode" href="#unableScan" aria-expanded="false" aria-controls="collapseThree">
                                        @Security.UnableScanQRCode
                                    </a>
                                </h4>
                            </div>
                            <div id="unableScan" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingQR">
                                <div class="panel-body">
                                    <p>@Security.ManualInputOtpKey</p>
                                    <p>Key: <strong id="secret-key">@Html.Raw(Model.CustomerOtp.SecretKey)</strong> <span class="icon-content-copy" data-clipboard-action="copy" data-clipboard-target="#secret-key"></span></p>
                                    <div class="example">
                                        <div class="col-left">
                                            <img src="~/Assets/Styles/otp/images/manual-ios.png" title="IOS" />
                                        </div>
                                        <div class="col-right">
                                            <img src="~/Assets/Styles/otp/images/manual-android.png" title="Android" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
                <li>
                    <strong>@Security.Enter6DigitsOtp</strong>
                    <form class="block last" id="otp-form">
                        <div class="form-group">
                            <label>OTP</label>
                            <input maxlength="6" type="password" class="txt form-control" name="otp" id="txtOtp" />
                        </div>
                        <div class="form-group" id="setup-otp-message"></div>
                        <div class="form-group last">
                            <input type="submit" class="btn-submit" id="btnSubmitOtp" value="@Security.Submit" />
                        </div>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</div>