@model OtpViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Setup Otp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.Render($"/bundles/site-main/otp/otp-super")
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/otp/otp"))" rel="stylesheet" type="text/css" />
</head>
<body>
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation">
            <a id="profilePicture" href="@Alpha.Main.Helpers.MicroSites.OldMainUrl($"~/ProfilePicture/?custid={Model.CustomerOtp.CustID}")">@Resources.EditProfilePicture</a>
        </li>
        <li role="presentation">
            <a href="@Alpha.Main.Helpers.MicroSites.OldMainUrl($"~/LoginOption/?custid={Model.CustomerOtp.CustID}")">@Resources.nickname</a>
        </li>
        <li role="presentation" class="active">
            <a href="#otp" aria-controls="home" role="tab" data-toggle="tab">OTP</a>
        </li>
    </ul>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane" id="profilePicture">
            @Resources.EditProfilePicture
        </div>
        <div role="tabpanel" class="tab-pane" id="nickname">
            @Resources.nickname
        </div>
        <div role="tabpanel" class="tab-pane active otp-config" id="otp">
            <p>
                @Security.OtpNotes
            </p>

            <div class="panel-group panel-table" id="accordion" role="tablist" aria-multiselectable="true">
                
                @Html.Partial("RegisterAuthenticatorApp", Model)
                @Html.Partial("RemoveSecretKey", Model)
                @Html.Partial("ChangeOtpStatus", Model)
                
            </div>
        </div>
    </div>

    @Html.Hidden("RemoveOtpWarning", Security.RemoveOtpWarning)
    @Html.Hidden("RemoveOtpSuccessMessage", Security.RemoveOtpSuccessMessage)
    @Html.Hidden("OtpIsInvalidOrExpired", Security.OtpIsInvalidOrExpired)
    @Html.Hidden("AuthenticatorAppVerified", Security.AuthenticatorAppVerified)
    @Html.Hidden("ThereIsNoChange", Resources.ThereIsNoChange)

    @Html.Hidden("oldMainRootPath", Alpha.Main.Helpers.MicroSites.OldMainUrl())
    @Html.Hidden("mainRootPath", Alpha.Main.Helpers.MicroSites.MainUrl())
    @StaticResources.AssetScripts.Render($"/bundles/site-main/otp/otp-default")

    <script src="@StaticResources.MainSiteScriptUrl("~/assets/bundles/security/otp/setup-otp")" type="text/javascript"></script>
</body>
</html>