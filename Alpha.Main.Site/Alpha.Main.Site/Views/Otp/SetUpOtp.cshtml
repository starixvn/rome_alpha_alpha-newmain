@model OtpViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Setup Otp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-main/otp/otp-super")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/otp/otp")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/chatbot/chatbot-default")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode($"/bundles/site-main/chatbot/tab-{Model.RegisterAccountViewModel.CustLevel}")
    @if (!Model.RegisterAccountViewModel.ChatBotViewModel.IsLinked)
    {
        @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/telegramchatbot/register-account")
    }
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/telegramchatbot/chatbot")
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagScript()
</head>
<body>
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagNoScript()
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation">
            <a id="profilePicture" href="@MicroSites.AccountInfoUrl($"~/ProfilePicture/")">@Resources.EditProfilePicture</a>
        </li>
        @if (Model.IsShowNicknameLink)
        {
            <li role="presentation">
                <a href="@MicroSites.OldMainUrl($"~/LoginOption/?custid={Model.CustomerOtp.CustId}")">@Resources.nickname</a>
            </li>
        }
        <li role="presentation" class="active">
            <a href="#otp" aria-controls="home" role="tab" data-toggle="tab">OTP</a>
        </li>
        @if (Model.IsOfferProtectedMode)
        {
            <li role="presentation">
                @Html.ActionLink(Resources.ProtectionCode, "Setup", "ProtectionCode")
            </li>
        }
    </ul>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active otp-config" id="otp">
            <p>
                The OTP will be required when you make sensitive actions or log in with a different Device/Browser.
                You will need to register for the Mobile Authenticator App or Telegram Chatbot before enabling the OTP option.
            </p>
            @if (!Model.RegisterAccountViewModel.ChatBotViewModel.IsLinked)
            {
                @Html.Partial("SetUpTelegramOtp", Model.RegisterAccountViewModel)
            }
            else
            {
                @Html.Partial("ChangeOtpTelegramStatus", Model.RegisterAccountViewModel)
            }

            @if (!Model.IsAlreadySetup)
            {
                @Html.Partial("RegisterAuthenticatorApp", Model)
            }
            @Html.Partial("RemoveSecretKey", Model)
        </div>
    </div>
    @Html.AntiForgeryToken()
    @Html.Hidden("RemoveOtpWarning", Security.RemoveOtpWarning)
    @Html.Hidden("RemoveOtpSuccessMessage", Security.RemoveOtpSuccessMessage)
    @Html.Hidden("OtpIsInvalidOrExpired", Security.OtpIsInvalidOrExpired)
    @Html.Hidden("AuthenticatorAppVerified", Security.AuthenticatorAppVerified)
    @Html.Hidden("ThereIsNoChange", Resources.ThereIsNoChange)
    @Html.Hidden("ThisFieldRequired", Security.alertSecCodeEmpty)
    @Html.Hidden("oldMainRootPath", MicroSites.OldMainUrl("~/"))
    @Html.Hidden("mainRootPath", MicroSites.MainUrl())
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/otp/otp-default")
    @StaticResources.RenderScripts("~/assets/bundles/security/otp/setup-otp")
    @StaticResources.RenderScripts("~/assets/bundles/security/otp/change-otp-telegram-status")
    @if (!Model.RegisterAccountViewModel.ChatBotViewModel.IsLinked)
    {
        @StaticResources.RenderScripts("~/assets/bundles/telegramchatbot/register-account")
    }
    @StaticResources.AssetScripts.Render("/bundles/site-main/chatbot/chatbot-default")

</body>
</html>
