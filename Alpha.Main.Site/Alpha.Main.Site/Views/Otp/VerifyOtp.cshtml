<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.Render($"/bundles/site-main/otp/otp-super")
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/otp/otp"))" rel="stylesheet" type="text/css" />
</head>
<body>
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation">
            <a href="#profilePicture" aria-controls="home" role="tab" data-toggle="tab">Profile Picture</a>
        </li>
        <li role="presentation">
            <a href="#nickname" aria-controls="home" role="tab" data-toggle="tab">Nickname</a>
        </li>
        <li role="presentation" class="active">
            <a href="#otp" aria-controls="home" role="tab" data-toggle="tab">OTP</a>
        </li>
    </ul>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane" id="profilePicture">
            Profile Picture
        </div>
        <div role="tabpanel" class="tab-pane" id="nickname">
            Nickname
        </div>
        <div role="tabpanel" class="tab-pane active" id="otp">
            <div class="msg-content">
                <div class="msg msg-warning">@Security.InputOtpBeforeProceeding</div>
            </div>
            <form class="form-validation block">
                <div class="form-group">
                    <label>OTP</label>
                    <input type="password" class="txt form-control" name="otp" id="otp" />
                    <i class="validation"></i>
                </div>
                <div class="form-group">
                    <input type="submit" class="btn-submit" id="btnSubmit" value="@Security.Submit" />
                </div>
            </form>
        </div>
    </div>
    @StaticResources.AssetScripts.Render($"/bundles/site-main/otp/otp-default")
</body>
</html>