@model OtpViewModel
@{
    Layout = null;
}
<div class="panel success" id="remove-secret-key-panel" style="@(Model.IsAlreadySetup ? "" : "display:none;")">
    <div class="panel-heading" role="tab" id="headingRegister">
        <h4 class="panel-title">
            <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion" href="#registerSophosSuccess" aria-expanded="false" aria-controls="collapseTwo">
                @Security.RegisterMobileApplication <span class="icon-check-circle"></span>
            </a>
        </h4>
    </div>
    <div id="registerSophosSuccess" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingRegister">
        <div class="panel-body">
            <div class="register-succeess">
                <p>@Security.ClickToRemoveOtp</p>
                <button class="btn-remove" id="btn-remove-otp">@Security.RemoveOtp</button>
            </div>
        </div>
    </div>
</div>