@using CaptchaMvc.HtmlHelpers;
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="description">
    <meta content="" name="author">
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/before-home-page")
    @StaticResources.RenderStyles("~/assets/bundles/captcha/captcha")
    <title>@ChatBot.lblCaptcha</title>
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
      @StaticResources.AssetScripts.RenderCommon("/bundles/common/support-IE8")
    <![endif]-->
</head>
<body>
    <div class="block">
        <p class="hint-text">
            <span class="icon-check-circle"></span>
            <span class="text">@Resources.IamNotARobot</span>
        </p>
        @Html.Captcha(6, "CaptchaTemplate", ViewData)
    </div>
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.RenderScripts("~/assets/bundles/captcha/captcha")
    @GoogleAnalyticHepler.Render()
</body>
</html>
