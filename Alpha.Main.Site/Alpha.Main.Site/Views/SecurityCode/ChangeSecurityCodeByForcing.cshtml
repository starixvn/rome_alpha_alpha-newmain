@model Alpha.Main.Site.ViewModels.Security.LoginSecurityCodeViewModel

@{
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}

@section css {
    @StaticResources.AssetStyles.Render("/bundles/site-main/security-code/before-home-page")
}
@*  *@
<div class="block">
    <form class="form-SC">
        <div class="box-lang">
            <div class="dropdown">
                <span class="btn dropdown-toggle" type="button" id="langList" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                    <span class="flag flag-en"></span>
                    English
                    <span class="caret"></span>
                </span>
                <ul class="dropdown-menu" aria-labelledby="langList">
                    <li><a href="#"><span class="flag flag-en"></span>English</a></li>
                    <li><a href="#"><span class="flag flag-cn"></span>繁體中文</a></li>
                    <li><a href="#"><span class="flag flag-tw"></span>简体中文</a></li>
                    <li><a href="#"><span class="flag flag-jp"></span>日本語</a></li>
                    <li><a href="#"><span class="flag flag-th"></span>ภาษาไทย</a></li>
                    <li><a href="#"><span class="flag flag-kr"></span>한국어</a></li>
                    <li><a href="#"><span class="flag flag-vn"></span>Tiếng Việt</a></li>
                </ul>
            </div>
        </div>
        <h1 class="title">@SecurityCode_Resources.SecurityCode</h1>
        <p> @(string.Format(@SecurityCode_Resources.SecurityCodeShower, @Model.UsernameShower))
        <figure class="avatar">
            <img id="logoProfileImg" src='@(Model.IsDefaultAvatar ? Url.Content("~/assets/images/icon_user_default.png") : Model.EmbedImage)' alt="Avatar" />
            <figcaption><span class="username">@Model.Username</span><br /><span class="nickname">@Model.AlternateUsername</span></figcaption>
        </figure>
        <div class="rowlg">
            <input type="password" class="txt" name="providedSC" id="txtOldSecCode" placeholder="@SecurityCode_Resources.oldSecCode">
            <label id="txtOldSecCode-error" class="error"></label>
            <i class="icon-account-key"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg help-rules">
            <input type="password" class="txt" name="SC" id="txtSecCode" placeholder="@SecurityCode_Resources.SecurityCode">
            <label id="txtSecCode-error" class="error"></label>
            <i class="icon-account-key"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg">
            <input type="password" class="txt" name="confirmSC" id="txtConfirmSecCode" placeholder="@SecurityCode_Resources.ConfirmSecurityCode">
            <label id="txtConfirmSecCode-error" class="error"></label>
            <i class="icon-account-key"></i>
            <i class="validation"></i>
        </div>
        <div id="error-message" class="msg msg-error display-none"></div>
        <div class="list-button">
            <input type="button" class="btn-back" id="btn-cancel" value="@SecurityCode_Resources.Back" />
            <input type="submit" class="btn-submit" value="@SecurityCode_Resources.Submit" />
        </div>
    </form>
    <div class="rules" id="rules">
        <div class="rules-title" id="rules-title" data-toggle="modal" data-target="#sc"><span class="icon-information-outline icon-rules"></span>"@SecurityCode_Resources.SecurityCodeRules</div>
        <!-- Modal -->
        <div class="modal fade information" id="sc" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <span class="icon icon-close close" data-dismiss="modal" aria-label="Close"></span>
                        <h4 class="modal-title" id="myModalLabel"><span class="icon-information-outline icon-rules"></span>"@SecurityCode_Resources.SecurityCodeRules</h4>
                    </div>
                    <div class="modal-body">
                        <p>@SecurityCode_Resources.SecurityCodeRules01</p>
                        <ul>
                            <li>@SecurityCode_Resources.SecurityCodeRules02</li>
                            <li>@SecurityCode_Resources.SecurityCodeRules03</li>
                            <li>@SecurityCode_Resources.SecurityCodeRules04</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Hidden("securitycode-token", Model.SecurityCodeToken)
@Html.Hidden("security-salt", Model.SecuritySalt)
@Html.Hidden("hashkey", Model.HashKey)
@Html.Hidden("alert-old-securitycode-empty", SecurityCode_Resources.alertOldSecCodeEmpty)
@Html.Hidden("alert-securitycode-empty", SecurityCode_Resources.alertSecCodeEmpty)
@Html.Hidden("alert-securitycode-wrong-rule", SecurityCode_Resources.lblSecCodeWrongRule)
@Html.Hidden("alert-error-securitycode-confirm", SecurityCode_Resources.alertErrorSecCodeConfirm)
@Html.Hidden("alert-same-securitycode", SecurityCode_Resources.alertSameSecCode)
@Html.Hidden("alert-securitycode-change-ok", SecurityCode_Resources.alertSecCodeChangedOK)
@Html.Hidden("appPath", Model.AppPath)

@section js {
    @StaticResources.AssetScripts.Render("/bundles/site-main/security-code/before-home-page")
    <script src="@StaticResources.MainSiteScriptUrl("~/Assets/bundles/security-code/change-securitycode-by-forcing")" type="text/javascript"></script>
}

