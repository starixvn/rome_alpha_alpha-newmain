@model BaseSecurityCodeViewModel

@{
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/security-super")
    <link href="@StaticResources.MainSiteStyleUrl("~/Assets/bundles/security/security")" rel="stylesheet" type="text/css" />
}

<h1 class="page-title"></h1>
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" id="passwordNav">
        <a href="#" role="tab" data-toggle="tab">@Security.Password</a>
    </li>
    <li role="presentation" class="active">
        <a>@Security.SecurityCode</a>
    </li>
</ul>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active">        
        <div id="error-message" class="msg display-none"></div>
        <div class="block">
            <form class="form-SC form-validation">
                <div class="form-group">
                    <label>@Security.oldSecCode</label>
                    <input type="password" class="txt form-control" name="oldSC" id="txtOldSecCode" />
                </div>
                <div class="form-group">
                    <label>@Security.SecurityCode</label>
                    <input type="password" class="txt form-control" name="SC" id="txtSecCode" />
                    <i class="validation"></i>
                </div>
                <div class="form-group">
                    <label>@Security.ConfirmSecurityCode</label>
                    <input type="password" class="txt form-control" name="confirmSC" id="txtConfirmSecCode" />
                    <i class="validation"></i>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" /> Show security code</label>
                </div>
                <div class="form-group">
                    <input type="submit" class="btn-submit" value="@Security.Submit" />
                    <input type="reset" value="@Security.Reset" />
                </div>
            </form>
            <div class="rules">
                <p><span class="note-red">*</span>@Security.SecurityCodeRules01</p>
                <ul>
                    <li>@Security.SecurityCodeRules02</li>
                    <li>@Security.SecurityCodeRules03</li>
                    <li>@Security.SecurityCodeRules04</li>
                </ul>
            </div>
        </div>
    </div>
</div>
@Html.Hidden("securitycode-token", Model.SecurityCodeToken)
@Html.Hidden("security-salt", Model.SecuritySalt)
@Html.Hidden("hashkey", Model.HashKey)
@Html.Hidden("oldMainRootPath", Model.OldMainRootPath)
@Html.Hidden("mainRootPath", Model.MainRootPath)
   
@section js {
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    <script src="@StaticResources.MainSiteScriptUrl("~/Assets/bundles/security/security-code/change-user-own-securitycode")" type="text/javascript"></script>
}