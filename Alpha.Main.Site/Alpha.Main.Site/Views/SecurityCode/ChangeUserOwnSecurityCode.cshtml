@model Alpha.Main.Site.ViewModels.Security.BaseSecurityCodeViewModel

@{
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/security-super")
    <link href="@StaticResources.MainSiteStyleUrl("~/Assets/bundles/security/security")" rel="stylesheet" type="text/css" />
}

<h1 class="page-title"></h1>
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" id="passwordNav">
        <a href="#" role="tab" data-toggle="tab">@SecurityCode_Resources.Password</a>
    </li>
    <li role="presentation" class="active">
        <a>@SecurityCode_Resources.SecurityCode</a>
    </li>
</ul>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active">        
        <div id="error-message" class="msg display-none">@SecurityCode_Resources.informSecCode</div>
        <div class="block">
            <form class="form-SC">
                <div class="form-group">
                    <label>@SecurityCode_Resources.oldSecCode</label>
                    <input type="password" class="txt form-control" name="oldSC" id="txtOldSecCode">
                </div>
                <div class="form-group">
                    <label>@SecurityCode_Resources.SecurityCode</label>
                    <input type="password" class="txt form-control" name="SC" id="txtSecCode">
                </div>
                <div class="form-group">
                    <label>@SecurityCode_Resources.ConfirmSecurityCode</label>
                    <input type="password" class="txt form-control" name="confirmSC" id="txtConfirmSecCode">
                </div>
                <div class="form-group">
                    <input type="submit" class="btn-submit" value="@SecurityCode_Resources.Submit" />
                    <input type="reset" value="@SecurityCode_Resources.Reset" />
                </div>
            </form>
            <div class="rules">
                <p><span class="note-red">*</span>@SecurityCode_Resources.SecurityCodeRules01</p>
                <ul>
                    <li>@SecurityCode_Resources.SecurityCodeRules02</li>
                    <li>@SecurityCode_Resources.SecurityCodeRules03</li>
                    <li>@SecurityCode_Resources.SecurityCodeRules04</li>
                </ul>
            </div>
        </div>
    </div>
</div>
@Html.Hidden("securitycode-token", Model.SecurityCodeToken)
@Html.Hidden("security-salt", Model.SecuritySalt)
@Html.Hidden("hashkey", Model.HashKey)
@Html.Hidden("alert-old-securitycode-empty", SecurityCode_Resources.alertOldSecCodeEmpty)
@Html.Hidden("alert-securitycode-empty", SecurityCode_Resources.alertSecCodeEmpty)
@Html.Hidden("alert-securitycode-wrong-rule", SecurityCode_Resources.lblSecCodeWrongRule)
@Html.Hidden("alert-error-securitycode-confirm", SecurityCode_Resources.alertErrorSecCodeConfirm)
@Html.Hidden("alert-same-securitycode", SecurityCode_Resources.alertSameSecCode)
@Html.Hidden("alert-securitycode-change-ok", SecurityCode_Resources.alertSecCodeChangedOK)
@Html.Hidden("oldMainRootPath", Model.OldMainRootPath)
@Html.Hidden("mainRootPath", Model.MainRootPath)

@section js {
    @StaticResources.AssetScripts.Render("/bundles/site-main/security-code/before-home-page")
    <script src="@StaticResources.MainSiteScriptUrl("~/Assets/bundles/security-code/change-user-own-securitycode")" type="text/javascript"></script>
}