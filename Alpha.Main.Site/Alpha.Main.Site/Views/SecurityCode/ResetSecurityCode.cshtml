@model SecurityCodeViewModel
@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.RenderStyles("~/Assets/bundles/security/security")
}
<h1 id="title_header" class="page-title">@Model.Title</h1>
<div id="status-message" class="msg-content display-none">
    <div id="status-message-content" class="msg"></div>
</div>
<div class="block" id="container">
    <form class="form-SC form-validation">
        <div class="form-group">
            <label>@Security.SecurityCode</label>
            <input type="password" autocomplete="off" class="txt form-control" name="SC" id="txtSecCode" maxlength="6" />
            <i class="validation"></i>
        </div>
        <div class="form-group">
            <label>@Security.ConfirmSecurityCode</label>
            <input type="password" autocomplete="off" class="txt form-control" name="confirmSC" id="txtConfirmSecCode" maxlength="6" />
            <i class="validation"></i>
        </div>
        <div class="form-group">
            <label><input type="checkbox" id="showSCchk" /> @Security.ShowSecurityCode</label>
        </div>
        <div class="form-group">
            <input type="submit" class="btn-submit" value="@Security.Submit" />
            <input type="reset" value="@Security.Reset" />
        </div>
    </form>
</div>
<div class="rules">
    <p><span class="note-red">*</span>@Security.SecurityCodeRules01</p>
    <ul>
        <li>@Security.SecurityCodeRules02</li>
    </ul>
    <a href="@($"{Model.MainRootPath}SecurityCode/LearnMore")" target="_blank">@Security.LearnMore</a>
</div>
@Html.Hidden("hashkey", Model.HashKey)
@Html.Hidden("custid", Request["custid"]) @*Todo: Magic, please review here*@
@Html.Hidden("subaccid", Request["subaccid"]) @*Todo: Magic, please review here*@
@Html.Hidden("oldMainRootPath", Model.OldMainRootPath)
@Html.Hidden("mainRootPath", Model.MainRootPath)
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    @StaticResources.RenderScripts("~/Assets/bundles/security/security-code/reset-securitycode")
}
