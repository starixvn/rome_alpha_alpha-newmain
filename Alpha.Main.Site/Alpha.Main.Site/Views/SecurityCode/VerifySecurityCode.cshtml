@model Alpha.Main.Site.ViewModels.Security.SecurityCodeViewModel
@{
    ViewBag.Title = "VerifySecurityCode";
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}

@section css {
    @Styles.Render("/assets/bundles/site-main/security-code/default.min.css")
    @Styles.Render("../Assets/bundles/security-code.min.css")
}

@section js {
    <script type="text/javascript">
        var securityCodeToken = '@Model.SecurityCodeToken';
        var securitySalt = '@Model.SecuritySalt';
        var ph = '@Model.PH';
        var securityCodeResource = {
            informSecCode: '@SecurityCode_Resources.informSecCode'
        };
    </script>
} 
<h1 class="page-title">Security Code</h1>
@Html.Partial("~/Views/SecurityCode/Shared/_HeaderMessage.cshtml", SecurityCode_Resources.informSecCode)
<div class="block">
    <form class="form-SC">        
        <div class="form-group">
            <label>Security Code</label>
            <input type="password" class="txt form-control" name="SC" id="SC" />
        </div>
        <div class="form-group">
            <input type="submit" class="btn-submit" value="Submit" />
            <input type="button" value="Simulte Verify Done" id="simulateDone" />
        </div>
    </form>
    <div class="rules">
        <p><span class="note-red">*</span>Security Code (SC) must be a 6-digits string, contains at least 2 different digits and must not be forward run and backward run number.</p>
        <ul>
            <li>A "Forward run" is a consecutive, ascending order series of digits.</li>
            <li>A "Backward Run" is a consecutive, descending order series of digits.</li>
            <li>For example: 123456, 456789, 765432, ect. are not allowed</li>
        </ul>
    </div>
</div>

@StaticResources.AssetScripts.Render("/bundles/site-main/default")
<script src="@Url.Content("~/Assets/scripts/security-code/jquery-1.8.2.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Assets/scripts/security-code/core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Assets/scripts/security-code/Sha1.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Assets/scripts/security-code/Sha256.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Assets/scripts/security-code/verify-securitycode.js")" type="text/javascript"></script>