@model Alpha.Main.Site.ViewModels.Security.BaseSecurityCodeViewModel
@{
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}

@section css {
    @StaticResources.AssetStyles.Render("/bundles/site-main/security-code/default")
    <link href="@StaticResources.MainSiteStyleUrl("~/Assets/bundles/security-code/security-code")" rel="stylesheet" type="text/css" />
}

<h1 class="page-title">@SecurityCode_Resources.SecurityCode</h1>
<div id="error-message" class="msg msg-error">@SecurityCode_Resources.informSecCode</div>
<div class="block">
    <form class="form-SC">
        <div class="form-group">
            <label>Security Code</label>
            <input type="password" class="txt form-control" name="SC" id="txtSecCode" />
        </div>
        <div class="form-group">
            <input type="submit" class="btn-submit" value="@SecurityCode_Resources.Submit" />
        </div>
    </form>
</div>

@Html.Hidden("securitycode-token", Model.SecurityCodeToken)
@Html.Hidden("security-salt", Model.SecuritySalt)
@Html.Hidden("inform-securitycode", SecurityCode_Resources.informSecCode)
@Html.Hidden("appPath", Model.AppPath)

@section js {
    @StaticResources.AssetScripts.Render("/bundles/site-main/default", "/bundles/site-main/security-code/before-home-page")
    <script src="@StaticResources.MainSiteScriptUrl("~/Assets/bundles/security-code/verify-securitycode")" type="text/javascript"></script>
}