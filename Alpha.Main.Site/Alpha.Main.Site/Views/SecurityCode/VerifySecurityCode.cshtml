@model BaseSecurityCodeViewModel
@{
    ViewBag.Title = @Security.titleVerifySecurityCode;
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
}

@section css {
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/default")
    <link href="@StaticResources.MainSiteStyleUrl("~/Assets/bundles/security/security")" rel="stylesheet" type="text/css" />
}

<h1 id="title_header" class="page-title">@Security.SecurityCode</h1>
<div id="status-message" class="msg-content">
    <div id="status-message-content" class="msg msg-warning">@Security.informSecCode</div>
</div>        

<div class="block " id="container">
    <form class="form-SC form-validation">
        <div class="form-group">
            <label>@Security.informSecCode</label>
            <input type="password" class="txt form-control" name="txtSecCode" id="txtSecCode" />
            <i class="validation"></i>
        </div>
        <div class="form-group">
            <label><input type="checkbox" id="showSCchk"/> @Security.ShowSecurityCode</label>
        </div>
        <div class="form-group">
            <input type="submit" class="btn-submit" value="@Security.Submit" />
        </div>
    </form>
</div>

@Html.Hidden("securitycode-token", Model.SecurityCodeToken)
@Html.Hidden("security-salt", Model.SecuritySalt)
@Html.Hidden("oldMainRootPath", Model.OldMainRootPath)
@Html.Hidden("mainRootPath", Model.MainRootPath)

@section js {
    @StaticResources.AssetScripts.Render("/bundles/site-main/default", "/bundles/site-main/security/before-home-page")
    <script src="@StaticResources.MainSiteScriptUrl("~/Assets/bundles/security/security-code/verify-securitycode")" type="text/javascript"></script>
}