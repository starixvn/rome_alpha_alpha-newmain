@model HotAnnouncement
@if (string.IsNullOrEmpty(Model.Content))
{
    Html.Raw("-");
}
else {
    if (string.IsNullOrEmpty(Model.Source))
    {
        @Html.Partial("HotAnnouncementWithText", Model)
    }
    else {
        @Html.Partial("HotAnnouncementWithSource", Model)
    }

    @Html.Hidden("announcement-cookies-id", Model.CookieId)
    @Html.Hidden("popup-id", Model.Id)
}