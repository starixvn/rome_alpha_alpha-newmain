<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.Render($"/bundles/site-main/otp/otp-super")
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/otp/otp"))" rel="stylesheet" type="text/css" />
</head>
<body>
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation">
            <a href="#profilePicture" aria-controls="home" role="tab" data-toggle="tab">Profile Picture</a>
        </li>
        <li role="presentation">
            <a href="#nickname" aria-controls="home" role="tab" data-toggle="tab">Nickname</a>
        </li>
        <li role="presentation" class="active">
            <a href="#otp" aria-controls="home" role="tab" data-toggle="tab">OTP</a>
        </li>
    </ul>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane" id="profilePicture">
            Profile Picture
        </div>
        <div role="tabpanel" class="tab-pane" id="nickname">
            Nickname
        </div>
        <div role="tabpanel" class="tab-pane active otp-config" id="otp">
            <p>
                Once enabled, the One-Time Password (OTP) will replace your security code.
                It will only be required once per session before you do a sensitive action, login with a different IP /
                Device / Browser or when your password has been reset.
            </p>
            <div class="panel-group panel-table" id="accordion" role="tablist" aria-multiselectable="true">
                <div class="panel">
                    <div class="panel-heading" role="tab" id="headingRegister">
                        <h4 class="panel-title">
                            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#registerSophos" aria-expanded="false" aria-controls="collapseTwo">
                                Register Mobile Application
                            </a>
                        </h4>
                    </div>
                    <div id="registerSophos" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingRegister">
                        <div class="panel-body">
                            <ul class="list-requirements">
                                <li>
                                    <strong>Download Sophos Authenticator on your device.</strong>
                                    <div class="download-content">
                                        <div class="logo-sophos">
                                            <img src="~/Assets/Styles/otp/images/logo.png" />
                                        </div>
                                        <div class="list-download">
                                            <h2>Sophos Authenticator</h2>
                                            <p><strong>Sophos Gmbh</strong></p>
                                            <ul class="list-inline">
                                                <li><a href="#" class="btn-download-ios"><img src="~/Assets/Styles/otp/images/apple.png" /></a></li>
                                                <li><a href="#" class="btn-download-android"><img src="~/Assets/Styles/otp/images/google.png" /></a></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <p class="note">Other two-factor authenticator applications such as Google Authenticator, Microsoft Authenticator ect. are also supported</p>
                                </li>
                                <li>
                                    <strong>Using Sophos, scan this QR code</strong>
                                    <div class="qr-code">
                                        <img src="~/Assets/Styles/otp/images/qr.png" />
                                    </div>
                                    <div class="panel-group manualQRCode" id="manualQRCode" role="tablist" aria-multiselectable="true">
                                        <div class="panel">
                                            <div class="panel-heading" role="tab" id="headingQR">
                                                <h4 class="panel-title">
                                                    <a class="collapsed" role="button" data-toggle="collapse" data-parent="#manualQRCode" href="#unableScan" aria-expanded="false" aria-controls="collapseThree">
                                                        Unable to scan the QR code?
                                                    </a>
                                                </h4>
                                            </div>
                                            <div id="unableScan" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingQR">
                                                <div class="panel-body">
                                                    <p>Please input the key below to the Manual Add page in Sophos then click Done (IOS) or Add (Android)</p>
                                                    <p>Key: <strong>SDFGSIKYH4GM6PQW</strong> <span class="icon-content-copy"></span></p>
                                                    <div class="example">
                                                        <div class="col-left">
                                                            <img src="~/Assets/Styles/otp/images/manual-ios.png" title="IOS" />
                                                        </div>
                                                        <div class="col-right">
                                                            <img src="~/Assets/Styles/otp/images/manual-android.png" title="Android" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                                <li>
                                    <strong>Enter 6-digits OTP generated by Sophos into the textfield below then submit to complete the registration.</strong>
                                    <form class="block last">
                                        <div class="form-group">
                                            <label>OTP</label>
                                            <input type="password" class="txt form-control" name="otp" id="otp" />
                                        </div>
                                        <div class="form-group last">
                                            <input type="submit" class="btn-submit" id="btnSubmit" value="Submit" />
                                        </div>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="panel success">
                    <div class="panel-heading" role="tab" id="headingRegister">
                        <h4 class="panel-title">
                            <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion" href="#registerSophosSuccess" aria-expanded="false" aria-controls="collapseTwo">
                                Register Mobile Application <span class="icon-check-circle"></span>
                            </a>
                        </h4>
                    </div>
                    <div id="registerSophosSuccess" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingRegister">
                        <div class="panel-body">
                            <div class="register-succeess">
                                <p>Click the button below to remove your current OTP settings</p>
                                <button class="btn-remove">Remove OTP</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel">
                    <div class="panel-heading" role="tab" id="headingEnableDisable">
                        <h4 class="panel-title">
                            <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion" href="#enableDisableOTP" aria-expanded="false" aria-controls="collapseTwo">
                                Enable/Disable OTP
                            </a>
                        </h4>
                    </div>
                    <div id="enableDisableOTP" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingEnableDisable">
                        <div class="panel-body">
                            <ul class="list-enableDisable">
                                <li><label><input type="checkbox" /> Enable OTP via Sophos Authenticator Mobile App.</label></li>
                                <li><button class="btn-submit">Submit</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @StaticResources.AssetScripts.Render($"/bundles/site-main/otp/otp-default")
</body>
</html>