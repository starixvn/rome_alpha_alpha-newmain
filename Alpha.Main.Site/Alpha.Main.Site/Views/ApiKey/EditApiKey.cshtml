@model EditApiKeyViewModel
@{
    Layout = "~/Views/ApiKey/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/apikey")
    @StaticResources.RenderStylesWithDarkMode("~/Assets/bundles/apikey/apikey")
}

<form class="block" id="apikey-form" autocomplete="off">
    <div id="error-message" class="container-msg w-450"></div>
    <div class="form-group">
        <label>API Key Name</label>
        <input type="text" class="form-control" id="apiname" autocomplete="off" value="@Model.ApiKeyInfo.Name" maxlength="50" />
    </div>
    <div class="form-group">
        <label>API Key</label>
        <input type="text" class="form-control" id="key" autocomplete="off" value="@Model.ApiKeyInfo.Key" readonly />
        <span class="icon-content-copy icon" data-clipboard-action="copy" data-clipboard-target="#key" title="@Security.Copied"></span>
    </div>
    <div class="form-group">
        <label>Expiration Date</label>
        <div class="control date w-460">
            <div class="input-group date w-310" id="dpkContainer">
                <input type="text" class="form-control" id="expirationdate" autocomplete="off" value="@Model.ApiKeyInfo.ExpirationDate" placeholder="MM/DD/YYYY" />
                <span class="input-group-addon">
                    <span class="icon-calendar"></span>
                </span>
            </div>
        </div>
    </div>
    <label class="scope-label">Select Scopes <span class="font-normal">(Scopes set the permisson granted to the API Key)</span></label>
    <div class="ml-25">
        <label class="scope-input mt-10"><input type="checkbox" value="All" id="ckbAll" /> All</label><br>
        <div class="ml-25" id="apiKeyScopes">
            @foreach (var scope in Model.Scopes)
            {

                var isChecked = Model.ApiKeyInfo.ScopeIdList.Contains(scope);
                <label class="scope-input"><input type="checkbox" value="@scope" name="scope" @(isChecked ? "checked" : "") />@ResourceHelper.GetApiKeyResource($"Scope_{scope}", Model.Language)</label><br>
            }
        </div>
    </div>
    <div class="form-group mt-10">
        <button class="btn-submit" id="btnSubmit">Save</button>
        <button class="btn-remove" id="btnCancel">Cancel</button>
    </div>
</form>
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-main/apikey")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-main/apikey/clipboard")
    @StaticResources.RenderScripts("~/Assets/bundles/apikey/edit-apikey")
}
