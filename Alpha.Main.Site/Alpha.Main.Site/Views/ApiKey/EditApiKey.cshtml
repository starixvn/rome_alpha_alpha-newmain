@model EditApiKeyViewModel
@{
    Layout = "~/Views/ApiKey/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/apikey")
    @StaticResources.RenderStylesWithDarkMode("~/Assets/bundles/apikey/apikey")
}
<form class="block edit-form">
    <div class="form-group">
        <label>API Key Name</label>
        <input class="form-control" value="@Model.ApiKeyInfo.Name" />
    </div>
    <div class="form-group">
        <label>API Key</label>
        <input class="form-control" value="@Model.ApiKeyInfo.Key" />
    </div>
    <div class="form-group">
        <label>Expiration Date</label>
        <div class="control date">
            <div class="input-group date" id="dpkContainer">
                <input class="form-control" readonly="readonly" id="expirationdate" />
                <span class="input-group-addon">
                    <span class="icon-calendar"></span>
                </span>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label></label>
        <input type="checkbox" value="never" style="margin-bottom: 11px" />
        <label>Never Expires</label>
    </div>
    <div class="form-group">
        <label>Select Scopes</label>
        <select id="multiSelectionDropdownId" multiple="multiple" class="select-multiple">
            @foreach (var scope in Model.Scopes)
            {
                <option value="@scope" selected="selected">@scope</option>
            }
        </select>
    </div>
    <div class="form-group">
        <input type="submit" class="btn-submit" value="Submit" />
    </div>
</form>
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-main/apikey")
    @StaticResources.RenderScripts("~/Assets/bundles/apikey/edit-apikey")
}
