@model CreateApiKeyViewModel
@{
    Layout = "~/Views/ApiKey/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode($"/bundles/site-main/tab-{Model.CustLevel.ToLowerInvariant()}")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/apikey")
    @StaticResources.RenderStylesWithDarkMode("~/Assets/bundles/apikey/apikey")
}
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="@($"{Model.MainRootPath}Apikey/CreateApiKey")" role="tab" data-toggle="tab">@ApiKey.CreateAPIKey</a>
    </li>
    <li role="presentation" id="">
        <a href="@($"{Model.MainRootPath}Apikey/ApiKeyManagement")" role="tab" data-toggle="tab">@ApiKey.APIKeyManagement</a>
    </li>
</ul>
<div class="tab-content">
    <a href="@Model.HelpPage" target="_blank"><span class="icon icon-help icon-question"></span></a>
    <form class="block" id="apikey-form" autocomplete="off">
        <div id="error-message" class="container-msg w-450"></div>
        <div class="form-group">
            <label>@ApiKey.APIKeyName<span class="require"> *</span></label>
            <input type="text" class="form-control" id="apiname" autocomplete="off" maxlength="50" />
        </div>
        <div class="form-group">
            <label>@ApiKey.APIPassphrase<span class="require"> *</span></label>
            <input type="text" class="form-control input-pass" placeholder="7 - 32 characters" id="passphrase" autocomplete="off" maxlength="32" />
            <span class="icon-eye-close icon"></span>
        </div>
        <p>@ApiKey.APIPassPhraseIsImportantForYouToUseLater</p>
        <div class="form-group">
            <label>@ApiKey.ExpirationDate</label>
            <div class="control date w-460">
                <div class="input-group date w-310" id="dpkContainer">
                    <input type="text" class="form-control" id="expirationdate" autocomplete="off" placeholder="MM/DD/YYYY" />
                    <span class="input-group-addon">
                        <span class="icon-calendar"></span>
                    </span>
                </div>
            </div>
        </div>
        <label class="scope-label">@ApiKey.SelectScopes <span class="font-normal">@ApiKey.ScopesSetThePermisson</span></label>
        <div class="ml-25">
            <label class="scope-input mt-10"><input type="checkbox" value="All" id="ckbAll" checked /> @ApiKey.All</label><br>
            <div class="ml-25" id="apiKeyScopes">
                @foreach (var scope in Model.Scopes)
                {
                    <label class="scope-input"><input type="checkbox" value="@scope" name="scope" checked />@ResourceHelper.GetApiKeyResource($"Scope_{scope}", Model.Language)</label><br>
                }
            </div>
        </div>
        <div class="form-group mt-10">
            <input type="submit" class="btn-submit" value="Submit" />
        </div>
    </form>
</div>
@Html.Hidden("Language", Model.Language)
@Html.Hidden("APIKey", ApiKey.APIKey)
@Html.Hidden("PleaseInputAPIKeyName", ApiKey.PleaseInputAPIKeyName)
@Html.Hidden("APIKeyNameCanNotContainSpecialCharacters", ApiKey.APIKeyNameCanNotContainSpecialCharacters)
@Html.Hidden("NoMoreThan50Characters", ApiKey.NoMoreThan50Characters)
@Html.Hidden("PleaseInputPassPhrase", ApiKey.PleaseInputPassPhrase)
@Html.Hidden("APIPassPhraseCanNotContainSpaceSymbolAndPunctuaion", ApiKey.APIPassPhraseCanNotContainSpaceSymbolAndPunctuaion)
@Html.Hidden("APIPassPhraseMustBeBetweenCharacters", ApiKey.APIPassPhraseMustBeBetweenCharacters)
@Html.Hidden("CantSelectTimeFromPast", ApiKey.CantSelectTimeFromPast)
@Html.Hidden("ScopesIsRequired", ApiKey.ScopesIsRequired)
@Html.Hidden("CurrentDate", Model.CurrentDate)
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-main/apikey")
    @StaticResources.RenderScripts("~/Assets/bundles/apikey/create-apikey")
}
