@model CreateApiKeyViewModel
@{
    Layout = "~/Views/ApiKey/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/apikey")
    @StaticResources.RenderStylesWithDarkMode("~/Assets/bundles/apikey/apikey")
}
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="~/Apikey/CreateApiKey" role="tab" data-toggle="tab">Create API Key</a>
    </li>
    <li role="presentation" id="">
        <a href="~/Apikey/ApiKeyManagement" role="tab" data-toggle="tab">API Key Management</a>
    </li>
</ul>
<div class="tab-content">
    <form class="block" id="apikey-form" autocomplete="off">
        <div id="status-message" class="form-group hidden">
            <div id="status-message-content" class="msg msg-warning"></div>
        </div>
        <div class="form-group">
            <label>API Key Name<span class="require"> *</span></label>
            <input class="form-control" id="apiname" autocomplete="off" />
        </div>
        <div class="form-group">
            <label>API Passphrase<span class="require"> *</span></label>
            <input class="form-control" placeholder="7 - 32 characters" id="passphrase" autocomplete="off" />
            <span class="icon-eye icon"></span>
        </div>
        <p>API Passphrase is important information for you to use later. Please remember it and keep it safe.</p>
        <div class="form-group">
            <label>Expiration Date</label>
            <div class="control date">
                <div class="input-group date" id="dpkContainer">
                    <input class="form-control" readonly="readonly" id="expirationdate" autocomplete="off" />
                    <span class="input-group-addon">
                        <span class="icon-calendar"></span>
                    </span>
                </div>
            </div>
        </div>
        <div class="form-group">
            <label></label>
            <input type="checkbox" value="never" style="margin-bottom: 11px" />
            <label>Never Expires</label>
        </div>
        <div class="form-group">
            <label>Select Scopes</label>
            <select id="multiSelectionDropdownId" multiple="multiple" class="select-multiple">
                @foreach (var scope in Model.Scopes)
                {
                    <option value="@scope" selected="selected">@scope</option>
                }
            </select>
        </div>
        <div class="form-group">
            <input type="submit" class="btn-submit" value="Submit" />
        </div>
    </form>
</div>
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-main/apikey")
    @StaticResources.RenderScripts("~/Assets/bundles/apikey/create-apikey")
}
