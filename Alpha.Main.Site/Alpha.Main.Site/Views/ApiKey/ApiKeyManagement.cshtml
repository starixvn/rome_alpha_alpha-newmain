@model ApiKeyManagementViewModel
@{
    Layout = "~/Views/ApiKey/Shared/_Layout.cshtml";
}
@section css {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode($"/bundles/site-main/tab-{Model.CustLevel.ToLowerInvariant()}")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/apikey")
    @StaticResources.RenderStylesWithDarkMode("~/Assets/bundles/apikey/apikey")
}
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation">
        <a href="@($"{Model.MainRootPath}Apikey/CreateApiKey")" role="tab" data-toggle="tab">@ApiKey.CreateAPIKey</a>
    </li>
    <li role="presentation" id="" class="active">
        <a href="@($"{Model.MainRootPath}Apikey/ApiKeyManagement")" role="tab" data-toggle="tab">@ApiKey.APIKeyManagement</a>
    </li>
</ul>
<div class="tab-content apikey-form">
    <a href="@Model.HelpPage" target="_blank"><span class="icon icon-help icon-question"></span></a>
    <table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover">
        <thead>
            <tr>
                <th class="sorting" data-colindex="0">@ApiKey.APIKeyName</th>
                <th class="sorting" data-colindex="1">@ApiKey.CreatedDate</th>
                <th class="hidden-stack-mode sorting" data-colindex="2">@ApiKey.ExpirationDate</th>
                <th class="hidden-stack-mode col-netturnover-header sorting" data-colindex="3">@ApiKey.Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ApiKeyInfos.Any())
            {
                foreach (var apikey in Model.ApiKeyInfos)
                {
                    <tr>
                        <td class="text-center">@apikey.Name</td>
                        <td class="text-center">@apikey.CreatedDate</td>
                        @if (apikey.IsExpired)
                        {
                            <td class='text-center expired-date'>@ApiKey.Expired</td>
                        }
                        else if (apikey.ExpirationDate.HasValue)
                        {
                            <td class='text-center'>@apikey.ExpirationDateStr</td>
                        }
                        else
                        {
                            <td class='text-center'>@ApiKey.Never</td>
                        }
                        <td class="text-center">
                            <button class="btn-submit btn-edit" apikey=@apikey.Key>@ApiKey.Edit</button>
                            <button class="btn-remove btn-revoke" apikey=@apikey.Key apiname=@apikey.Name>@ApiKey.Revoke</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" align="center">@Resources.NoInformationIsAvailable</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@Html.Hidden("Language", Model.Language)
@Html.Hidden("EditAPIKey", ApiKey.EditAPIKey)
@Html.Hidden("AreYouSureRevokeAPIKey", ApiKey.AreYouSureRevokeAPIKey)
@Html.Hidden("ThisActionCannotBeUndone", ApiKey.ThisActionCannotBeUndone)
@section js {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-main/apikey")
    @StaticResources.RenderScripts("~/Assets/bundles/apikey/apikey-management")
}
