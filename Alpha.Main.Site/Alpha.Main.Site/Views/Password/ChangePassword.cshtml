
@{
    ViewBag.Title = "ChangePassword";
}

@section css {
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/security-super")
    <link href="@StaticResources.MainSiteStyleUrl("~/Assets/bundles/security/security")" rel="stylesheet" type="text/css" />
}

<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="#" role="tab" data-toggle="tab">@Resources.password</a>
    </li>
    <li role="presentation" id="securityCodeNav">
        <a href="#" role="tab" data-toggle="tab">@Security.SecurityCode</a>
    </li>
</ul>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active">
        <div id="error-message" class="msg display-none"></div>
        <div class="block">
            <form class="form-SC">
                <div class="form-group">
                    <label>@Security.lblOldPassword</label>
                    <input type="password" class="txt form-control" name="oldSC" id="txtOldPwd">
                </div>
                <div class="form-group">
                    <label>@Security.NewPassword</label>
                    <input type="password" class="txt form-control" name="SC" id="txtNewPwd">
                </div>
                <div class="form-group">
                    <label>@Security.lblConfirmPassword</label>
                    <input type="password" class="txt form-control" name="confirmSC" id="txtConfirmPwd">
                </div>
                <div class="form-group">
                    <input type="submit" class="btn-submit" value="@Security.Submit" />
                    <input type="reset" value="@Security.Reset" />
                </div>
            </form>
            <div class="rules">
                <p><span class="note-red">*</span>@Security.PasswordHint01</p>
                <ul>
                    @Html.Raw(Security.PasswordHint02)
                </ul>
                @Html.Raw(Security.PasswordHint03)
            </div>
        </div>
    </div>
</div>

@Html.Hidden("hashkey", string.Empty)
@Html.Hidden("alert-old-password-empty", Security.alertInputOldPwd)
@Html.Hidden("alert-password-empty", Security.alertPasswordEmpty)
@Html.Hidden("alert-password-confirm", Security.alertErrorConfirm)
@Html.Hidden("alert-password-require", Security.lblPasswordRequire)
@Html.Hidden("alert-password-change-successfully", Security.lblPasswordChangedOK)
@Html.Hidden("alert-password-wrong-rule", Security.lblPasswordWrongRule)
@Html.Hidden("alert-same-password", Security.lblPasswordDOldOne)
@Html.Hidden("alert-password-not-contain-nickname-username", Security.lblPasswordDAccountName)
@Html.Hidden("oldMainRootPath", string.Empty)
@Html.Hidden("mainRootPath", string.Empty)

@section js {
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
 <script src="@StaticResources.MainSiteScriptUrl("~/Assets/bundles/password/change-password")" type="text/javascript"></script>
}

