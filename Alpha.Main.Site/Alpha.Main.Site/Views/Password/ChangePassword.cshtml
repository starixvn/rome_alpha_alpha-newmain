
@{
    ViewBag.Title = "ChangePassword";
}

@section css {
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/security-super")
    <link href="@StaticResources.MainSiteStyleUrl("~/Assets/bundles/security/security")" rel="stylesheet" type="text/css" />
}

<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="#" role="tab" data-toggle="tab">Password</a>
    </li>
    <li role="presentation">
        <a href="#" role="tab" data-toggle="tab">Security Code</a>
    </li>
</ul>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active">
        <div class="block">
            <form class="form-SC">
                <div class="form-group">
                    <label>Old Password</label>
                    <input type="password" class="txt form-control" name="oldSC" id="txtOldSecCode">
                </div>
                <div class="form-group">
                    <label>New Password</label>
                    <input type="password" class="txt form-control" name="SC" id="txtSecCode">
                </div>
                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" class="txt form-control" name="confirmSC" id="txtConfirmSecCode">
                </div>
                <div class="form-group">
                    <input type="submit" class="btn-submit" value="Submit" />
                    <input type="reset" value="Reset" />
                </div>
            </form>
            <div class="rules">
                <p><span class="note-red">*</span>Password must be at least 8 characters without white-space and contain at least 3 of the following:</p>
                <ul>
                    <li>Uppercase letter [A-Z]</li>
                    <li>Lowercase letter [a-z]</li>
                    <li>Numeric [0-9]</li>
                    <li>Special character (!,,#,etc..)</li>
                </ul>
                <p><strong>For example</strong>: 59D7!4$h, 493abcDE</p>
                <p><strong>Note</strong>: your password is cAsE sEnSiTiVe</p>
            </div>
        </div>
    </div>
</div>