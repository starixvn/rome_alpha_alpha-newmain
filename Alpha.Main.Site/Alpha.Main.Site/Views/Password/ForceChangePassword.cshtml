
@{
    ViewBag.Title = "ForceChangePassword";
}

@section css {
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/before-home-page")
}

<div class="block">
    <form action="" method="post" id="pwdForm" novalidate="novalidate">
        <div class="box-lang">
            <div class="dropdown">
                <span class="btn dropdown-toggle" type="button" id="langList" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                    <span class="flag flag-en"></span>
                    English
                    <span class="caret"></span>
                </span>
                <ul class="dropdown-menu" aria-labelledby="langList">
                    <li><a href="#"><span class="flag flag-en"></span>English</a></li>
                    <li><a href="#"><span class="flag flag-cn"></span>繁體中文</a></li>
                    <li><a href="#"><span class="flag flag-tw"></span>简体中文</a></li>
                    <li><a href="#"><span class="flag flag-jp"></span>日本語</a></li>
                    <li><a href="#"><span class="flag flag-th"></span>ภาษาไทย</a></li>
                    <li><a href="#"><span class="flag flag-kr"></span>한국어</a></li>
                    <li><a href="#"><span class="flag flag-vn"></span>Tiếng Việt</a></li>
                </ul>
            </div>
        </div>
        <h1 class="title">Password</h1>
        <p> hi John88, please create your own password</p>
        <figure class="avatar">
            <img src="~/assets/styles/security/images/1.jpg" alt="Avatar">
            <figcaption><span class="username">S688H</span><br /><span class="nickname">(John88)</span></figcaption>
        </figure>
        <div class="rowlg">
            <input type="password" class="txt" name="txtOldPassword" id="txtOldPassword" placeholder="Old password">
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg help-rules">
            <input type="password" class="txt" name="txtNewPassword" placeholder="New Password" id="txtNewPassword">
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg">
            <input type="password" class="txt" name="txtConfirmPassword" placeholder="Confirm password" id="txtConfirmPassword">
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" value="Back" id="backBtn" />
            <input type="submit" class="btn-submit" value="Submit" id="submitBtn" />
        </div>
    </form>
    <div class="rules" id="rules">
        <div class="rules-title" id="rules-title" data-toggle="modal" data-target="#pwd"><span class="icon-information-outline icon-rules"></span>Password rules</div>
        <!-- Modal -->
        <div class="modal fade information" id="pwd" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <span class="close" data-dismiss="modal" aria-label="Close"></span>
                        <h4 class="modal-title" id="myModalLabel"><span class="icon-information-outline icon-rules"></span>Password rules</h4>
                    </div>
                    <div class="modal-body">
                        <p>Password must be at least 8 characters without white-space and contain at least 3 of the following:</p>
                        <ul>
                            <li>Uppercase letter [A-Z]</li>
                            <li>Lowercase letter [a-z]</li>
                            <li>Numeric [0-9]</li>
                            <li>Special character (!,,#,ect...)</li>
                        </ul>
                        <p><strong>For example</strong>: 59D7!4$h, 493abcDE</p>
                        <p><strong>Note</strong>: your password is cAsE sEnSiTiVe</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section js {
    @StaticResources.AssetScripts.Render("/bundles/site-main/security-code/before-home-page")
}

