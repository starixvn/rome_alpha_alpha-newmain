@model ForceChangePasswordViewModel
@{
    ViewBag.Title = "ForceChangePassword";
}

@section css {
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/before-home-page")
}

<div class="block">
    <form action="" method="post" id="pwdForm" novalidate="novalidate">
        <div class="box-lang">
            <div class="dropdown">
                <span class="btn dropdown-toggle" type="button" id="langList" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                    <span class="flag flag-en"></span>
                    English
                    <span class="caret"></span>
                </span>
                <ul class="dropdown-menu" aria-labelledby="langList">
                    <li><a href="#"><span class="flag flag-en"></span>English</a></li>
                    <li><a href="#"><span class="flag flag-cn"></span>繁體中文</a></li>
                    <li><a href="#"><span class="flag flag-tw"></span>简体中文</a></li>
                    <li><a href="#"><span class="flag flag-jp"></span>日本語</a></li>
                    <li><a href="#"><span class="flag flag-th"></span>ภาษาไทย</a></li>
                    <li><a href="#"><span class="flag flag-kr"></span>한국어</a></li>
                    <li><a href="#"><span class="flag flag-vn"></span>Tiếng Việt</a></li>
                </ul>
            </div>
        </div>
        <h1 class="title">@Resources.password</h1>
        <p> @(string.Format(@Security.SecurityCodeShower, "John88"))</p>
        <figure class="avatar">
            <img src="~/assets/styles/security/images/1.jpg" alt="Avatar">
            <figcaption><span class="username">S688H</span><br /><span class="nickname">(John88)</span></figcaption>
        </figure>
        <div class="rowlg">
            <input type="password" class="txt" name="txtOldPassword" id="txtOldPwd" placeholder="@Security.lblOldPassword">
            <label id="txtOldPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg help-rules">
            <input type="password" class="txt" name="txtNewPassword" placeholder="@Security.NewPassword" id="txtNewPwd">
            <label id="txtNewPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg">
            <input type="password" class="txt" name="txtConfirmPassword" placeholder="@Security.lblConfirmPassword" id="txtConfirmPwd">
            <label id="txtConfirmPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" id="btn-back" value="@Security.Back" />
            <input type="submit" class="btn-submit" value="@Security.Submit" />
        </div>
    </form>
    <div class="rules" id="rules">
        <div class="rules-title" id="rules-title" data-toggle="modal" data-target="#pwd"><span class="icon-information-outline icon-rules"></span>Password rules</div>
        <!-- Modal -->
        <div class="modal fade information" id="pwd" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <span class="close" data-dismiss="modal" aria-label="Close"></span>
                        <h4 class="modal-title" id="myModalLabel"><span class="icon-information-outline icon-rules"></span>@Security.PasswordRules</h4>
                    </div>
                    <div class="modal-body">
                        <p>@Security.PasswordHint01</p>
                        <ul>
                            @Html.Raw(Security.PasswordHint02)
                        </ul>
                        @Html.Raw(Security.PasswordHint03)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Hidden("hashkey", Model.HashKey)
@Html.Hidden("please-enter-oldPassword", Security.alertInputOldPwd)
@Html.Hidden("password-cannot-empty", Security.alertPasswordEmpty)
@Html.Hidden("not-correct-confirm-password", Security.alertErrorConfirm)
@Html.Hidden("password-at-least-8chars", Security.lblPasswordRequire)
@Html.Hidden("password-change-successfully", Security.lblPasswordChangedOK)
@Html.Hidden("password-does-not-min-requirement", Security.lblPasswordWrongRule)
@Html.Hidden("newPassword-must-be-diff-old", Security.lblPasswordDOldOne)
@Html.Hidden("password-not-contain-nickname-username", Security.lblPasswordDAccountName)
@Html.Hidden("oldMainRootPath", Model.OldMainRootPath)
@Html.Hidden("mainRootPath", Model.MainRootPath)

@section js {
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    <script src="@StaticResources.MainSiteScriptUrl("~/Assets/bundles/security/password/force-change-password")" type="text/javascript"></script>
}
