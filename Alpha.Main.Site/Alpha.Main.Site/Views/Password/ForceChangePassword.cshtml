@model ForceChangePasswordViewModel
@{
    ViewBag.Title = Security.lblChangePassword;
    Layout = "~/Views/Password/Shared/_Layout.cshtml";
}

@section css {
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/before-home-page")
}

<div class="block">
    <form class="form-SC form-validation" action="" method="post" id="pwdForm" novalidate="novalidate">
        @Html.Action("Languages", "SecurityCode")
        <h1 class="title">@Resources.password</h1>
        <p> @(string.Format(@Security.PasswordShower, @Model.UsernameShower))</p>
        <figure class="avatar">
            <img id="logoProfileImg" src='@(Model.IsDefaultAvatar ? Url.Content("~/assets/images/icon_user_default.png") : Model.EmbedImage)' alt="Avatar" />
            <figcaption><span class="username">@Model.Username</span><br /><span class="nickname">@Model.AlternateUsername</span></figcaption>
        </figure>
        <div class="rowlg">
            <input type="password" autocomplete="off" class="txt" name="txtOldPassword" id="txtOldPwd" placeholder="@Security.lblOldPassword" maxlength="16" />
            <label id="txtOldPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg help-rules">
            <input type="password" autocomplete="off" class="txt" name="txtNewPassword" placeholder="@Security.NewPassword" id="txtNewPwd" maxlength="16" />
            <label id="txtNewPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg">
            <input type="password" autocomplete="off" class="txt" name="txtConfirmPassword" placeholder="@Security.lblConfirmPassword" id="txtConfirmPwd" maxlength="16" />
            <label id="txtConfirmPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg">
            <label><input type="checkbox" id="showPasswordchk" /> @Security.ShowPassword</label>
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" id="btn-back" value="@Security.lblBack" />
            <input type="submit" class="btn-submit" value="@Security.Submit" />
        </div>
    </form>
    <div class="rules" id="rules">
        <div class="rules-title" id="rules-title" data-toggle="modal" data-target="#pwd"><span class="icon-information-outline icon-rules"></span>@Security.PasswordRules</div>
        <!-- Modal -->
        <div class="modal fade information" id="pwd" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <span class="icon icon-close close" data-dismiss="modal" aria-label="Close"></span>
                        <h4 class="modal-title" id="myModalLabel"><span class="icon-information-outline icon-rules"></span>@Security.PasswordRules</h4>
                    </div>
                    <div class="modal-body">
                        <p>@Security.PasswordHint01</p>
                        <ul>
                            @Html.Raw(Security.PasswordHint02)
                        </ul>
                        @Html.Raw(Security.PasswordHint03)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Hidden("hashkey", Model.HashKey)
@Html.Hidden("oldMainRootPath", Model.OldMainRootPath)
@Html.Hidden("mainRootPath", Model.MainRootPath)

@section js {
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    <script src="@StaticResources.MainSiteScriptUrl("~/Assets/bundles/security/password/force-change-password")" type="text/javascript"></script>
}