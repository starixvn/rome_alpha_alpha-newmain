@model PasswordViewModel
@{
    ViewBag.Title = Security.lblresetpassword;
    Layout = "~/Views/Password/Shared/_Layout.cshtml";
}

@section css {
    @StaticResources.AssetStyles.Render($"/bundles/common/common")
    <link href="@StaticResources.MainSiteStyleUrl("~/Assets/bundles/security/security")" rel="stylesheet" type="text/css" />
}

<h1 id="title_header" class="page-title">@Model.Title</h1>
<div id="status-message" class="msg-content display-none">
    <div id="status-message-content" class="msg"></div>
</div>
<div class="block" id="container">
    <form class="form-SC form-validation">
        <div class="form-group">
            <label>@Security.NewPassword</label>
            <input type="password" autocomplete="off" class="txt form-control" name="txtNewPassword" id="password" maxlength="16" />
            <i class="validation"></i>
        </div>
        <div class="form-group">
            <label>@Security.lblConfirmPassword</label>
            <input type="password" autocomplete="off" class="txt form-control" name="txtConfirmPassword" id="confirmPassword" maxlength="16" />
            <i class="validation"></i>
        </div>
        <div class="form-group">
            <label><input type="checkbox" id="showPasswordchk" /> @Security.ShowPassword</label>
        </div>
        <div class="form-group">
            <input type="submit" class="btn-submit" value="@Security.Submit" />
            <input type="reset" value="@Security.Reset" />
        </div>
    </form>
</div>
<div class="rules">
    @if (Model.IsChangeMemberPassword)
    {
        <p><span class="note-red">*</span>@Security.PasswordHint04</p>
    }
    else
    {
        <p><span class="note-red">*</span>@Security.PasswordHint01</p>
        <ul>
            @Html.Raw(Security.PasswordHint02)
        </ul>
        @Html.Raw(Security.PasswordHint03)
    }
</div>

@Html.Hidden("hashkey", Model.HashKey)
@Html.Hidden("custId", Model.CustId)
@Html.Hidden("custRoleId", Model.CustRoleId)
@Html.Hidden("mainRootPath", Model.MainRootPath)
@Html.Hidden("isCasinoSync", Model.IsCasinoSync)
@Html.Hidden("isChangeMemberPassword", Model.IsChangeMemberPassword)

@section js {
    @StaticResources.AssetScripts.Render("/bundles/common/common", "/bundles/site-main/security/before-home-page")
    <script src="@StaticResources.MainSiteScriptUrl("~/Assets/bundles/security/password/reset-main-account-password")" type="text/javascript"></script>
}