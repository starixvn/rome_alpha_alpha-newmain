@model PasswordViewModel
@{
    ViewBag.Title = "ResetMainAccountPassword";
}

@section css {
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/default")
    <link href="@StaticResources.MainSiteStyleUrl("~/Assets/bundles/security/security")" rel="stylesheet" type="text/css" />
}

<h1 class="page-title">@Resources.password</h1>
<div id="error-message" class="msg display-none"></div>
<div class="block">
    <form class="form-SC">
        <div class="form-group">
            <label>@Security.lblOldPassword</label>
            <input type="password" class="txt form-control" name="txtNewPassword" id="password">
        </div>
        <div class="form-group">
            <label>@Security.NewPassword</label> 
            <input type="password" class="txt form-control" name="txtConfirmPassword" id="confirmPassword">
        </div>
        <div class="form-group">
            <input type="submit" class="btn-submit" value="@Security.Submit" />
            <input type="reset" value="@Security.Reset" />
        </div>
    </form>
    <div class="rules">
        <p><span class="note-red">*</span>@Security.PasswordHint01</p>
        <ul>
            @Html.Raw(Security.PasswordHint02)
        </ul>
        @Html.Raw(Security.PasswordHint03)
    </div>
</div>
@Html.Hidden("hashkey", Model.HashKey)
@Html.Hidden("password-cannot-empty", Security.alertPasswordEmpty)
@Html.Hidden("not-correct-confirm-password", Security.alertErrorConfirm)
@Html.Hidden("mainRootPath", Model.MainRootPath)

@section js {
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    <script src="@StaticResources.MainSiteScriptUrl("~/Assets/bundles/security/password/reset-main-account-password")" type="text/javascript"></script>
}







