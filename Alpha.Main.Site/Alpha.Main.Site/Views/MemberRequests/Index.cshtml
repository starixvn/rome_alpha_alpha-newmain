@model MemberRequestsViewModel

<div class="container">
    <div class="panel-title">
        <span class="icon-dropbox"></span>
        <span>@Resources.playForFun</span>
        <span class="new-request">(@Model.TotalRequest)</span>

        <span id="icon-help" class="icon-help"></span>
        <span class="badge-title">@Resources.lblNew</span>
    </div>
    <div class="panel-body">
        <div>
            @if (Model.TotalRequest.Equals(0))
            {
            <div class="col-xs-12 center">@(Model.TotalRequest.Equals(0) ? Resources.NoInformationIsAvailable : Resources.memberRequest)</div>
            }
            else
            {
            <div class="col-xs-12 right-align">@Resources.memberRequest</div>
            }

        </div>

        @if (Model.ProductRequests.Any())
        {
            foreach (var productRequest in Model.ProductRequests)
            {
        <div>
            <div class="col-xs-7">
                @if (Model.CanViewReports)
                        {
                <a class="link-color product-item" href="@Model.BuildViewMemberRequestReport(productRequest.ProductId)">@productRequest.ProductName</a>
                        }
                        else
                        {
                <span> @productRequest.ProductName</span>
                        }
            </div>
            <div class="col-xs-5 value">
                @if (productRequest.NumberOfRequest.Equals(0) || Model.UserLevel.IsSuperLevel() || Model.UserLevel.IsMasterLevel() || !Model.CanViewMemberInfo)
                        {
                @productRequest.NumberOfRequest
                        }
                        else
                        {
                <a class="link-color" href="@Model.BuildEnableMemberRequest(productRequest.ProductId)">@productRequest.NumberOfRequest</a>
                        }
            </div>
        </div>
            }
        }
    </div>
</div>
@Html.Hidden("totalRequest", Model.TotalRequest)
@Html.Hidden("GuidelineUrl", AppPathHelper.GetAppPath(HttpRuntime.AppDomainAppVirtualPath, "~/MemberRequests/Guideline"))
@Html.Hidden("PlayForFunGuide", "Play For Fun Guide")