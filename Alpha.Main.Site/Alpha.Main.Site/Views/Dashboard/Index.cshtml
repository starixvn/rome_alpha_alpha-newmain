@model IndexViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.Render($"/bundles/site-main/home/home-super")
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/default-home"))" rel="stylesheet" type="text/css" />
</head>
<body>
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="active">
            <a href="#balance" aria-controls="home" role="tab" data-toggle="tab">@Resources.balanceInfo</a>
        </li>
        <li role="presentation">
            <a href="#stats" aria-controls="home" role="tab" data-toggle="tab">@Resources.statistics</a>
        </li>
        <li role="presentation">
            <a href="#notice" aria-controls="home" role="tab" data-toggle="tab">@Resources.notice</a>
        </li>
    </ul>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active balance-info" id="balance">
            @Html.Action("BalanceInfo")
        </div>
        <div role="tabpanel" class="tab-pane statistic" id="stats" action-url="@Url.Action("Index", "Statistics")">
            <div class="panel-title"><span class="icon-statistics"></span>@Resources.statistics</div>
            <div>Loading...</div>
        </div>
        <div role="tabpanel" class="tab-pane notice" id="notice" action-url="@Url.Action("Index", "Notice")">Loading...</div>
    </div>
    @StaticResources.AssetScripts.Render("/bundles/site-main/home/home-default")
    <script src="@(StaticResources.MainSiteScriptUrl("~/assets/bundles/home-index"))" type="text/javascript"></script>
</body>
</html>