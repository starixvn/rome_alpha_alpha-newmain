@model Alpha.Main.Site.ViewModels.Dashboard.DashboardBannerViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommon("/bundles/site-main/anybody-fonts")
    <style>
        body {
            background: transparent;
        }

        .icon-home {
            margin-right: 0;
        }

            .icon-home:after {
                content: none;
            }

        .text {
            padding: 10px 0;
            margin: 0;
            font-size: 15px;
        }
    </style>
    <style media="screen and (max-device-width: 768px)">
        .text {
            font-size: 20px;
        }
    </style>
    @StaticResources.RenderStyles("~/assets/bundles/whitelabel")
</head>
<body>
    <p class="text">@Html.Raw(string.Format(Resources.DashboardViewOverallInformation, "<span onclick=\"location.href=top.headerNav.urls.home;\" class=\"icon icon-home\"></span>"))</p>
    <div class="white-label">
        <div class="intro">@Resources.WhiteLabel_Intro</div>
        <div class="items">
            <div class="item">
                <div class="image">
                    <img src="~/Assets/Styles/Home/Images/white-label/turnkey.png" />
                </div>
                <div class="content">
                    <div class="title">@Resources.TurnkeySolution</div>
                    <div class="description">@Resources.TurnkeySolution_Description</div>
                </div>
            </div>
            <div class="item">
                <div class="image">
                    <img src="~/Assets/Styles/Home/Images/white-label/no-bad-debt.png" />
                </div>
                <div class="content">
                    <div class="title">@Resources.NoBadDebt</div>
                    <div class="description">@Resources.NoBadDebt_Description</div>
                </div>
            </div>
            <div class="item">
                <div class="image">
                    <img src="~/Assets/Styles/Home/Images/white-label/rich-products-collection.png" />
                </div>
                <div class="content">
                    <div class="title">@Resources.RichProductsCollection</div>
                    <div class="description">@Resources.RichProductsCollection_Description</div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>