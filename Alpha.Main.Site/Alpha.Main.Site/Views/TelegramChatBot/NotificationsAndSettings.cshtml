@model Alpha.Main.Site.ViewModels.TelegramChatBot.ChatBotSettingViewModel

<div class="panel chatbot-setting">
    <div class="panel-heading" role="tab" id="headingNotification">
        <h4 class="panel-title">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#notification" aria-expanded="false" aria-controls="notification">
                @ChatBot.NotificationAndSettings
            </a>
        </h4>
    </div>
    <div id="notification" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingNotification">
        <div class="panel-body has-padding">
            <p>@ChatBot.NotificationAndSettingsIntro: </p>
            <table class="tblRpt tblRpt-bordered tbl-notifications">
                <thead>
                    <tr>
                        <th class="col-notification">@ChatBot.Notification</th>
                        <th>@ChatBot.Description</th>
                        <th class="col-enable">@ChatBot.Enable</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.IsViewReports)
                    {
                        <tr>
                            <td class="text-center bold">@ChatBot.yesterdayWinLoss</td>
                            <td>@ChatBot.YesterdayWinLossNotificationDescription</td>
                            <td class="text-center">
                                <label class="switch">
                                    <input type="checkbox" class="function" checked />
                                    <span class="slider"></span>
                                </label>
                            </td>
                        </tr>
                    }
                    <tr>
                        <td class="text-center bold">@ChatBot.PersonalMessage</td>
                        <td>@ChatBot.PersonalMessageDescription</td>
                        <td class="text-center">
                            <label class="switch">
                                <input type="checkbox" class="function" checked />
                                <span class="slider"></span>
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center bold">@ChatBot.AbnormalLoginAlert</td>
                        <td>@ChatBot.AbnormalLoginAlertDescription</td>
                        <td class="text-center">
                            <label class="switch">
                                <input type="checkbox" class="function" checked />
                                <span class="slider"></span>
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center bold">@ChatBot.ChangePasswordAlert</td>
                        <td>@ChatBot.ChangePasswordAlertDescription</td>
                        <td class="text-center">
                            <label class="switch">
                                <input type="checkbox" class="function" checked />
                                <span class="slider"></span>
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center bold">@ChatBot.ChangeSecurityCodeAlert</td>
                        <td>@ChatBot.ChangeSecurityCodeAlertDescription</td>
                        <td class="text-center">
                            <label class="switch">
                                <input type="checkbox" class="function" checked />
                                <span class="slider"></span>
                            </label>
                        </td>
                    </tr>
                    @if (Model.IsViewMemberInfo)
                    {
                        <tr>
                            <td class="text-center bold">@ChatBot.ProblemAccount</td>
                            <td>@ChatBot.ProblemAccountDescription</td>
                            <td class="text-center">
                                <label class="switch">
                                    <input type="checkbox" class="function" checked />
                                    <span class="slider"></span>
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-center bold">@ChatBot.MemberWinLossLimit</td>
                            <td>@ChatBot.MemberWinLossLimitDescription</td>
                            <td class="text-center">
                                <label class="switch">
                                    <input type="checkbox" class="function" checked />
                                    <span class="slider"></span>
                                </label>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div>@ChatBot.YouCanTurnOnOff</div>
        </div>
    </div>
</div>