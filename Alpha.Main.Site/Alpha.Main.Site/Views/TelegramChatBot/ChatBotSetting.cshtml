@model Alpha.Main.Site.ViewModels.TelegramChatBot.ChatBotSettingViewModel
@{
    Layout = "~/Views/TelegramChatBot/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/chatbot/chatbot-default")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode($"/bundles/site-main/chatbot/tab-{Model.CustLevel}")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/telegramchatbot/chatbot-setting")
}

<div class="page-title">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="active">
            <a href="#telegramchatbot" aria-controls="home" role="tab" data-toggle="tab">@ChatBot.Telegram</a>
        </li>
        <li role="presentation">
            @Html.ActionLink("Letstalk", "Index", "ChatBot")
        </li>
    </ul>
</div>
<div class="tab-content">
    <div class="panel">
        <div class="panel-heading" role="tab" id="headingAccount">
            <h4 class="panel-title">
                <a role="button" data-toggle="collapse" href="#account" aria-expanded="false" aria-controls="account">
                    @ChatBot.Account
                </a>
            </h4>
        </div>
        <div id="account" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingAccount">
            <div class="panel-body account-info">
                <div id="account-message" class="container-msg"></div>
                <form class="filter">
                    <div class="form-group">
                        <label>@ChatBot.YourTelegramId: <span class="chatbot-name">@Model.TelegramId</span></label>
                        <button class="btn-remove" id="btnUnsubscribe">@ChatBot.unLink</button>
                    </div>
                    <div class="form-group only-text">
                        <label>@ChatBot.ChatbotName: <span class="chatbot-name">@Model.ChatBotName</span></label>
                    </div>
                    <div class="form-group">
                        <label>@ChatBot.ChatBotLanguage:</label>
                        <div class="dropdown language">
                            @Html.Action("Language", new { langCode = Model.Language })
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    @{ Html.RenderPartial("Reports"); }
    @{ Html.RenderPartial("NotificationsAndSettings"); }
</div>
@Html.Hidden("UnsubscribeWarning", string.Format(ChatBot.UnsubscribeTelegramBotWarning, Model.ChatBotName))
@Html.Hidden("UpdateLanguageFailed", ChatBot.updateLanguageFailed)
@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/telegramchatbot/telegram-chatbot-setting")
}