@model Alpha.Main.Site.ViewModels.TelegramChatBot.RegisterAccountViewModel
@{
    Layout = "~/Views/TelegramChatBot/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/chatbot/chatbot-default")
    @StaticResources.AssetStyles.RenderCommonWithDarkMode($"/bundles/site-main/chatbot/tab-{Model.CustLevel}")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/telegramchatbot/register-account")
}

@{ Html.RenderPartial("Tab", Model.IsShowLetstalkChatBot); }

<div class="tab-content">
    <div class="panel" id="register-panel">
        <div class="panel-heading" role="tab" id="headingRegister">
            <h4 class="panel-title">
                <a role="button" data-toggle="collapse" data-parent="#accordion" href="#registerTelegram" aria-expanded="false" aria-controls="registerTelegram">
                    Account
                </a>
            </h4>
        </div>
        <div id="registerTelegram" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingRegister">
            <div class="panel-body has-padding">
                <p>
                    @Html.Raw(ChatBot.IntroTelegramChatbot)
                </p>
                <ul id="registerTelegramPanel" class="list-requirements">
                    <li>
                        <p class="bold">@ChatBot.InstallTelegram</p>
                        <p><a class="link" href="https://www.telegram.org/" target="_blank"><strong>@ChatBot.Telegram</strong></a> @Html.Raw(@ChatBot.IntroTelegram)</p>
                        <div class="download-content">
                            <div class="logo-telegram">
                                <img id="logoTelegram" src="~/Assets/Styles/telegramchatbot/images/telegram.png" />
                                <img class="qr-code hide" id="imgQRCode" src="~/Assets/styles/telegramchatbot/images/telegram-qr-code.jpg" />
                                <a href="#" class="link qr-code-link" id="showQRCode">@ChatBot.showQRCode</a>
                                <a href="#" class="link qr-code-link hide" id="hideQRCode">@ChatBot.hideQRCode</a>
                            </div>
                            <div class="list-download">
                                <h2>@ChatBot.Telegram</h2>
                                <p><strong>@ChatBot.TelegramMessengerInc</strong></p>
                                <ul class="list-inline">
                                    <li>
                                        <a href="https://apps.apple.com/app/telegram-messenger/id686449807" class="btn-download-ios" target="_blank">
                                            <img src="~/Assets/Styles/telegramchatbot/images/apple.png" />
                                        </a>
                                    </li>
                                    <li>
                                        <a href="https://play.google.com/store/apps/details?id=org.telegram.messenger" target="_blank" class="btn-download-android">
                                            <img src="~/Assets/Styles/telegramchatbot/images/google.png" />
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                    <li>
                        <p class="bold">@ChatBot.StartSettingUp</p>
                        <button class="btn-chatbot btn-gen-qr-code" id="btnGenQRCode">@ChatBot.GeneratePrivateQRCode</button>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@Html.Hidden("UnsubscribeWarning", ChatBot.UnsubscribeWarning)
@Html.Hidden("InvalidOTP", ChatBot.InvalidOTP)
@Html.Hidden("OTPIsRequired", ChatBot.OTPIsRequired)
@Html.Hidden("ResendOTPSuccessfully", ChatBot.ResendOTPSuccessfully)
@Html.Hidden("CaptchaIsRequired", ChatBot.captchaIsRequired)
@Html.Hidden("Language", Model.Language)
@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/telegramchatbot/register-account")
}