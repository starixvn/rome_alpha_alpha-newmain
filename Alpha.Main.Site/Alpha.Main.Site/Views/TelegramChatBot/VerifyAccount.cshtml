@model Alpha.Main.Site.ViewModels.TelegramChatBot.VerifyAccountViewModel
<li>
    <p class="bold">Scan this QR Code with your mobile to open Telegram Chatbot with your mobile</p>
    <p>(Do not open the app without scanning this QR Code)</p>
    <div class="list-qr-code">
        <img class="private-qr-code-img" id="imgPrivateQRCode" src="@(Model.QRCodeDataUrl)" />
        <div class="private-qr-code-link">Or use this link: <br /> <a class="link" href="@(Model.Url)">@(Model.Url)</a></div>
    </div>
    <div>Select START on Telegram Chatbot then proceed to next step</div>
</li>
<li>
    <p class="bold">Enter the generated OTP from Telegram Chatbot within 3 minutes to verify your account</p>
    <div id="verification-code-message"></div>
    <form class="verification-form" id="verification-form" action="@Url.Action("VerifyOTP")" method="post">
        <div class="form-group">
            <label>OTP</label>
            <input name="OTP" id="txtOTP" maxlength="6" type="tel" class="verify-text" />
        </div>
        <div id="captcha-container">
            @if (Model.IsShowCaptcha)
            {
                @Html.Partial("Captcha")
            }
        </div>
        <div class="form-group list-button">
            <button id="btnVerify" class="btn-chatbot btn-verify" type="submit">Verify OTP</button>
            <span class="msg-expired hide"><strong><em>OTP is expired, please <button id="btnResend" class="resend-code">click here</button> to generate new OTP.</em></strong></span>
        </div>
    </form>
</li>