@using System.Globalization
@model string
@{
    Layout = "~/Views/ChatBot/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/chatbot/chatbot-setting")
}
<div class="chatbot-layout -report" id="chatbotLayout">
    <div class="chatbot-header">
        <span class="icon-chatbot-back"></span>
        <span class="title">@ChatBot.Atom</span>
        <span class="icon-chatbot-call"></span>
        <span class="icon-chatbot-down"></span>
    </div>
    <div class="chatbot-body" id="chatbotBody">
        <ul class="list-commands" id="listCommand">
            <li class="command">
                <div class="user-input">/os 3</div>
                <div class="status-user-input">
                    @ChatBot.Read <br />
                    12:31
                </div>
            </li>
            <li class="command">
                <div class="chatbot-reponse">
                    <div>[@Resources.member - 20181015]</div>
                    <div>@Resources.member / @Resources.member • @Resources.agent </div>
                    <div>------------------------------------</div>
                    <div>@Resources.Total.ToUpperInvariant()</div>
                    <div class="p-l-13px">1,000,000.00 • 100,000.00</div>

                    <ul class="list-style-number">
                        <li>
                            <div>Member1</div>
                            <p>100,000.00 • 10,000.00</p>
                        </li>
                        <li>
                            <div>Member2</div>
                            <p>70,000.00 • 7,000.00</p>
                        </li>
                        <li>
                            <div>Member3</div>
                            <p>60,000.00 • 6,000.00</p>
                        </li>
                    </ul>
                    <p>@ChatBot.OutstandingHiddenDownlinesCount</p>
                    <p>
                        * @ChatBot.OutstandingHint
                    </p>
                </div>
                <div class="status-chatbot-reponse">
                    12:31
                </div>
            </li>
            <li class="command">
                <div class="user-input">/os member2</div>
                <div class="status-user-input">
                    <div>@ChatBot.Read</div>
                    <div>12:32</div>
                </div>
            </li>
            <li class="command">
                <div class="chatbot-reponse">                    
                    <div>[@Resources.outstanding - 20181015]</div>
                    <div>@Resources.member</div>
                    <div class="p-l-13px">Member2</div>
                    <div>@Resources.member</div>
                    <div class="p-l-13px">1,000.00</div>
                    <div>@Resources.agent</div>
                    <div class="p-l-13px">50.00</div>
                </div>
                <div class="status-chatbot-reponse">
                    12:32
                </div>
            </li>
            <li class="command">
                <div class="user-input">/wl</div>
                <div class="status-user-input">
                    <div>@ChatBot.Read</div>
                    <div>12:36</div>
                </div>
            </li>
            <li class="command">
                <div class="chatbot-reponse">
                    <div>[@Resources.ResourceManager.GetString("todayWinLoss", CultureInfo.GetCultureInfo(Model)) - @DateTime.Now.ToString("yyyyMMdd")]</div>
                    <div>@Resources.ResourceManager.GetString("turnover", CultureInfo.GetCultureInfo(Model))</div>
                    <div class="p-l-13px">30,000.00</div>
                    <div>@ChatBot.ResourceManager.GetString("grossComm", CultureInfo.GetCultureInfo(Model))</div>
                    <div class="p-l-13px">50.00</div>
                    <div>@ChatBot.ResourceManager.GetString("memberWinLoss", CultureInfo.GetCultureInfo(Model))</div>
                    <div class="p-l-13px">5,000.00</div>
                </div>
                <div class="status-chatbot-reponse">
                    12:36
                </div>
            </li>
            <li class="command">
                <div class="user-input">/bal</div>
                <div class="status-user-input">
                    <div>@ChatBot.Read</div>
                    <div>12:39</div>
                </div>
            </li>
            <li class="command">
                <div class="chatbot-reponse">
                    <div>[@Resources.ResourceManager.GetString("balanceInfo", CultureInfo.GetCultureInfo(Model)) - @DateTime.Now.ToString("yyyyMMdd")]</div>
                    <div>@Resources.ResourceManager.GetString("currency", CultureInfo.GetCultureInfo(Model))<br /></div>
                    <div class="p-l-13px">UUS</div>
                    <div>@Resources.ResourceManager.GetString("cashBalance", CultureInfo.GetCultureInfo(Model))</div>
                    <div class="p-l-13px">1,500,000.00</div>
                    <div>@Resources.ResourceManager.GetString("yesterdayCashBalance", CultureInfo.GetCultureInfo(Model))</div>
                    <div class="p-l-13px">1,500,000.00</div>
                </div>
                <div class="status-chatbot-reponse">
                    12:39
                </div>
            </li>
        </ul>
    </div>
    <div class="data-input">
        <span class="icon-chatbot-plus"></span>
        <span class="icon-chatbot-gif"></span>
        <input type="text" id="reportText" class="chatbot-text" placeholder="@ChatBot.ResourceManager.GetString("inputCommand", CultureInfo.GetCultureInfo(Model))" disabled />
        <span class="icon-chatbot-voice"></span>
    </div>
    <div class="list-actions">
        <div class="btn-play hide" id="btnReplay">
            <span class="icon-play-button"></span> @ChatBot.play
        </div>
        <div class="btn-play disabled" id="btnPlaying">
            <span class="icon-pause-button"></span> @ChatBot.playing
        </div>
    </div>
</div>
@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/chatbot/chatbot-guide")
}