<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>SMA Chat Bot</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommon("/bundles/site-main/chatbot/chatbot-default")
    @StaticResources.RenderStyles("~/assets/bundles/chatbot/chatbot")
    @RenderSection("Styles", required: false)
</head>
<body>
    @RenderBody()
    @Html.Hidden("ThisFieldRequired", ChatBot.AlertRequiredField)
    @Html.Hidden("AccountDoesNotExist", ChatBot.AccountDoesNotExist)
    @Html.Hidden("VerificationCodeIsInvalidOrExpired", ChatBot.VerificationCodeIsInvalidOrExpired)
    @Html.Hidden("OverMaxAddAccountTimes", ChatBot.OverMaxAddAccountTimes)
    @Html.Hidden("AccountHasAlreadyBeenRegistered", ChatBot.AccountHasAlreadyBeenRegistered)
    @Html.Hidden("UnsubscribeWarning", ChatBot.UnsubscribeWarning)
    @Html.Hidden("UpdateLanguageFailed", ChatBot.updateLanguageFailed)
    @Html.Hidden("AccountIsRequired", ChatBot.AccountIsRequired)
    @Html.Hidden("VerificationCodeIsRequired", ChatBot.verificationCodeIsRequired)
    @Html.Hidden("CaptchaIsRequired", ChatBot.captchaIsRequired)
    @Html.Hidden("mainRootPath", MicroSites.MainUrl())
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/chatbot/chatbot-default")
    @RenderSection("Scripts", required: false)
    @GoogleAnalyticHepler.Render()
</body>
</html>