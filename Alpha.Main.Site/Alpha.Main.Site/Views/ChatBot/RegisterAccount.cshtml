@model RegisterAccountViewModel
@{
    Layout = "~/Views/ChatBot/Shared/_Layout.cshtml";
    var darkModeName = ViewData["DarkModeName"];
}
@section Styles {
    @StaticResources.AssetStyles.RenderCommon($"/bundles/site-main/chatbot/chatbot-default{darkModeName}")
    @StaticResources.RenderStyles($"~/assets/bundles/chatbot/register-account{darkModeName}")
}
<div class="page-title title-@ViewData["TitleLevel"]">
    <span class="pull-left">@Model.Title</span>
</div>
<div class="tab-content">
    <div class="panel" id="register-panel">
        <div class="panel-heading" role="tab" id="headingRegister">
            <h4 class="panel-title">
                <a role="button" data-toggle="collapse" data-parent="#accordion" href="#registerLetstalk" aria-expanded="false" aria-controls="registerLetstalk">
                    @ChatBot.ChatbotSetup
                </a>
            </h4>
        </div>
        <div id="registerLetstalk" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingRegister">
            <div class="panel-body has-padding">
                <p>@Html.Raw(ChatBot.IntroChatbot)</p>
                <ul id="registerLetstalkPanel" class="list-requirements">
                    <li>
                        <p class="bold">@ChatBot.InstallLetstalk</p>
                        <p><a class="link" href="https://www.letstalk.net/" target="_blank"><strong>@ChatBot.letstalkIM</strong></a> @Html.Raw(@ChatBot.IntroLetstalk)</p>
                        <div class="download-content">
                            <div class="logo-letstalk">
                                <img id="logoLetstalk" src="~/Assets/Styles/chatbot/images/letstalk.png" />
                                <img class="qr-code hide" id="imgQRCode" src="~/Assets/styles/chatbot/images/qrcode.png" />
                                <a href="#" class="link qr-code-link" id="showQRCode">@ChatBot.showQRCode</a>
                                <a href="#" class="link qr-code-link hide" id="hideQRCode">@ChatBot.hideQRCode</a>
                            </div>
                            <div class="list-download">
                                <h2>@ChatBot.letstalkIM</h2>
                                <p><strong>@ChatBot.letstalkTechLmd</strong></p>
                                <ul class="list-inline">
                                    <li>
                                        <a href="https://itunes.apple.com/us/app/letstalk-im/id1270059337?mt=8" class="btn-download-ios" target="_blank">
                                            <img src="~/Assets/Styles/chatbot/images/apple.png" />
                                        </a>
                                    </li>
                                    <li>
                                        <a href="https://play.google.com/store/apps/details?id=com.onelab.securecomm&hl=en" target="_blank" class="btn-download-android">
                                            <img src="~/Assets/Styles/chatbot/images/google.png" />
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                    <li>
                        <p class="bold">@ChatBot.pleaseInputLetstalkAccount</p>
                        <div id="add-account-message"></div>
                        <form class="add-letstalk">
                            <div class="form-group m-b-0">
                                <input id="txtAccount" type="text" maxlength="50" class="letstalk-text" value="@Model.LetstalkId" @(Model.IsVerifying ? "disabled" : string.Empty) />
                                <button id="btnAdd" class="btn-submit @(Model.IsVerifying ? "display-none" : "")">@ChatBot.link</button>
                                <button id="btnUnsubscribe" class="btn-remove @(Model.IsVerifying ? "" : "display-none")">@ChatBot.unLink</button>
                                @if (!Model.IsVerifying)
                                {
                                    <div class="call-action" id="divLinkTooltip">
                                        <div class="pulse-box">
                                            <div class="pulse-css"></div>
                                        </div>
                                        <div class="popover-simple arrow-left">@ChatBot.LinkTooltip</div>
                                    </div>
                                }
                            </div>
                        </form>
                    </li>
                    @if (Model.IsVerifying)
                    {
                        Html.RenderPartial("VerifyAccount", Model.VerifyAccountViewModel);
                    }
                </ul>
            </div>
        </div>
    </div>
    @{ Html.RenderPartial("LetstalkFunction", Model.ChatBotViewModel); }
</div>
@Html.Hidden("IsVerifying", Model.IsVerifying)
@Html.Hidden("AccountIsRequired", ChatBot.AccountIsRequired)
@Html.Hidden("AccountDoesNotExist", ChatBot.AccountDoesNotExist)
@Html.Hidden("AccountHasAlreadyBeenRegistered", ChatBot.AccountHasAlreadyBeenRegistered)
@Html.Hidden("OverMaxAddAccountTimes", ChatBot.OverMaxAddAccountTimes)
@Html.Hidden("UnsubscribeWarning", ChatBot.UnsubscribeWarning)
@Html.Hidden("VerificationCodeIsRequired", ChatBot.verificationCodeIsRequired)
@Html.Hidden("CaptchaIsRequired", ChatBot.captchaIsRequired)
@Html.Hidden("VerificationCodeIsInvalidOrExpired", ChatBot.VerificationCodeIsInvalidOrExpired)
@Html.Hidden("ReportExample", ChatBot.reportExample)
@Html.Hidden("NotificationExample", ChatBot.notificationExample)
@Html.Hidden("ActionExample", ChatBot.actionExample)
@Html.Hidden("Language", Model.Language)
@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/chatbot/register-account")
}