<li>
    <strong>@ChatBot.EnterVerificationCode</strong>
    <ul class="verification-info">
        <li class="chatbot-example">
            <p>@Html.Raw(ChatBot.VerificationCodeExample)</p>
            <img src="~/Assets/Styles/chatbot/images/verify-letstalk.png" alt="Chatbot" />
        </li>
        <li>@ChatBot.InputVerificationCode</li>
    </ul>
    <div id="verification-code-message"></div>
    <form class="verification-form" id="verification-form">
        <div class="form-group">
            <label>@ChatBot.lblVerificationCode</label>
            <input id="txtVerificationCode" maxlength="6" type="password" class="verify-text" />
        </div>
        <div class="form-group">
            <label>Captcha</label>
            <div class="group-captcha">
                <input type="text" class="captcha-text" />
                <div class="captcha-code">
                    <img alt="" src="~/Assets/Styles/chatbot/images/captcha.png" width="100px" height="30px" />
                </div>
                <i class="icon-refresh"></i>
            </div>
        </div>
        <div class="form-group last">
            <input id="btnVerify" class="btn-submit" type="submit" value="@ChatBot.Verify" />
            <input id="btnResend" class="btn-reset" type="button" value="@ChatBot.Resend" />
        </div>
    </form>
</li>