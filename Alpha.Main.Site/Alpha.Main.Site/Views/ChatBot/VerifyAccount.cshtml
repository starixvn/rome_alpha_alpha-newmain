@model VerifyAccountViewModel
<li id="verification-section">
    <p><strong>@ChatBot.EnterVerificationCode</strong></p>
    <p>@ChatBot.IntroVerificationCode</p>
    <div id="verification-code-message"></div>
    <form class="verification-form" id="verification-form" action="@Url.Action("VerifyVerificationCode")" method="post">
        <input type="hidden" id="UserId" name="UserId" value="@Model.UserId" />
        <input type="hidden" id="MessengerAccount" name="MessengerAccount" value="@Model.MessengerAccount" />
        <div class="form-group">
            <label>@ChatBot.lblVerificationCode</label>
            <input name="VerificationCode" id="txtVerificationCode" maxlength="6" type="tel" class="verify-text" />
        </div>
        <div id="captcha-container">
            @if (Model.IsShowCaptcha)
            {
                @Html.Partial("Captcha")
            }
        </div>
        <div class="form-group list-button">
            <button id="btnVerify" class="btn-submit" type="submit">@ChatBot.Verify (<span id="countdown">179</span>)</button>
        </div>
    </form>
    <p>@ChatBot.expiredOrDidNotRecieveTheCode <button id="btnResend" class="resend-code">@ChatBot.Resend</button></p>
</li>