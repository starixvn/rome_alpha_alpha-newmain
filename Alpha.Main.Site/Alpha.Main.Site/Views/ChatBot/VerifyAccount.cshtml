@using CaptchaMvc.HtmlHelpers;
@model VerifyAccountViewModel
<li id="verification-section">
    <strong>@ChatBot.EnterVerificationCode</strong>
    <ul class="verification-info">
        <li class="chatbot-example">
            <p>@Html.Raw(ChatBot.VerificationCodeExample)</p>
            <div class="chatbot-layout -register">
                <div class="chatbot-header">
                    <span class="icon-chatbot-back"></span>
                    <span class="title">@ChatBot.ChatBotTitle</span>
                    <span class="icon-chatbot-call"></span>
                    <span class="icon-chatbot-down"></span>
                </div>
                <div class="chatbot-body -large" id="reportBody">
                    <button class="btn-add-friend">
                        <span class="icon-addfriend"></span> Add Friend
                    </button>
                    <ul class="list-commands" id="reportCommands">
                        <li class="command">
                            <div class="chatbot-reponse">
                                You have requested to set up Chatbot for your account Supertest1.
                                Your verification code is 123456.
                                The code will be expired in 3 minutes.
                                To secure your information, please delete this message
                                after completing verification.
                            </div>
                            <div class="status-chatbot-reponse">
                                12:30
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </li>
        <li>@ChatBot.InputVerificationCode</li>
    </ul>
    <div id="verification-code-message"></div>
    <form class="verification-form" id="verification-form" action="@Url.Action("VerifyVerificationCode")" method="post">
        <input type="hidden" id="UserId" name="UserId" value="@Model.UserId" />
        <input type="hidden" id="MessengerAccount" name="MessengerAccount" value="@Model.MessengerAccount" />
        <input type="hidden" id="IsShowCaptcha" name="IsShowCaptcha" value="@Model.IsShowCaptcha.ToString()" />
        <div class="form-group">
            <label>@ChatBot.lblVerificationCode</label>
            <input name="VerificationCode" id="txtVerificationCode" maxlength="6" type="text" class="verify-text" />
        </div>
        @*@if (Model.IsShowCaptcha)
        {
            @Html.Captcha(4, "Captcha", ViewData)
        }*@
        @Html.Captcha(4, "Captcha", ViewData)
        <div class="form-group list-button">
            <input id="btnVerify" class="btn-submit" type="submit" value="@ChatBot.Verify (180)" />
            @*<input id="btnResend" class="btn-refresh" type="button" value="@ChatBot.Resend" />*@
        </div>
    </form>
    <p>Expired or didn't recieve the code? <a href="#" class="resend-code">Resend</a></p>
</li>