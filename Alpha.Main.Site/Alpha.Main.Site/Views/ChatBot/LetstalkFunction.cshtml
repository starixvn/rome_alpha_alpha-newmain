@model ChatBotViewModel
@{ var enableEditStatus = Model.IsAlreadySetup; }

<div class="panel chatbot-setting">
    <div class="panel-heading" role="tab" id="headingReport">
        <h4 class="panel-title">
            <a role="button" data-toggle="collapse" href="#report" aria-expanded="false" aria-controls="report">
                @ChatBot.FunctionReport
            </a>
        </h4>
    </div>
    <div id="report" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingReport">
        <div class="panel-body has-padding">
            <p>@ChatBot.pleaseSet <img class="toggle-img" src="~/Assets/Styles/chatbot/images/toogle.png" alt="Toggle Button" /> @ChatBot.IntroReport</p>
            <p><a href="#" class="link" id="openReportExample">@ChatBot.howFunctionWorks</a></p>
            <table class="tblRpt tblRpt-bordered tbl-guideline">
                <thead>
                    <tr>
                        <th class="col-command">@ChatBot.Command</th>
                        <th>@ChatBot.FunctionReport</th>
                        <th class="col-status">@Alpha_sitemap.status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var function in Model.ReportFunctions)
                    {
                        <tr>
                            <td class="text-center"><span class="bage">@function.Command</span></td>
                            <td class="bold">@function.Name</td>
                            <td class="text-center">
                                <label class="switch">
                                    <input data-functionId="@function.Id" data-functionName="@function.Name" data-command="@function.Command" type="checkbox"
                                           class="function" @(function.Enabled ? "checked" : string.Empty)
                                           @(enableEditStatus ? string.Empty : "disabled=disabled") />
                                    <span class="slider"></span>
                                </label>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="panel chatbot-setting">
    <div class="panel-heading" role="tab" id="headingNotification">
        <h4 class="panel-title">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#notification" aria-expanded="false" aria-controls="notification">
                @ChatBot.FunctionNotification
            </a>
        </h4>
    </div>
    <div id="notification" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingNotification">
        <div class="panel-body has-padding">
            <p>@ChatBot.pleaseSetNotification <img class="toggle-img" src="~/Assets/Styles/chatbot/images/toogle.png" alt="Toggle Button" /> @ChatBot.IntroNotification</p>
            <p><a href="#" class="link" id="openNotificationExample">@ChatBot.howFunctionWorks</a></p>
            <table class="tblRpt tblRpt-bordered tbl-guideline">
                <thead>
                    <tr>
                        <th>@ChatBot.FunctionNotification</th>
                        <th class="col-status">@Alpha_sitemap.status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var function in Model.NotificationFunctions)
                    {
                        <tr>
                            <td class="bold">@function.Name</td>
                            <td class="text-center">
                                <label class="switch">
                                    <input data-functionId="@function.Id" data-functionName="@function.Name" data-command="@function.Command" type="checkbox"
                                           class="function" @(function.Enabled ? "checked" : string.Empty)
                                           @(enableEditStatus ? string.Empty : "disabled=disabled") />
                                    <span class="slider"></span>
                                </label>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
