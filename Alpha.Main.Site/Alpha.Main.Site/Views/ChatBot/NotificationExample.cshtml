@using Alpha.Main.Site.Helpers
@model string
@{
    Layout = "~/Views/ChatBot/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/chatbot/chatbot-setting")
}
<div class="chatbot-layout -notification" id="chatbotLayout">
    <div class="chatbot-header">
        <span class="icon-chatbot-back"></span>
        <span class="title">@ChatBot.Atom</span>
        <span class="icon-chatbot-call"></span>
        <span class="icon-chatbot-down"></span>
    </div>
    <div class="chatbot-body -large" id="chatbotBody">
        <ul class="list-commands" id="listCommand">
            <li class="command">
                <div class="chatbot-reponse">
                    [@ResourceHelper.GetChatbotResource(nameof(ChatBot.yesterdayWinLoss), Model) - @DateTime.Now.AddDays(-1).ToString("yyyyMMdd")]<br />
                    <div>@ResourceHelper.GetResource(nameof(Resources.turnover), Model):</div>
                    <div class="p-l-13px">30,000.00</div>
                    <div>@ResourceHelper.GetChatbotResource(nameof(ChatBot.grossComm), Model):</div>
                    <div class="p-l-13px">50.00</div>
                    <div>@ResourceHelper.GetChatbotResource(nameof(ChatBot.memberWinLoss), Model):</div>
                    <div class="p-l-13px">5,000.00</div>
                </div>
                <div class="status-chatbot-reponse">
                    13:20
                </div>
            </li>
            <li class="command">
                <div class="chatbot-reponse">
                    [@ResourceHelper.GetResource(nameof(Resources.personalMessage), Model) - @DateTime.Now.ToString("yyyyMMdd")]<br />
                    @ResourceHelper.GetChatbotResource(nameof(ChatBot.personalMessageSample), Model)
                </div>
                <div class="status-chatbot-reponse">
                    13:21
                </div>
            </li>
            <li class="command">
                <div class="chatbot-reponse">
                    [@ResourceHelper.GetResource(nameof(Resources.specialAnnouncement), Model) - @DateTime.Now.ToString("yyyyMMdd")]<br />
                    @ResourceHelper.GetChatbotResource(nameof(ChatBot.specialAnnouncementSample), Model)
                </div>
                <div class="status-chatbot-reponse">
                    13:22
                </div>
            </li>
            <li class="command">
                <div class="chatbot-reponse">
                    [@ResourceHelper.GetResource(nameof(Resources.normalAnnouncement), Model) - @DateTime.Now.ToString("yyyyMMdd")]<br />
                    @ResourceHelper.GetChatbotResource(nameof(ChatBot.normalAnnouncementSample), Model)
                </div>
                <div class="status-chatbot-reponse">
                    13:23
                </div>
            </li>
            <li class="command">
                <div class="chatbot-reponse">
                    [@ResourceHelper.GetChatbotResource(nameof(ChatBot.systemAnnouncement), Model) - @DateTime.Now.ToString("yyyyMMdd")]<br />
                    @Html.Raw(@ResourceHelper.GetChatbotResource(nameof(ChatBot.systemAnnouncementSample), Model))
                </div>
                <div class="status-chatbot-reponse">
                    13:24
                </div>
            </li>
        </ul>
    </div>
    <div class="list-actions">
        <div class="btn-play hide" id="btnReplay">
            <span class="icon-play-button"></span> @ChatBot.play
        </div>
        <div class="btn-play disabled" id="btnPlaying">
            <span class="icon-pause-button"></span> @ChatBot.playing
        </div>
    </div>
</div>
@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/chatbot/chatbot-guide")
}