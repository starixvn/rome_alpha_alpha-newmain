@using System.Globalization
@model ChatBotSettingViewModel
@{
    Layout = "~/Views/ChatBot/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.AssetStyles.RenderCommon("/bundles/site-main/chatbot/chatbot-default")
    @StaticResources.RenderStyles("~/assets/bundles/chatbot/chatbot-setting")
}
<div class="page-title">
    <span class="pull-left">@Model.Title</span>
</div>
<div class="tab-content">
    <div class="panel">
        <div class="panel-heading" role="tab" id="headingAccount">
            <h4 class="panel-title">
                <a role="button" data-toggle="collapse" href="#account" aria-expanded="false" aria-controls="account">
                    @ChatBot.Account
                </a>
            </h4>
        </div>
        <div id="account" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingAccount">
            <div class="panel-body account-info">
                <div id="account-message" class="container-msg"></div>
                <form class="filter">
                    <div class="form-group">
                        <label>@ChatBot.YourLetstalkAccount: <span class="chatbot-name">@Model.Username</span></label>
                        <button class="btn-remove" id="btnUnsubscribe">@ChatBot.unLink</button>
                    </div>
                    <div class="form-group">
                        <label>@ChatBot.ChatBotLanguage:</label>
                        <div class="dropdown language">
                            @Html.Action("Language", new { langCode = Model.Language })
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="panel chatbot-setting">
        <div class="panel-heading" role="tab" id="headingReport">
            <h4 class="panel-title">
                <a role="button" data-toggle="collapse" href="#report" aria-expanded="false" aria-controls="report">
                    @ChatBot.FunctionReport
                </a>
            </h4>
        </div>
        <div id="report" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingReport">
            <div class="panel-body has-padding">
                <p>@ChatBot.pleaseSet <img class="toggle-img" src="~/Assets/Styles/chatbot/images/toogle.png" alt="Toggle Button" /> @ChatBot.IntroReport</p>
                <p><a href="#" class="link" id="openReportExample">@ChatBot.howFunctionWorks</a></p>
                <table class="tblRpt tblRpt-bordered tbl-guideline">
                    <thead>
                        <tr>
                            <th class="col-command">@ChatBot.Command</th>
                            <th>@ChatBot.FunctionReport</th>
                            <th class="col-status">@Alpha_sitemap.status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var function in Model.ReportFunctions)
                        {
                            <tr>
                                <td class="text-center"><span class="bage">@function.Command</span></td>
                                <td class="bold">@function.Name</td>
                                <td class="text-center">
                                    <label class="switch">
                                        <input data-functionId="@function.Id" data-functionName="@function.Name" data-command="@function.Command" type="checkbox"
                                               class="function" @(function.Enabled ? "checked" : string.Empty) />
                                        <span class="slider"></span>
                                    </label>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="panel chatbot-setting">
        <div class="panel-heading" role="tab" id="headingNotification">
            <h4 class="panel-title">
                <a role="button" data-toggle="collapse" data-parent="#accordion" href="#notification" aria-expanded="false" aria-controls="notification">
                    @ChatBot.FunctionNotification
                </a>
            </h4>
        </div>
        <div id="notification" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingNotification">
            <div class="panel-body has-padding">
                <p>@ChatBot.pleaseSet <img class="toggle-img" src="~/Assets/Styles/chatbot/images/toogle.png" alt="Toggle Button" /> @ChatBot.IntroNotification</p>
                <p><a href="#" class="link" id="openNotificationExample">@ChatBot.howFunctionWorks</a></p>
                <table class="tblRpt tblRpt-bordered tbl-guideline">
                    <thead>
                        <tr>
                            <th>@ChatBot.FunctionNotification</th>
                            <th class="col-status">@Alpha_sitemap.status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var function in Model.NotificationFunctions)
                        {
                            <tr>
                                <td class="bold">@function.Name</td>
                                <td class="text-center">
                                    <label class="switch">
                                        <input data-functionId="@function.Id" data-functionName="@function.Name" data-command="@function.Command" type="checkbox"
                                               class="function" @(function.Enabled ? "checked" : string.Empty) />
                                        <span class="slider"></span>
                                    </label>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@Html.Hidden("UserName", Model.Username)
@Html.Hidden("UnsubscribeWarning", ChatBot.UnsubscribeWarning)
@Html.Hidden("UpdateLanguageFailed", ChatBot.updateLanguageFailed)
@Html.Hidden("ReportExample", ChatBot.ResourceManager.GetString("reportExample", CultureInfo.GetCultureInfo(Model.Language)))
@Html.Hidden("NotificationExample", ChatBot.ResourceManager.GetString("notificationExample", CultureInfo.GetCultureInfo(Model.Language)))
@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/chatbot/chatbot-setting")
}