@model Alpha.Main.Site.ViewModels.ChatBot.ChatBotSettingViewModel
@{
    Layout = "~/Views/ChatBot/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-main/chatbot/chatbot-default")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/chatbot/chatbot-setting")
}
<div class="scroll-tabs" style="margin-bottom: 8px;">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation">
            @Html.ActionLink("Telegram", "Index", "TelegramChatBot")
        </li>
        <li role="presentation" class="active">
            <a href="#chatbot" aria-controls="home" role="tab" data-toggle="tab">Letstalk</a>
        </li>
    </ul>
</div>
<div class="tab-content">
    <div class="panel">
        <div class="panel-heading" role="tab" id="headingAccount">
            <h4 class="panel-title">
                <a role="button" data-toggle="collapse" href="#account" aria-expanded="false" aria-controls="account">
                    @ChatBot.Account
                </a>
            </h4>
        </div>
        <div id="account" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingAccount">
            <div class="panel-body account-info">
                <div id="account-message" class="container-msg"></div>
                <form class="filter">
                    <div class="form-group">
                        <label>@ChatBot.YourLetstalkAccount: <span class="chatbot-name">@Model.LetstalkId</span></label>
                        <button class="btn-remove" id="btnUnsubscribe">@ChatBot.unLink</button>
                    </div>
                    <div class="form-group only-text">
                        <label>@ChatBot.ChatbotName: <span class="chatbot-name">@ChatBot.Atom</span></label>
                    </div>
                    <div class="form-group">
                        <label>@ChatBot.ChatBotLanguage:</label>
                        <div class="dropdown language">
                            @Html.Action("Language", new { langCode = Model.Language })
                        </div>
                    </div>
                    <div class="form-group width-100per">
                        <label>@ChatBot.lblMessageSelfDestruct</label>
                        <select class="dropdown reload-time" id="period">
                            @foreach (var item in Model.SelfdestructionPeriodOptions)
                            {
                                <option value="@item.Value" @(item.Selected ? " selected=\"selected\"" : string.Empty)>@item.Text</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
        </div>
    </div>
    @{ Html.RenderPartial("LetstalkFunction", Model.ChatBotViewModel); }
</div>
@Html.Hidden("UnsubscribeWarning", ChatBot.UnsubscribeWarning)
@Html.Hidden("UpdateLanguageFailed", ChatBot.updateLanguageFailed)
@Html.Hidden("UpdateMessageSelfDestructMessageFailedMessage", ChatBot.UpdateMessageSelfDestructMessageFailedMessage)
@Html.Hidden("ReportExample", ChatBot.reportExample)
@Html.Hidden("NotificationExample", ChatBot.notificationExample)
@Html.Hidden("ActionExample", ChatBot.actionExample)
@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/chatbot/chatbot-setting")
}