@model ChatBotSettingViewModel
@{
    Layout = "~/Views/ChatBot/Shared/_Layout.cshtml";
    ViewBag.Title = Model.Title;
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/chatbot/chatbot-setting")
}
@Html.Hidden("UserId", Model.UserId)
@Html.Hidden("UserName", Model.Username)
<div class="panel">
    <div class="panel-heading" role="tab" id="headingAccount">
        <h4 class="panel-title">
            <a role="button" data-toggle="collapse" href="#account" aria-expanded="false" aria-controls="account">
                @ChatBot.Account
            </a>
        </h4>
    </div>
    <div id="account" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingAccount">
        <div class="panel-body has-padding">
            <form class="filter">
                <div class="form-group">
                    <label>@ChatBot.YourLetstalkAccount <strong>@Model.Username</strong></label>
                    <button class="btn-remove" id="btnUnsubscribe">@ChatBot.Unsubscribe</button>
                </div>
                <div class="form-group">
                    <label>Chat Bot's Language:</label>
                    <div class="dropdown language">
                        @Html.Action("Language", new { langCode = Model.Language })
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="panel">
    <div class="panel-heading" role="tab" id="headingReport">
        <h4 class="panel-title">
            <a role="button" data-toggle="collapse" href="#report" aria-expanded="false" aria-controls="report">
                @ChatBot.FunctionType_1
            </a>
        </h4>
    </div>
    <div id="report" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingReport">
        <div class="panel-body has-padding">
            <ul class="list-guideline">
                @foreach (var function in Model.ReportFunctions)
                {
                    <li class="guideline">
                        <label>
                            <input data-functionId="@function.Id" data-command="@function.Command" class="function" type="checkbox"
                                   @(function.Enabled ? "checked" : string.Empty) name="reports" /> @($"{function.Name}: User input commands")
                            </label>
                            <span class="bage">@function.Command</span>
                        </li>
                }
            </ul>
            <p class="bold">Simple input the command into Letstalk and it will return you the report.</p>
            <div class="chatbot-layout">
                <div class="chatbot-header">
                    <span class="icon-chatbot-back"></span>
                    <span class="title">Chatbot</span>
                    <span class="icon-chatbot-call"></span>
                    <span class="icon-chatbot-down"></span>
                </div>
                <div class="chatbot-body" id="reportBody">
                    <ul class="list-commands" id="reportCommands">
                        <li class="command">
                            <div class="user-input">os</div>
                            <div class="status-user-input">
                                Read <br />
                                12:33
                            </div>
                        </li>
                        <li class="command">
                            <div class="chatbot-reponse">
                                Outstanding <br />
                                Total Member <br />
                                1,000.00 <br />
                                Total Agent <br />
                                50.00
                            </div>
                            <div class="status-chatbot-reponse">
                                12:36
                            </div>
                        </li>
                        <li class="command">
                            <div class="user-input">wl</div>
                            <div class="status-user-input">
                                Read <br />
                                12:33
                            </div>
                        </li>
                        <li class="command">
                            <div class="chatbot-reponse">
                                Today Win Loss <br />
                                Turnover <br />
                                30,000.00 <br />
                                Gross Comm <br />
                                50.00 <br />
                                Member Win Loss <br />
                                5000.00 <br />
                            </div>
                            <div class="status-chatbot-reponse">
                                12:36
                            </div>
                        </li>
                        <li class="command">
                            <div class="user-input">bal</div>
                            <div class="status-user-input">
                                Read <br />
                                12:33
                            </div>
                        </li>
                        <li class="command">
                            <div class="chatbot-reponse">
                                Balance Info <br />
                                Currency <br />
                                UUS <br />
                                Cash Balance <br />
                                1,500,000.00 <br />
                                Yesterday Cash Balance <br />
                                1,500,000.00 <br />
                            </div>
                            <div class="status-chatbot-reponse">
                                12:36
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="chatbot-footer">
                    <span class="icon-chatbot-plus"></span>
                    <span class="icon-chatbot-gif"></span>
                    <input type="text" id="reportText" class="chatbot-text" placeholder="Input command" disabled />
                    <span class="icon-chatbot-voice"></span>
                </div>
                <div class="button-refresh" id="reportRefresh">
                    <span class="icon-refresh"></span>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="panel">
    <div class="panel-heading" role="tab" id="headingNotification">
        <h4 class="panel-title">
            <a role="button" data-toggle="collapse" data-parent="#accordion" href="#notification" aria-expanded="false" aria-controls="notification" class="collapsed">
                @ChatBot.FunctionType_2
            </a>
        </h4>
    </div>
    <div id="notification" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingNotification">
        <div class="panel-body has-padding">
            <ul class="list-guideline">
                @foreach (var function in Model.NotificationFunctions)
                {
                    <li class="guideline">
                        <label>
                            <input data-functionId="@function.Id" data-command="@function.Command" type="checkbox" class="function" name="notification"
                                   @(function.Enabled ? "checked" : string.Empty) /> @function.Name
                            </label>
                        </li>
                }
            </ul>
            <p class="bold">Chatbot will automatically notify you new events in the system.</p>
            <div class="chatbot-layout -notification">
                <div class="chatbot-header">
                    <span class="icon-chatbot-back"></span>
                    <span class="title">Chatbot</span>
                    <span class="icon-chatbot-call"></span>
                    <span class="icon-chatbot-down"></span>
                </div>
                <div class="chatbot-body" id="notificationBody">
                    <ul class="list-commands" id="notificationCommands">
                        <li class="command">
                            <div class="chatbot-reponse">
                                Yesterday Win Loss <br />
                                Turnover <br />
                                30,000.00 <br />
                                Gross Comm <br />
                                50.00 <br />
                                Member Win Loss <br />
                                5000.00 <br />
                                ...
                            </div>
                            <div class="status-chatbot-reponse">
                                13:20
                            </div>
                        </li>
                        <li class="command">
                            <div class="chatbot-reponse">
                                Personal message <br />
                                Your minimum position taking <br />
                                has been changed by the upline <br />
                                Plase kindly be informed and <br />
                                have a check the details for your <br />
                                downlines.
                            </div>
                            <div class="status-chatbot-reponse">
                                13:20
                            </div>
                        </li>
                        <li class="command">
                            <div class="chatbot-reponse">
                                Special Announcement <br />
                                Dear Valued Customer: <br />
                                Effective 18th Jan 2018 <br />
                                Company will restrict access <br />
                                our Agent Site from "Hong Kong". <br />
                                Thank you for your kind attention! <br />
                            </div>
                            <div class="status-chatbot-reponse">
                                13:20
                            </div>
                        </li>
                        <li class="command">
                            <div class="chatbot-reponse">
                                Normal Announcement <br />
                                Attn:[E-Sports] <br />
                                a match has been cancelled, <br />
                                all bets taken are considered REFUNDED. <br />
                                Thank you!
                            </div>
                            <div class="status-chatbot-reponse">
                                13:20
                            </div>
                        </li>
                        <li class="command">
                            <div class="chatbot-reponse">
                                Systen Update <br />
                                Dear valued agents, <br />
                                We are pleased to inform that <br />
                                there are new games <br />
                                added under Macau Games. <br />
                                You may review the Bet Limit settings <br />
                                affected from 10/05/2018. <br />
                                Thank you!
                            </div>
                            <div class="status-chatbot-reponse">
                                13:20
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="button-refresh" id="notificationRefresh">
                    <span class="icon-refresh"></span>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    @StaticResources.RenderScripts("~/assets/bundles/chatbot/chatbot-setting")
}