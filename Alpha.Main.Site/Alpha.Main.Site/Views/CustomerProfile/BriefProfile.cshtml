@model BriefProfileViewModel
@{
    Layout = null;
    var changeNickNameUrl = $"{Model.OldMainRootApp}LoginOption?custId={Model.CustId}";
    var viewProfileUrl = $"{Model.OldMainRootApp}ProfilePicture?custId={Model.CustId}";
    var mainFrameName = "main";
}
<div id="profile-content" 
     data-introduce-nick-name-tooltip-cookie-name="@(Model.IntroduceNickNameTooltipCookieName)"
     data-is-default-avatar="@(Model.IsDefaultAvatar.ToString().ToLower())"
     data-nick-name="@(Model.NickName)">

    <a href="@(viewProfileUrl)" target="@mainFrameName" class="profile-avatar">
        <img id="logoProfileImg" width="50" height="50" src='@(Model.IsDefaultAvatar ? Url.Content("~/assets/images/icon_user_default.png") : Model.EmbedImage)' alt="" title="@Resources.ProfileClickTootip" />
    </a>

    <div class="userinfo">
        <span class="userName">@Model.Username</span>
        <br />

        @if (Model.LoginUserIsNotMainAccount)
        {
            <div class="adminAndSubAcc" title="@(Model.NickName)">@Model.NickName</div>
        }
        else
        {
            if (!string.IsNullOrEmpty(Model.NickName))
            {
                <div class="nickname-box">
                    <a href="@changeNickNameUrl" class="linkNickName" id="linkNickNameID" target="@mainFrameName">
                        <span id="labelNickname">@Model.NickName</span>
                    </a>
                </div>
            }
            else
            {
                <div class="nickname-box">
                    <span id="spanNickNameID">@Resources.nickname: </span>
                    <a href="@changeNickNameUrl" class="linkConfigNow" id="linkNickNameID" target="@mainFrameName">
                        <span id="labelNickname">@Resources.configNow</span>
                    </a>
                </div>
            }
        }
        <a class="otp" href="@(MicroSites.MainUrl("~/otp/index"))" target="@mainFrameName">OTP: @(Model.IsEnableOtp ? Resources.Enabled : Resources.Disabled)</a>
    </div>
</div>

@if (!Model.LoginUserIsNotMainAccount)
{
    if (string.IsNullOrEmpty(Model.NickName))
    {
        <div id="tooltip-box" style="display:none;">
            <div>
                @Html.Raw(Resources.introNickname)
            </div>
        </div>
    }

    <div id="profileTooltip" style="display:none;">
        @Html.Raw(@Resources.ProfileLoginTip)
        <a class="change-picture-link" href="@(viewProfileUrl)" target="main" id="changePictureLink">
            @Resources.clickHere
        </a>
        &nbsp;@Resources.uploadNow
    </div>
}