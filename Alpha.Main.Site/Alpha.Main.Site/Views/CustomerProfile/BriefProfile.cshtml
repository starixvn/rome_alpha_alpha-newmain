@model BriefProfileViewModel
@{
    Layout = null;
}
<div id="profile-content">

    <a href="@Model.ViewProfileUrl" target="@Model.MainFrameName" class="profile-avatar">
        <img id="logoProfileImg" src='@(Model.IsDefaultAvatar ? Url.Content("~/Content/Images/icon_user_default.png") : Model.EmbedImage)' alt="" title="@Resources.ProfileClickTootip" />
    </a>

    <div class="userinfo">
        <span class="userName">@Model.Username</span>
        <br />

        @if (Model.IsNotMainAccount)
        {
            <div class="adminAndSubAcc">@Html.Raw(Model.NickName)</div>
        }
        else
        {
            if (!string.IsNullOrEmpty(Model.NickName))
            {
                <div class="nickname-box">
                    <a href="@Model.ChangeNickNameUrl" class="linkNickName" id="linkNickNameID" target="@Model.MainFrameName">
                        <span id="labelNickname">@Model.NickName</span>
                    </a>
                </div>
            }
            else
            {
                <div class="nickname-box">
                    <span id="spanNickNameID">@Resources.nickname: </span>
                    <a href="@Model.ChangeNickNameUrl" class="linkConfigNow" id="linkNickNameID" target="@Model.MainFrameName">
                        <span id="labelNickname">@Resources.configNow</span>
                    </a>
                </div>

                if (Model.IsShowIntroduceNickName)
                {
                    <div id="tooltip-box">
                        <div class="left">
                        </div>
                        <div class="bg">
                            <div class="normal">
                                <div class="introNickname">
                                    @Html.Raw(Resources.introNickname)
                                </div>
                            </div>
                        </div>
                        <div class="right">
                        </div>
                    </div>
                }
            }

            if (Model.IsShowEditProfilePictureTooltip)
            {
                <div id="profileTooltip">
                    <div class="left">
                    </div>
                    <div class="bg">
                        <div class="normal">
                            <div class="tooltip-content">
                                @Html.Raw(@Resources.ProfileLoginTip)<a class="change-picture-link" href="@Model.ViewProfileUrl" target="main" id="changePictureLink">@Resources.clickHere</a>&nbsp;@Resources.uploadNow
                            </div>
                        </div>
                    </div>
                    <div class="right">
                    </div>
                </div>
            }
        }
    </div>
</div>