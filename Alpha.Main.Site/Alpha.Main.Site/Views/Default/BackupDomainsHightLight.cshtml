<div class="cover-backupdomain backup-domains-box hide">
    <div class="backupdomain-modal">
        <button type="button" class="icon icon-close close" title="@Resources.close"><span aria-hidden="true"></span></button>
        <div class="text">
            <img src="~/Assets/Images/backupdomain.svg" alt="backup domain" />
            <p><span>@Alpha_sitemap.BackupDomains</span>@Resources.BackupDomains_Intro</p>
        </div>
        <div class="action">
            <label class="label">
                <input id="btn-hide-backup-domains-popup" type="checkbox" name="name" value="" />
                <span>@Resources.doNotShowAgain</span>
            </label>
            <input id="btn-backup-domains" type="submit" class="btn-submit" value="@Resources.CheckOut">
        </div>
    </div>
</div>