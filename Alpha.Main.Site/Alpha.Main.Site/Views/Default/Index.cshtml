@{ 
    Layout = null;
}
@model IndexViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.Render($"/bundles/site-main/{Model.UserLevel}")
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/default-index"))" rel="stylesheet" type="text/css" />
    <!--[if (gt IE 8)|!(IE)]><!--><link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/default-introduction"))" rel="stylesheet" type="text/css" /><!--<![endif]-->
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
      <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
      <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->

</head>
<body>
    <div id="page-popup" class="modal fade hidden" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog ex-modal" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="@Resources.close"><span aria-hidden="true"></span></button>
                    <h4 class="modal-title" id="result-detail-title"><span class="popup-title" id="popup-title"></span></h4>
                </div>
                <div class="modal-body">
                    <iframe frameborder="0" allowtransparency="yes" marginheight="0" marginwidth="0" scrolling="auto"
                            id="popup-iframe"></iframe>
                </div>
            </div>
        </div>
    </div>
    @Html.Partial("Introduction")

    @Html.Action("HeaderHotMsg")
    <aside class="sidebar" id="side-bar">
        <div class="partial-content customer-profile" id="profile" data-url="@Url.Action("BriefProfile", "CustomerProfile")"></div>
        <nav class="navigation" id="navigation">
            @Html.Action("MenuBar")
        </nav>
    </aside>
    <div class="content-wrapper" id="content-wrapper">
        <!-- Top search bar -->
        <div class="top-search-bar">
            <span class="icon-search"></span>
            <input type="text" class="top-search-input" placeholder="Search">
            <span class="icon-close"></span>
        </div>
        <!-- Annoucement popup -->
        <div class="modal fade announcement-modal visible-mobile" id="announcement-popup">
            <div class="modal-dialog ex-modal">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="@Resources.close"><span aria-hidden="true"></span></button>
                        <h4 class="modal-title" id="result-detailt-title"><span class="icon icon-announcements"></span>@Resources.announcement!</h4>
                    </div>
                    <div class="modal-body" id="announcementModalBody">
                        <p><strong>Dear valued agents,</strong></p>
                        <p>We are pleased to announce the launching of the new product named "<strong>Colossus Bets</strong>" with effected from <strong>24/02/2016</strong></p>
                        <p>This new product will be offered by default. If you wish to disable "<strong>Colossus Bets</strong>" on a specific downline, please configure at the Setting function. Follow this instruction for more details.</p>
                        <p>All settings will be available for configuration since <strong>28/01/2016</strong>.</p>
                        <p><strong>Thank you.</strong></p>
                    </div>
                </div>
            </div>
        </div>
        <header class="header" id="header">
            @Html.Partial(
           "HeaderNav",
           new HeaderNavViewModel
           {
               CustId = Model.CustId,
               EnableSecurityCode = Model.EnableSecurityCode
           })

            @Html.Partial("HeaderMarquee")
        </header>
        <main class="content" id="content" data-default-url="@Model.DefaultUrl">
        </main>
    </div>

    @Html.Hidden("oldMainRootPath", Model.OldMainRootPath)
    @Html.Hidden("onUserId", Model.OnUserId)
    @Html.Hidden("mainRootPath", Model.MainRootPath)
    @Html.Hidden("passwordHash", Model.PasswordHash)
    @Html.Hidden("howToUseRootPath", Model.HowToUseRootPath)
    @Html.Hidden("subPageAccess", Model.SubPageAccess)
    @Html.Hidden("isInternalWebVPN", Model.IsInternalWebVPN)
    @Html.Hidden("currentURLCookieName", Model.CurrentURLCookieName)
    @Html.Hidden("userLevel", Model.UserLevel)
    @Html.Hidden("isSubAccount", Model.IsSubAccount)

    @StaticResources.AssetScripts.Render("/bundles/site-main/default")
    <script src="@(StaticResources.MainSiteScriptUrl("~/assets/bundles/default-index"))" type="text/javascript"></script>

    <!--[if (gt IE 8)|!(IE)]><!--><script src="@(StaticResources.MainSiteScriptUrl("~/assets/bundles/default-introduction"))" type="text/javascript"></script><!--<![endif]-->

    @Html.Partial("Piwik")


</body>
</html>