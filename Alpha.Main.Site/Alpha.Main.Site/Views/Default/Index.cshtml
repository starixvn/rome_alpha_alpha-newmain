    <!-- END LivePerson Monitor. -->
    <script type="text/javascript">
        var engagementId;
        function _onEvent(data, eventInfo) {
            engagementId = data.engagementId;
            $("div[id^='LPMcontainer-']").first().remove();      
        }

        if (window.lpTag) {
            lpTag.events.bind({
                eventName: "OFFER_DISPLAY",
                func: _onEvent,
                triggerOnce: false //default is false
            });
        }

        function onLiveChatClick() {
            if (window["lpTag"] && window["lpTag"].taglets && window["lpTag"].taglets.rendererStub && window.engagementId) {               
                window["lpTag"].taglets.rendererStub.click(window.engagementId);
            }
        }
    </script>
</head>
<body>
    @Html.Partial("Popup")
    @Html.Action("HeaderHotMsg")
    <aside class="sidebar" id="side-bar">
        <div class="partial-content customer-profile" id="profile" data-url="@Url.Action("BriefProfile", "CustomerProfile")"></div>
        <nav class="navigation" id="navigation">
            @Html.Action("MenuBar")
        </nav>
    </aside>
    <div class="content-wrapper" id="content-wrapper">
        @Html.Partial("SearchBar")
        <header class="header" id="header">
            @Html.Partial("HeaderNav", Model.HeaderNavViewModel)
            @Html.Partial("HeaderMarquee")
        </header>
        <main class="content" id="content" data-default-url="@Model.DefaultPath">
        </main>
        <div class="float-section">
            <div class="progress-box hide" id="progress-box" data-toggle="modal">
                <span class="icon-progress"></span>
                <span class="txt-progress">@Resources.DataProcessingIsInProgress</span>
            </div>
        </div>
    </div>
    @Html.Partial("HiddenFields", Model)
    @Html.Partial("AnnouncementPopup")
    @Html.Partial("DataProccessingPopup")
    @Html.Partial("UMMessagePopup")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/default")
    @StaticResources.RenderScripts("~/assets/bundles/default-index")
    @GoogleAnalyticHepler.Render()
</body>
</html>
