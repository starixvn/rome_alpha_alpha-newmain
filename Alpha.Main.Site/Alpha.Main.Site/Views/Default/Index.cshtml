@model IndexViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=@Model.InitialScaleViewPort, user-scalable=yes">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render($"/bundles/site-main/{Model.UserLevel}")
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/default-index"))" rel="stylesheet" type="text/css" />
    <!--[if (gt IE 8)|!(IE)]><!-->
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/default-instruction"))" rel="stylesheet" type="text/css" /><!--<![endif]-->
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
      @StaticResources.AssetScripts.RenderCommon("/bundles/common/support-IE8")
    <![endif]-->
</head>
<body>
    @Html.Partial("Popup")
    @Html.Partial("Instruction")
    @Html.Action("HeaderHotMsg")
    <aside class="sidebar" id="side-bar">
        <div class="partial-content customer-profile" id="profile" data-url="@Url.Action("BriefProfile", "CustomerProfile")"></div>
        <nav class="navigation" id="navigation">
            @Html.Action("MenuBar")
        </nav>
    </aside>
    <div class="content-wrapper" id="content-wrapper">
        @Html.Partial("SearchBar")
        <header class="header" id="header">
            @Html.Partial("HeaderNav", Model.HeaderNavViewModel)
            @Html.Partial("HeaderMarquee")
        </header>
        <main class="content" id="content" data-default-url="@Model.DefaultUrl">
        </main>
    </div>
    @Html.Partial("HiddenFields", Model)

    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/default")
    <script src="@(StaticResources.MainSiteScriptUrl("~/assets/bundles/default-index"))" type="text/javascript"></script>
    <!--[if (gt IE 8)|!(IE)]><!-->
    <script src="@(StaticResources.MainSiteScriptUrl("~/assets/bundles/default-instruction"))" type="text/javascript"></script>
    <!--<![endif]-->
    @Html.Partial("GoogleAnalytic")
</body>
</html>