@model IndexViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <title></title>
    @ContentSite.Styles.Render("/bundle/styles/main/default")  
    @ContentSite.Styles.Render("/fonts/iconalpha/style.min.css")
    @Styles.Render("~/bundle/styles/default")
    @Styles.Render($"~/assets/styles/home/{Model.UserLevel}.css")
</head>
<body>
    <aside class="sidebar">
        <div class="partial-content customer-profile" id="profile" data-url="@Url.Action("BriefProfile", "CustomerProfile")"></div>
        <nav class="partial-content navigation" id="navigation" data-url="@Url.Action("MenuBar")">
        </nav>
    </aside>
    <div class="content-wrapper">
        <header class="header">
            @Html.Partial("HeaderNav", new HeaderNavViewModel { CustId = Model.CustId })
            @Html.Action("HeaderMsg")
        </header>
        <main class="content" id="content">
            <iframe frameborder="0" id="main" data-default-url="@Model.DefaultUrl" width="100%" height="100%" scrolling="auto" name="main" marginwidth="0" marginheight="0" allowtransparency="true" class="iframe-content"></iframe>
        </main>
    </div>
    @Html.Hidden("oldMainRootPath", Model.OldMainRootPath)
    @Html.Hidden("onUserId", Model.OnUserId)
    @Html.Hidden("mainRootPath", Model.MainRootPath)
    @Html.Hidden("passwordHash", Model.PasswordHash)
    @ContentSite.Scripts.Render("/bundles/scripts/main/default")
    @Scripts.Render("~/bundles/scripts/default")
</body>
</html>