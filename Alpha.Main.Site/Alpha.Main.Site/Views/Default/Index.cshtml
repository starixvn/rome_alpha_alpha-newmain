@model IndexViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.Render($"/bundles/site-main/{Model.UserLevel}")
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/default-index"))" rel="stylesheet" type="text/css" />
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/default-introduction"))" rel="stylesheet" type="text/css" />
</head>
<body>

    <div id="page-popup" class="modal fade hidden" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog ex-modal" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="@Resources.close"><span aria-hidden="true"></span></button>
                    <h4 class="modal-title" id="result-detail-title"><span class="popup-title"></span></h4>
                </div>
                <div class="modal-body">
                    <iframe frameborder="0" allowtransparency="yes" marginheight="0" marginwidth="0" scrolling="auto"
                            id="popup-iframe"></iframe>
                </div>
            </div>
        </div>
    </div>
    @Html.Partial("Introduction")

    @Html.Action("HeaderHotMsg")
    <aside class="sidebar" id="side-bar">
        <div class="partial-content customer-profile" id="profile" data-url="@Url.Action("BriefProfile", "CustomerProfile")"></div>
        <nav class="navigation" id="navigation">
            @Html.Action("MenuBar")
        </nav>
    </aside>
    <div class="content-wrapper" id="content-wrapper">
        <header class="header" id="header">
            @Html.Partial(
           "HeaderNav",
           new HeaderNavViewModel
           {
               CustId = Model.CustId,
               EnableSecurityCode = Model.EnableSecurityCode
           })

            @Html.Partial("HeaderMarquee")
        </header>
        <main class="content" id="content" data-default-url="@Model.DefaultUrl">
        </main>
    </div>

    @Html.Hidden("oldMainRootPath", Model.OldMainRootPath)
    @Html.Hidden("onUserId", Model.OnUserId)
    @Html.Hidden("mainRootPath", Model.MainRootPath)
    @Html.Hidden("passwordHash", Model.PasswordHash)
    @Html.Hidden("howToUseRootPath", Model.HowToUseRootPath)
    @Html.Hidden("subPageAccess", Model.SubPageAccess)
    @Html.Hidden("isInternalWebVPN", Model.IsInternalWebVPN)
    @Html.Hidden("currentURLCookieName", Model.CurrentURLCookieName)
    @Html.Hidden("isShowIntroduction", Model.IsShowIntroduction)
    @Html.Hidden("userLevel", Model.UserLevel)
    @Html.Hidden("isSubAccount", Model.IsSubAccount)

    @Html.Partial("Piwik", Model)

    @StaticResources.AssetScripts.Render("/bundles/site-main/default")
    <script src="@(StaticResources.MainSiteScriptUrl("~/assets/bundles/default-index"))" type="text/javascript"></script>

    <script src="@(StaticResources.MainSiteScriptUrl("~/assets/bundles/default-introduction"))" type="text/javascript"></script>
</body>
</html>