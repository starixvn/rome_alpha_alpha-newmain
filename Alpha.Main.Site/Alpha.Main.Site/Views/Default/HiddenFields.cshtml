@model IndexViewModel
@Html.Hidden("oldMainRootPath", Model.OldMainRootPath)
@Html.Hidden("onUserId", Model.OnUserId)
@Html.Hidden("mainRootPath", Model.MainRootPath)
@Html.Hidden("passwordHash", Model.PasswordHash)
@Html.Hidden("howToUseRootPath", Model.HowToUseRootPath)
@Html.Hidden("memberInfoRootPath", Model.MemberInfoRootPath)
@Html.Hidden("accountInfoRootPath", Model.AccountInfoRootPath)
@Html.Hidden("subPageAccess", Model.SubPageAccess)
@Html.Hidden("isInternalWebVPN", Model.IsInternalWebVPN)
@Html.Hidden("currentURLCookieName", Model.CurrentURLCookieName)
@Html.Hidden("isShowIntroduction", Model.IsShowIntroduction)
@Html.Hidden("userLevel", Model.UserLevel)
@Html.Hidden("isSubAccount", Model.IsSubAccount)
@Html.Hidden("subUserId", Model.SubAccId)
@Html.Hidden("userId", Model.CustId)
@Html.Hidden("isEnabledOtp", Model.IsEnabledOtp)
@Html.Hidden("messageRootPath", Model.MessageSiteRootPath)
@Html.Hidden("exTotalBetsForecastRootPath", Model.ExTotalBetsForecastRootPath)
@Html.Hidden("isInternal", (Model.IsInternal ? 1 : 0))
@Html.Hidden("requiredNetworkSpeedCalculation", (Model.RequiredNetworkSpeedCalculation ? 1 : 0))
@Html.Hidden("disableMessages", (Model.DisableMessages || Model.IsProtectedMode ? 1 : 0))
@Html.Hidden("showOldCustomerList", (Model.ShowOldCustomerList ? 1 : 0))
@Html.Hidden("UMAnnouncementPopupClientIntervalInMinutes", Model.UMAnnouncementPopupClientIntervalInMinutes)
@Html.Hidden("reportDomain", Model.ReportDomain)
@Html.Hidden("isDarkMode", Model.IsDarkMode.ToString().ToLowerInvariant())
@Html.Hidden("RecheckinIntervalMiliseconds", Model.RecheckinIntervalMiliseconds)
@Html.Hidden("SessionId", Model.SessionID)
@if (Model.IsOfferLiveChat)
{
    @Html.Hidden("UsernameShowOnLiveChat", Model.Username)
}
@if (Model.IsEnabledCDNReCheckin)
{
    @Html.Hidden("assetAppPath", Model.AssetAppPath)
    @Html.Hidden("CDNReCheckinIntervalInSeconds", Model.CDNReCheckinIntervalInSeconds)
}
@Html.Hidden("betlistDomain", Model.BetlistDomain)