@model BrowserViewModel
@{
    Layout = null;
    var downloadNewBrowserUrl = "http://windows.microsoft.com/en-us/internet-explorer/download-ie";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    @StaticResources.AssetStyles.Render($"/bundles/site-main/pageIElower10")
    <link href="@(StaticResources.MainSiteStyleUrl("~/Assets/styles/home/pageIElower10"))" rel="stylesheet" type="text/css" />
    <title>Browser Warning</title>
</head>
<body>
    <div id="warning-browser-message" class="warning-browser-message">
        <span class="icon-alert"></span>
        <div class="content-msg">
            <span>@Resources.BrowserIsOutOfDate</span>
            <a href="@Model.DownloadNewBrowserUrl" target="_blank">@Resources.ClickToUpdateBrowser</a> |
            <a href="@Alpha.Main.Helpers.MicroSites.OldMainUrl("~/")">@Resources.OldView</a>
        </div>
    </div>

</body>
</html>
