@model BrowserViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    @StaticResources.AssetStyles.Render($"/bundles/site-main/unsupport-browser/{Model.UserLevel}")
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/styles/home/pageIElower10"))" rel="stylesheet" type="text/css" />
    <title>@Resources.BrowserIsOutOfDate</title>
</head>
<body class="unsupport-browser">
    <div id="warning-browser-message" class="warning-browser-message">
        <a href="~/" class="icon-close"></a>
        <p class="title"><span class="icon-alert"></span>@Resources.TitleUnsupportBrowser</p>
        <div class="content-msg">
            <span>@Resources.BrowserIsOutOfDate</span><a href="@Model.DownloadNewBrowserUrl" target="_blank"> @(Resources.ClickToUpdateBrowser).</a>
        </div>
    </div>

</body>
</html>
