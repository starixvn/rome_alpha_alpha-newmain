@model HeaderNavViewModel
<section class="navbar header-nav" id="header-nav">
    <span class="icon-collapse icon-hamburger withripple"></span>
    <ul class="nav navbar-nav list-top">
        <li>
            <span class="icon icon-time"></span>
            <span class="txt-top" id="clock"
                  data-year="@DateTime.Now.Year"
                  data-month="@DateTime.Now.Month"
                  data-day="@DateTime.Now.Day"
                  data-hour="@DateTime.Now.Hour"
                  data-minute="@DateTime.Now.Minute"
                  data-second="@DateTime.Now.Second"
                  data-label-am="@Resources.AM"
                  data-label-pm="@Resources.PM"
                  data-label-months="@("['" + Resources.monthName1 + "','" + Resources.monthName2 + "','" + Resources.monthName3 + "','" +
                                           Resources.monthName4 + "','" + Resources.monthName5 + "','" + Resources.monthName6 + "','" +
                                           Resources.monthName7 + "','" + Resources.monthName8 + "','" + Resources.monthName9 + "','" +
                                           Resources.monthName10 + "','" + Resources.monthName11 + "','" + Resources.monthName12 + "']")"></span>
        </li>
        <li class="dropdown">
            @Html.Action("List", "Language")
        </li>
        <li class="withripple"><span class="icon icon-swap-horizontal" title="@Resources.OldView"></span><span class="txt-top old-view-text">@Resources.OldView</span></li>
        <li class="dropdown">
            <a href="javascript:;" data-target="#" class="dropdown-toggle withripple" data-toggle="dropdown">
                <span class="icon icon-squares top-right-menu"></span>
            </a>

            <ul class="dropdown-menu list-setting">
                <li><a href="@($"{Model.HowToUseRootPath}Index.aspx")" target="m target="main"><span class="icon icon-help"></span>@Resources.Help</a></li>
                <li><a href="@($"{Model.OldMainRootPath}Company/ContactUs/Index")" target="main"><span class="icon icon-contactus"></span>@Resources.ContactUs</a></li>
                <li><a href="@($"{Model.OldMainRootPath}ContextualCustomer/ProfilePicture?custId={Model.CustId}")" target="main"><span class="icon icon-profilepic"></span>@Resources.EditProfilePicture</a></li>
                <li><a href="@($"{Model.OldMainRootPath}Security/SecurityCode/ChangeSecurityCode")" target="main"><span class="icon icon-lock"></span>@Resources.password</a></li>
                <li><a href="@($"{Model.OldMainRootPath}_MemberInfo/ChangePassword/ChangePassword.aspx")" target="main"><span class="icon icon-sercuritycode"></span>@Resources.SecurityCode</a></li>
            </ul>
        </li>
        <li class="withripple"><span class="icon icon-logout"></span></li>
    </ul>
</section>