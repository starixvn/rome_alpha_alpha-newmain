@model string
<div class="popup-highlight hide" id="boxHighlightPopupNewFeature">
    <button type="button" class="icon icon-close close" title="@Resources.close"><span aria-hidden="true"></span></button>
    <div class="text">
        <img src="~/Assets/Images/createmultipleaccounts@(Model).svg?v=@AppSettings.JsVersion" alt="change display language">
        <div>
            <p><span>@Resources.HighlightPopupNewFeatureTitle</span></p>
            <p>@Html.Raw(Resources.HighlightPopupNewFeatureIntro)</p>
            <p>@string.Format(Resources.HighlightPopupNewFeatureIntro2, AppSettings.CreateNewAccountBannerEndDate)</p>
        </div>
    </div>
    <div class="action">
        <label class="label">
            <input id="chkHideHighlightPopupNewFeature" type="checkbox" />
            <span>@Resources.doNotShowAgain</span>
        </label>
        <a class="btn-submit" id="linkHighlightPopupCheckOut" href="@MicroSites.OldMainUrl("_MemberInfo/SearchAndCopy/MasterPage.aspx?isNew=true")" target="main">@Resources.GetStarted</a>
    </div>
</div>
