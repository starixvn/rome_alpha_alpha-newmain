@model IndexViewModel
@if (Model.HightLightFeaturePermission)
{
    <div class="popup-highlight highlight-top hide" id="boxHighlightPopupNewFeature">
        <button type="button" class="icon icon-close close" title="@Resources.close">
            <span aria-hidden="true"></span>
        </button>
        <div class="text">
            <img src="~/Assets/Images/@(Model.HightLightFeatureImageName).svg?v=@AppSettings.JsVersion" alt="@Resources.HighlightPopupNewFeatureTitle">
            <div>
                <p><span>@Html.Raw(Resources.HighlightPopupNewFeatureTitle)</span></p>
                @Html.Raw(Resources.HighlightPopupNewFeatureIntro)
                    <br />
                    @Html.Raw(Resources.HighlightPopupNewFeatureIntro2)
            </div>
        </div>
        <div class="action">
            <label class="label">
                <input id="chkHideHighlightPopupNewFeature" type="checkbox" />
                <span>@Resources.doNotShowAgain</span>
            </label>
            <a class="btn-submit" id="linkHighlightPopupCheckOut" href="@Model.HightLightFeatureUrl" target="main">@Resources.GetStarted</a>
        </div>
    </div>
}
