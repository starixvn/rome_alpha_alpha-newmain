@model IndexViewModel
<div class="popup-highlight hide" id="boxHighlightPopupNewFeature">
    <button type="button" class="icon icon-close close" title="@Resources.close"><span aria-hidden="true"></span></button>
    <div class="text">
        <img src="~/Assets/Images/abnormal-login-alert@(Model.DarkModeName).svg?v=@AppSettings.JsVersion" alt="Abnormal Login Alert">
        <div>
            <p><span>@Html.Raw(Resources.HighlightPopupNewFeatureTitle)</span></p>
            <p>@Html.Raw(Resources.HighlightPopupNewFeatureIntro)</p>
            <p>@Html.Raw(Resources.HighlightPopupNewFeatureIntro2)</p>
        </div>
    </div>
    <div class="action">
        <label class="label">
            <input id="chkHideHighlightPopupNewFeature" type="checkbox" />
            <span>@Resources.doNotShowAgain</span>
        </label>
        <a class="btn-submit" id="linkHighlightPopupCheckOut" href="@Model.HightLightFeatureUrl" target="main">@Resources.GetStarted</a>
    </div>
</div>