@model IndexViewModel
@if (Model.HightLightFeaturePermission)
{
    <div class="popup-highlight hide" id="boxHighlightPopupNewFeature">
        <button type="button" class="icon icon-close close" title="@Resources.close">
            <span aria-hidden="true"></span>
        </button>
        <div class="text">
            <img src="~/Assets/Images/@(Model.HightLightFeatureImageName).svg?v=@AppSettings.JsVersion" alt="@Resources.HighlightPopupNewFeatureTitle">
            <div>
                <p>
                    <span>@Html.Raw(Resources.HighlightPopupNewFeatureTitle)</span>
                </p>
                <p>
                    @Html.Raw(Resources.HighlightPopupNewFeatureIntro)
                </p>
            </div>
        </div>
        <div class="action">
            <label class="label">
                <input id="chkHideHighlightPopupNewFeature" type="checkbox" />
                <span>@Resources.doNotShowAgain</span>
            </label>

            @if (!Model.IsLinkedChatbot)
            {
                <a class="btn-submit btn-chatbot" id="linkHighlightPopupCheckOut" href="@Model.HightLightFeatureUrl" target="main">@Resources.SetupChatbot</a>
            }

            <a class="btn-submit" id="linkHighlightPopupTour" href="@Model.HightLightFeatureTourUrl" target="_blank">@Resources.QuickTour</a>
        </div>
    </div>
}