@model string
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Kickout</title>
</head>
<body>

    @Html.Hidden("message", Model)
    @Html.Hidden("oldMainRootPath", MicroSites.OldMainUrl())
