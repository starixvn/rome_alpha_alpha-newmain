@model MenuBarViewModel
@if (Model.Visible)
{
    <div>
        <ul class="main-tab">
            <li id="main-menu-header" class="mainmenu active @(Model.IsAccountInfoVisible ? "withripple" : "disabledViewAccInfo")" data-target-container="mainmenu-container">
                <a>@Resources.mainMenu</a>
            </li>
            @if (Model.IsAccountInfoVisible)
            {
                <li class="accountinfo withripple"  id="account-info-header"
                    data-target-container="accountinfo-container">
                    <a>@Resources.accountInfo</a>
                </li>
            }
        </ul>
        <div class="extra-box">
            <span id="icon-extra" class="icon icon-extra icon-dots"></span>
            @if (Model.IsAccountInfoVisible)
            {
                <span class="icon icon-user" id="user-icon"></span>
            }
        </div>
    </div>
    <section id="main-menu-tab"  class="mainmenu-container mCustomScrollbar @(Model.IsAccountInfoVisible ? string.Empty : "disabledViewAccInfo")" data-mcs-theme="minimal-dark" role="tablist" aria-multiselectable="true">
        <ul class="list-menu">
            @foreach (var menuItem in Model.MenuItems)
            {
                if (menuItem.VisibileSubMenus.Any())
                {
                    <li class="menu-item @(menuItem.ShowSubMenus ? "active" : string.Empty)">
                        <a class="withripple menu-opener parent-menu @(menuItem.ShowSubMenus ? "active" : string.Empty)">
                            <span class="txt-item pull-left"><span class="icon icon-@menuItem.ResourceKey.ToLower()"></span>@Html.Raw(menuItem.DisplayName)</span>
                            <span class="pull-right icon-arrow-right"></span>
                        </a>
                        <ul class="sub-menu" style="display: @(menuItem.ShowSubMenus ? "block" : "none");">
                            @foreach (var subMenuItem in menuItem.VisibileSubMenus)
                            {
                                <li class="sub-menu-item @(subMenuItem.Status.Disabled?"disabled-menu":string.Empty)">
                                    <a href="@subMenuItem.Url" target="main" class="redirect-item">
                                        @subMenuItem.DisplayName
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
                else
                {
                    <li class="menu-item">
                        <a class="withripple menu-opener parent-menu redirect-item" href="@menuItem.Url" target="main">
                            <span class="txt-item pull-left"><span class="icon icon-@menuItem.ResourceKey.ToLower()"></span>@menuItem.DisplayName</span>
                        </a>
                    </li>
                }
            }
        </ul>
    </section>

    if (Model.IsAccountInfoVisible)
    {
        <section id="account-info-tab" class="accountinfo-container @(Model.IsSmallDevice ? string.Empty : "mCustomScrollbar")" data-mcs-theme="minimal-dark">
            <iframe frameborder="0" id="accountinfo-content"
                    name="menu" marginwidth="0" marginheight="0" allowtransparency="true" class="accinfo-content" scrolling="auto"></iframe>
        </section>
    }
}