<!-- Begin Modal -->
<div class="modal fade" id="beginModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="mySmallModalLabel">
    <div class="modal-dialog smallModal">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
            </div>
            <div tabindex="-1" id="ui-tour-mask" style="display: block;">
                <div class="mask-inner in" id="mask-inner">
                    <div class="stage">
                        <h1>@Resources.MainIntroductionTitle</h1>
                        <p>@Resources.MainIntroductionDescription</p>
                    </div>
                    <div class="button-block">
                        <button id="start-introduction-btn" class="btn-ok js-let-go-btn active" data-toggle="modal" data-target="#myModal" data-demo><span>@Resources.QuickTour</span></button>
                        <button class="btn-close" id="not-now-introduction-btn" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">@Resources.NotNow</span></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Hidden("HomeIconIntroduction", Resources.HomeIconIntroduction)
@Html.Hidden("TransferAndViewLogIntroduction", Resources.TransferAndViewLogIntroduction)
@Html.Hidden("QuickMenuIntroduction", Resources.QuickMenuIntroduction)
@Html.Hidden("QuickMenu", Resources.QuickMenu)
@Html.Hidden("SwitchView", Resources.SwitchView)
@Html.Hidden("BackOldViewIntroduction", Resources.BackOldViewIntroduction)
@Html.Hidden("WarningOldVersionDeadline", Resources.WarningOldVersionDeadline)
@Html.Hidden("MainMenuIntroduction", Resources.MainMenuIntroduction)
@Html.Hidden("ReportMenuIntroduction", Resources.ReportMenuIntroduction)
@Html.Hidden("WinLossAnalysisChartIntroduction", Resources.WinLossAnalysisChartIntroduction)
@Html.Hidden("CollapseExpandIcon", Resources.CollapseExpandIcon)
@Html.Hidden("CollapseExpandIconIntroduction", Resources.CollapseExpandIconIntroduction)
@Html.Hidden("MainMenu", Resources.mainMenu)
@Html.Hidden("TransferMenuIntroduction", Resources.TransferMenuIntroduction)
@Html.Hidden("ViewLogMenuIntroduction", Resources.ViewLogMenuIntroduction)
@Html.Hidden("ShowMainMenu", Resources.ShowMainMenu)
@Html.Hidden("Skip", Resources.Skip)
@Html.Hidden("Next", Resources.Next)
@Html.Hidden("Replay", Resources.Replay)
@Html.Hidden("GotIt", Resources.GotIt)
@Html.Hidden("ReplayInstruction", Resources.ReplayInstruction)
@Html.Hidden("TakeTourInstruction", Resources.TakeTourInstruction)
@Html.Hidden("IsCookieLess", HttpContext.Current.Session.IsCookieless ? "1" : "0")

<!-- For mobile -->
<div class="blockUI-mobile"></div>
<div class="modal fade instruction-mobile in" id="instruction-mobile">
    <div class="modal-dialog ex-modal">
        <div class="modal-content">
            <div class="modal-body">
                <!-- Line -->
                <div class="line-pointer search"></div>
                <div class="line-pointer message"></div>
                <div class="line-pointer announcement"></div>
                <div class="line-pointer setting"></div>

                <div class="txt-instru search">@Resources.searchAccount</div>
                <div class="txt-instru message">@Resources.viewMessage</div>
                <div class="txt-instru announcement">@Resources.viewAnnouncement</div>
                <div class="txt-instru setting">
                    <ul>
                        <li>@Resources.changeLanguage</li>
                        <li>@Resources.LogOut</li>
                    </ul>
                </div>
                <div class="button-close">@Resources.GotIt</div>
            </div>
        </div>
    </div>
</div>