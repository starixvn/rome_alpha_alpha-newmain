@model MenuBarViewModel
<div id="carousel-banner" class="carousel slide carousel-banner " data-ride="carousel">
    <!-- Wrapper for slides -->
    <div class="carousel-inner">
        <div class="item active">
            @GetAppDownloadedBanner(Model.SiteGroup, Model.Language)
        </div>
    </div>
    <!-- Indicators -->
    <ol class="carousel-indicators">
        <li data-target="#carousel-banner" data-slide-to="0" class="active"></li>
    </ol>
</div>
@helper GetAppDownloadedBanner(string siteGroup, string language)
{
    string token = string.Empty;
    if (siteGroup.Equals("IBCBET", StringComparison.OrdinalIgnoreCase))
    {
        token = "GueGhmPRxEWbbp3FIbpqPA";
    }
    else if (siteGroup.Equals("IBCIndo", StringComparison.OrdinalIgnoreCase))
    {
        token = "QTQanXruEEur8ihzdYoF3A";
    }
    else if (siteGroup.Equals("789Y", StringComparison.OrdinalIgnoreCase))
    {
        token = "Rl89LflI4EaoNIdu2zzeVw";
    }

    var size = Model.IsSmallDevice ? "355x140" : "280x140";
    <a href="https://www.winwin999.net/?bt=@token&pd=sports" target="_blank">
        <img src="~/Assets/Images/MenuBarBanner/@siteGroup/@(size)_AppDownloaded_@(language).jpg" alt="app downloaded" />
    </a>
}