@using Alpha.Main.Constants
@using Alpha.Main.Site.ViewModels.Home.Notice

@model NoticeViewModel

<div class="message-content">
    @if (!Model.DateGroup.Any())
    {
        <div class="text-center">@Resources.noInfo</div>
    }
    else
    {
        var tempPostTime = DateTimeDefault.MinDateTime;

        foreach (var message in Model.NoticeMessages)
        {
            var currentPostTime = message.PostTime;

            if (currentPostTime.Date != tempPostTime.Date)
            {
                <div class="group-date">@currentPostTime.ToShortDateString()</div>
                tempPostTime = currentPostTime;
            }

            <div class="msg-contents">
                <div id="@message.CurrentMessage.Id"
                     class="msg pointer @message.Type @(!message.CurrentMessage.IsRead ? "bold" : string.Empty)">
                    <div class="time"><span class="icon icon-plus"></span>@message.PostTime.ToLongTimeString()</div>
                    <div class="short-content">
                        @message.ShortContent
                    </div>
                    <div class="full-content collapse">
                        @message.Content
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (Model.DateGroup.Any())
{
    <div class="more-info" value="@Model.LastMessagePostTime">
        More <span class="icon-arrow-down icon-more"></span>
    </div>
}