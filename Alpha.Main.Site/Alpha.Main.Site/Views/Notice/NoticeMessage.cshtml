@using Alpha.Main.Site.ViewModels.Home.Notice
@model NoticeViewModel

@helper RenderNoticeMessageByPostDate(DateTime postDate)
{

var messages = Model.NoticeMessages
                .Where(m => m.CurrentMessage.PostTime.Date == postDate)
                .OrderByDescending(m => m.CurrentMessage.PostTime);

foreach (var message in messages)
{
        <div id="@message.CurrentMessage.Id"
             class="msg pointer @message.Type @(!message.CurrentMessage.IsRead ? "bold" : string.Empty)">
            <div class="time"><span class="icon icon-plus"></span>@message.PostTime</div>
            <div class="short-content">
                @message.ShortContent ...
            </div>
            <div class="full-content collapse">
                @message.Content
            </div>
        </div>
}
}

<div class="message-content">
    @if (Model.DateGroup?.Count() == 0)
    {
        <div class="text-center">@Resources.noInfo</div>
    }
    else
    {
        foreach (var date in Model.DateGroup)
        {
            if (date != Model.MaxDateTime)
            {
                <div class="group-date">@date.ToShortDateString()</div>
                <div class="msg-contents">
                    @RenderNoticeMessageByPostDate(date)
                </div>
            }
        }
    }
</div>

@if (Model.DateGroup?.Count() > 0)
{
    <div class="more-info" value="@Model.LastMessagePostTime">
        More <span class="icon-arrow-down icon-more"></span>
    </div>
}