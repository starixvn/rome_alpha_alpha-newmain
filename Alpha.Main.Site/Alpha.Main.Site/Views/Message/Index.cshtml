@using Alpha.Main.Constants
@model Alpha.Main.Site.ViewModels.Message.MessagesViewModel

@helper RenderMessages(string messageTypeName)
{
    <div role="tabpanel" class="tab-pane active" id="@messageTypeName">
        @Html.Partial("Messages", Model)
    </div>
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render($"/bundles/site-main/message/message-{Model.UserLevelName}")
    <link href="@(StaticResources.MainSiteStyleUrl("~/assets/bundles/default-message"))" rel="stylesheet" type="text/css" />
</head>
<body>
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="public-tab @(Model.MessageType == MessageType.Public ? "active" : string.Empty)" id="1">
            <a href="#public" aria-controls="home" role="tab" data-toggle="tab">@Resources.normalAnnouncement</a>
        </li>
        <li role="presentation" class="special-tab @(Model.MessageType == MessageType.Special ? "active" : string.Empty)" id="2">
            <a href="#special" aria-controls="home" role="tab" data-toggle="tab">@Resources.specialAnnounement</a>
        </li>
        <li role="presentation" class="private-tab @(Model.MessageType == MessageType.Private ? "active" : string.Empty)" id="0">
            <a href="#private" aria-controls="home" role="tab" data-toggle="tab">@Resources.personalMessage</a>
        </li>
    </ul>

    <div class="tab-content">
        @RenderMessages(Model.MessageTypeName)
    </div>

    @Html.Partial("HiddenFields", Model)

    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/message/message-default")
    <script src="@(StaticResources.MainSiteScriptUrl("~/assets/bundles/default-message"))" type="text/javascript"></script>
</body>
</html>