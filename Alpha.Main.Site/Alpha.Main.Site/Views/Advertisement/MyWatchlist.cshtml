@using Alpha.Main.AppResources
@model Alpha.Main.Site.ViewModels.Advertisement.MyWatchlistViewModel
<h3>Easy to monitor your member by My Watchlist</h3>
<p>Global threshold: apply the threshold for all members</p>
<p>Go to My Watchlist tab -> click on button -> set Winning/Losing threshold</p>
<p>Personal threshold: apply the threshold for specific members</p>
<p>Go to My Watchlist tab -> click on Add New Member button -> enter member username and Winning/Losing threshold</p>
<img src="~/Assets/Images/MyWatchlist/ui.jpg" alt="my watchlist" />
<div>
    <label><input type="checkbox" id="chb-dontShow" />@Resources.doNotShowAgain</label>
    <a href="@Model.UserGuideLink" target="_blank" class="btn-default">Learn More</a>
    <button class="btn-submit" id="btn-setup">@ChatBot.SetupNow</button>
</div>
