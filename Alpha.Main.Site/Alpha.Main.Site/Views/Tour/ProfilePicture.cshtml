@using Alpha.Main.Site.ViewModels.Tour
@model TourViewModel
@{ var language = Model.Language;
    var roleId = Model.RoleId;

    var imagePath = $"~/Assets/styles/tour/images/profile-picture/"; }

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.RenderStylesWithDarkMode("~/assets/bundles/tour/common-tour")
</head>
<body>
    <div class="wrapper-tour">
        <span class="icon-close" onclick="top.popupManager.closeAllPopup()"></span>
        <div class="inner">
            <div class="content-page content-page-1">
                <div class="title">New Secure Login Process</div>
                <p>To enhance account security, you will now see your profile picture for verification after entering your username.</p>
                <img src="@Url.Content( $"{imagePath}/page1.png")" alt="tour introduction setting" />
            </div>
            <div class="content-page content-page-2 hidden">
                <div class="title">Ensure your profile picture matches your account before entering your password.</div>
                <img src="@Url.Content( $"{imagePath}/page2.png")" alt="tour introduction setting" />
            </div>
            <div class="content-page content-page-3 hidden">
                <div class="title">Setting a profile picture helps you quickly identity the legitimate site and secure your privacy.</div>
                <p>Update your profile picture anytime in <a href="">Profile Settings</a> using two options:</p>
                <img src="@Url.Content( $"{imagePath}/page3.png")" alt="tour introduction setting" />
            </div>
        </div>
    </div>
    <div class="control">
        <div class="spn-page">
            <span>@Resources.Page</span>
            <span class="page-index">1</span>
            <span>@Resources.of</span>
            <span class="total-page">3</span>
        </div>
        <div class="page-btn">
            <span class="page-btn-prev hidden"><i class="icon-caret-left"></i></span>
            <span class="page-btn-next"><i class="icon-caret-right"></i></span>
        </div>
    </div>
    </div>
    @StaticResources.AssetScripts.Render("/bundles/site-main/default")
    @StaticResources.RenderScripts("~/assets/bundles/tour/profile-picture-tour")
</body>
</html>
