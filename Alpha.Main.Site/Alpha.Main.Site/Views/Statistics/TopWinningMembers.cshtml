@using Alpha.Main.Site.ViewModels.Dashboard.Statistics
@model TopWinningMembersViewModel

@if (!Model.Members.Any())
{
    <div class="text-center">@Resources.noInfo</div>
}
else
{
    <table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per">
        <thead>
            <tr>
                <th width="50%">@Resources.username</th>
                <th width="50%">@Resources.winningAmount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model.Members)
            {
                <tr>
                    <td class="username">@member.UserName</td>
                    <td class="text-right bold">@member.WinLoss.ToString("#,##0.00")</td>
                </tr>
            }
        </tbody>
    </table>
}