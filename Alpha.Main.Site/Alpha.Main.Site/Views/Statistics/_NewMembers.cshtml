@using Alpha.Main.Site.ViewModels.Home.Statistics
@model NewMembersViewModel

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per">
    <thead>
        <tr>
            <th class="c">@Resources.username</th>
            <th class="c newMemCol">@Resources.givenCredit</th>
            <th class="c newMemCol">@Resources.createdDate</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model.Members)
        {
            <tr class="oddRow">
                <td class="username">@member.UserName</td>
                <td class="text-right newMemCol">@member.GivenCredit</td>
                <td class="text-center datetime">@member.CreatedDate</td>
            </tr>
        }
    </tbody>
</table>