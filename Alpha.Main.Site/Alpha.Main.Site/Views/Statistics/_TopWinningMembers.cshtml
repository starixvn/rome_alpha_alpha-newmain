@using Alpha.Main.Site.ViewModels.Home.Statistics
@model TopWinningMembersViewModel

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per">
    <thead>
        <tr>
            <th>@Resources.username</th>
            <th>@Resources.winningAmount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model.Members)
        {
            <tr>
                <td class="username">@member.UserName</td>
                <td class="text-right bold">@member.WinLoss</td>
            </tr>
        }
    </tbody>
</table>