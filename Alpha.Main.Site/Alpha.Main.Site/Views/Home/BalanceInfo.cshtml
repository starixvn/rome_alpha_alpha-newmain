@using Alpha.Main.Site.ViewModels.Home.Index
@model BalanceInfoViewModel

<div class="container">
    <div class="panel-title"><span class="icon-balanceinfo"></span>balance info</div>
    <div class="row">
        <div class="col-xs-7 label">@Model.AgentLabel</div>
        <div class="col-xs-5 value"><strong>@Model.AgentName</strong></div>
    </div>
    <div class="row">
        <div class="col-xs-7 label">@Resources.currency</div>
        <div class="col-xs-5 value"><strong>@Model.Currency</strong></div>
    </div>
    <div class="group-title">@Resources.balance</div>
    <div class="row">
        <div class="col-xs-7 label">@Resources.cashBalance</div>
        @FormatBalance(Model.BalanceInfo.CashBalance)
    </div>
    <div class="row">
        <div class="col-xs-7 label">@Resources.yesterdayCashBalance</div>
        @FormatBalance(Model.BalanceInfo.YesterdayCashBalance)
    </div>
    <div class="row">
        <div class="col-xs-7 label">@Resources.totalBalance</div>
        @FormatBalance(Model.BalanceInfo.TotalBalance)
    </div>
    <div class="row">
        <div class="col-xs-7 label">@Resources.yesterdayTotalBalance</div>
        @FormatBalance(Model.BalanceInfo.YesterdayTotalBalance)
    </div>
    <div class="group-title">@Resources.winloss</div>
    <div class="row">
        <div class="col-xs-7 label">@Resources.todayWinLoss (@DateTime.Today.ToString("MM/dd/yyyy"))</div>
        <div class="col-xs-5 value"><strong>@FormatNumber(Model.BalanceInfo.TodayWinLoss)</strong></div>
    </div>
    <div class="row">
        <div class="col-xs-7 label">@Resources.yesterdayWinLoss (@DateTime.Today.AddDays(-1).ToString("MM/dd/yyyy"))</div>
        <div class="col-xs-5 value"><strong>@FormatNumber(Model.BalanceInfo.TodayWinLoss)</strong></div>
    </div>
    <div class="group-title">@Resources.credit</div>
    <div class="row">
        <div class="col-xs-7 label">@Model.AgentGivenCreditLabel</div>
        <div class="col-xs-5 value"><strong>@FormatNumber(Model.BalanceInfo.GivenCredit)</strong></div>
    </div>
    <div class="row">
        <div class="col-xs-7 label">@Model.TotalMemberCreditLabel</div>
        <div class="col-xs-5 value"><strong>@FormatNumber(Model.BalanceInfo.MemberCredit)</strong></div>
    </div>

    @helper FormatBalance(decimal balance)
    {
        var textClass = string.Empty;
        if (balance < 0)
        {
                textClass = "text-red";
        }
        <div class="col-xs-5 value @textClass ">
            <strong>
                @balance.ToString("#,##0.00")
            </strong>
        </div>
    }

    @helper FormatNumber(decimal number) { 
       @number.ToString("#,##0.00")
    }
</div>
