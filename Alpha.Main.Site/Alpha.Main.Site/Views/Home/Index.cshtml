@using Sunplus.Agent.Model.Entities;
@using SiteServices = Alpha.Main.Site.Services;
@using Sunplus.Agent.Model.Entities;
@using System.Web.Optimization;
@using Alpha.Main.Site.Services.Impl;
@model MainIndexViewModel
@{
    var contentSite = SiteServices.AppSettings.ContentSite;
    var currentUserSession = UserSession.Current;
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    var contentFrame = "main";

    var appPathService = new AppPathServiceImpl();
    var baseOldMainApp = appPathService.GetAppPath(SiteServices.AppSettings.OldMainApp, "~");
}
<!DOCTYPE html>
<!--[if IE 8 ]>
<html lang="en" class="ie8">
<![endif]-->
<!--[if (gte IE 8)|!(IE)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <title></title>
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap/css/bootstrap.min.css">
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/reset.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap-material/css/bootstrap-material-design.min.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap-material/css/ripples.min.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/libs/jquery/jQueryCustomScrollbar/jquery.mCustomScrollbar.min.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/fonts/iconalpha/style.css">
    @Styles.Render("~/bundle/styles/home")
    <link type="text/css" rel="stylesheet" href="~/@("Content/Home/Styles/sass/LevelCustomStyle" + currentUserSession.RoleId + ".css")">
</head>
<body>
    <aside class="sidebar">
        <div class="customer-profile" id="profile">
        	@Html.Action("BriefProfile", "CustomerProfile")
        </div>
        <nav class="navigation" id="navigation">
            @Html.Action("MenuBar")
        </nav>
    </aside>
    <div class="content-wrapper">
        <header class="header">
            @Html.Action("HeaderNav")
            @Html.Action("HeaderMsg")
        </header>
        <main class="content" id="content">
            <iframe frameborder="0" id="main" scrolling="auto" name="main" marginwidth="0" marginheight="0" allowtransparency="true" class="iframe-content"></iframe>
        </main>
    </div>
    <script type="text/javascript" src="/@contentSite/libs/jquery/jquery-1.11.3.min.js"></script>
    <script type="text/javascript" src="/@contentSite/css/bootstrap/js/bootstrap.min.js"></script>
    <script type="text/javascript" src="/@contentSite/libs/jquery/jQueryCustomScrollbar/jquery.mCustomScrollbar.concat.min.js"></script>
    <script type="text/javascript" src="/@contentSite/css/bootstrap-material/js/material.min.js"></script>
    <script type="text/javascript" src="/@contentSite/css/bootstrap-material/js/ripples.min.js"></script>
    <script type="text/javascript" src="/@contentSite/libs/underscore/underscore-min.js"></script>
    @Scripts.Render("~/bundles/scripts/home")
    <script type="text/javascript">
            $.material.init();
            var baseMainApp='';
            var baseOldMainApp='';
            var start = baseMainApp.indexOf('//') + 2;
            window.document.title = baseMainApp.substr(start, baseMainApp.length - start - 1);
            window.passwordHash = '';

            var contentFrame = "@contentFrame";
            var _resources = {
                language: '@currentUserSession.Language',
                onUserId: '@currentUserSession.OnUserId',
                cookieCurrentURLKey: '',
                baseUrl: '',
                msgList:[],

                months:[],
                year: @DateTime.Now.Year,
                month:@DateTime.Now.Month,
                day:@DateTime.Now.Day,
                hrs:@DateTime.Now.Hour,
                min:@DateTime.Now.Minute,
                sec:@DateTime.Now.Second,
                PM:'@Resources.PM',
                AM:'@Resources.AM'
            };

    </script>
</body>
</html>