@using Sunplus.Agent.Model.Entities;
@using Alpha.Main.Site.App_GlobalResources;
@using Alpha.Main.Site.Models.Views;
@using AlphaDefinitions = Sunplus.Agent.Model.BL.Definitions;
@using SiteServices = Alpha.Main.Site.Services;
@using Sunplus.Agent.Model.Entities;
@using System.Web.Optimization;
@using Alpha.Main.Site.Services.Impl;
@model MainIndexViewModel
@{
    var contentSite = SiteServices.AppSettings.ContentSite;
    var currentUserSession = UserSession.Current;
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    var contentFrame = "main";

    var appPathService = new AppPathServiceImpl();
    var baseOldMainApp = appPathService.GetAppPath(SiteServices.AppSettings.OldMainApp, "~");
}

@section Styles{
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap-material/css/bootstrap-material-design.min.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/css/bootstrap-material/css/ripples.min.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/libs/jquery/jQueryCustomScrollbar/jquery.mCustomScrollbar.min.css">
    <link type="text/css" rel="stylesheet" href="/@contentSite/Fonts/Iconalpha/style.css">
    @Styles.Render("~/bundle/styles/main")
    <link type="text/css" rel="stylesheet" href="~/@("Content/Home/Styles/sass/LevelCustomStyle" + currentUserSession.RoleId + ".css")">
}

<aside class="sidebar">
    <div class="customer-profile" id="profile"></div>
    <nav class="navigation">
        @if (Model.SideBar.Visible)
        {
            <div>
                <ul class="main-tab" id="main-tab">
                    <li class="mainmenu active"><a href="javascript:;">@Resources.mainMenu</a></li>
                    <li class="accountinfo  @(Model.SideBar.IsAccountInfoVisible ? string.Empty : "disabledView")">
                        <a href="javascript:;">
                            @(Model.SideBar.IsAccountInfoVisible ? Resources.accountInfo : string.Empty)
                        </a>
                    </li>
                </ul>
                <div class="extra-box">
                    <span class="icon icon-extra icon-dots"></span>
                </div>
            </div>
            <section class="mainmenu-container mCustomScrollbar" data-mcs-theme="minimal-dark" id="accordion" role="tablist" aria-multiselectable="true">
                <ul class="list-menu">
                    @foreach (var menu in Model.SideBar.MenuItems)
                    {
                        if (menu.Status.Visible)
                        {
                            if (menu.SubMenus.Any())
                            {
                                <li class="menu-item @(menu.ShowSubMenus ? "active" : string.Empty)">
                                    <a class="withripple menu-opener parent-menu @(menu.ShowSubMenus ? "active" : string.Empty)"
                                       href="javascript:;">
                                        <span class="txt-item pull-left"><span class="icon icon-@menu.ResourceKey.ToLower()"></span>@menu.DisplayName</span>
                                        <span class="pull-right icon-arrow-right"></span>
                                    </a>
                                    <ul class="sub-menu" style="display: @(menu.ShowSubMenus ? "block" : "none");">
                                        @foreach (var subMenu in menu.SubMenus)
                                        {
                                            if (subMenu.Status.Visible)
                                            {
                                                <li class="sub-menu-item @(subMenu.Status.Disabled?"disabled-menu":string.Empty)">
                                                    <a href="@subMenu.Url" target="main">
                                                        @subMenu.DisplayName
                                                    </a>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="menu-item">
                                    <a class="withripple menu-opener parent-menu" href="@menu.Url" target="main">
                                        <span class="txt-item pull-left"><span class="icon icon-@menu.ResourceKey.ToLower()"></span>@menu.DisplayName</span>
                                    </a>
                                </li>
                            }
                        }
                    }
                </ul>

            </section>

            if (Model.SideBar.IsAccountInfoVisible)
            {
                <section class="accountinfo-container container mCustomScrollbar" data-mcs-theme="minimal-dark">
                    <span class="icon icon-user"></span>
                    <iframe frameborder="0" id="accountinfo-content" scrolling="auto"
                            name="menu" marginwidth="0" marginheight="0" allowtransparency="true" class="accinfo-content"></iframe>
                </section>
            }
        }
    </nav>
</aside>
<div class="content-wrapper">
    <header class="header">
        <section class="navbar header-navigation" id="header-navigation">
            <span class="icon-collapse icon-hamburger withripple"></span>
            <ul class="nav navbar-nav list-top">
                <li><span class="icon icon-time"></span><span class="txt-top" id="clock"></span></li>
                <li class="dropdown">
                    <a href="javascript:;" data-target="#" class="dropdown-toggle withripple" data-toggle="dropdown">
                        <span class="language-text language-selector"></span>
                    </a>
                    <ul class="dropdown-menu list-language" id="language">
                        @foreach (var language in Model.Languages)
                        {
                            <li class="@language.LanguageCode"><a class="changelanguage-link" data-value="@language.LanguageCode"><span class="icon icon-flag langFlag_@language.LanguageCode.Substring(0, 2).ToLower()"></span>@language.LanguageName</a></li>
                        }
                    </ul>
                </li>
                <li class="withripple"><span class="icon icon-swap-horizontal" title="@Resources.OldView"></span><span class="txt-top old-view-text">@Resources.OldView</span></li>
                <li class="dropdown">
                    <a href="javascript:;" data-target="#" class="dropdown-toggle withripple" data-toggle="dropdown">
                        <span class="icon icon-squares top-right-menu"></span>
                    </a>
                    <ul class="dropdown-menu list-setting">
                        <li><a href="/@(baseOldMainApp + "_HowToUse/Index.aspx")" target="blank"><span class="icon icon-help"></span>@Resources.Help</a></li>
                        <li><a href="javascript:indexPageManager.changeMenu('/' + top.baseOldMainApp + 'Company/ContactUs/Index'); indexPageManager.closeListSetting();"><span class="icon icon-contactus"></span>@Resources.ContactUs</a></li>
                        <li><a href="/@(baseOldMainApp + "ContextualCustomer/ProfilePicture?custId=" + currentUserSession.CustId)" target="@contentFrame"><span class="icon icon-profilepic"></span>@Resources.EditProfilePicture</a></li>
                        <li><a href="javascript:indexPageManager.changeMenu('/' + top.baseOldMainApp + '_MemberInfo/ChangePassword/ChangePassword.aspx'); indexPageManager.closeListSetting();"><span class="icon icon-lock"></span>@Resources.password</a></li>
                        <li><a href="javascript:indexPageManager.changeMenu('/' + top.baseOldMainApp + 'Security/SecurityCode/ChangeSecurityCode'); indexPageManager.closeListSetting();"><span class="icon icon-sercuritycode"></span>@Resources.SecurityCode</a></li>
                    </ul>
                </li>
                <li class="withripple"><span class="icon icon-logout"></span></li>
            </ul>
        </section>
        <section class="header-notification" id="header-notification">
            <span class="icon icon-home c-Primary withripple"></span>
            <div id="marquee">
                <span id="scroller">
                    <span id="live-message" class="maquee live-message"></span>
                </span>
            </div>
            <div class="nav-iconbox">
                <span class="icon icon-add c-Primary special-message"></span>
                <div class="email-box private-message"><span class="icon icon-message c-Primary"></span><span class="value">0</span></div>
            </div>
        </section>
    </header>
    <section class="content" id="content">
        <iframe src="@Model.MainPage" frameborder="0" id="@contentFrame" scrolling="auto"
                name="main" marginwidth="0" marginheight="0" allowtransparency="true" class="iframe-content"></iframe>
    </section>
</div>
<div id="popup-top" class="display-none">
    <div id="popup-line">
        <a class="top-message">
            <img src="~/Content/Home/Styles/Images/icon_close.jpg" class="button-close" alt="@Resources.close" title="@Resources.close" />
        </a>
    </div>
    <div class="popup-content">
        <div id="popup-contents" class="messageBlock"></div>
        <div id="popup-contents-2" class="messageBlock"></div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript" src="/@contentSite/libs/jquery/jQueryCustomScrollbar/jquery.mCustomScrollbar.concat.min.js"></script>
    <script type="text/javascript" src="/@contentSite/css/bootstrap-material/js/material.min.js"></script>
    <script type="text/javascript" src="/@contentSite/css/bootstrap-material/js/ripples.min.js"></script>
    <script type="text/javascript" src="/@contentSite/libs/underscore/underscore-min.js"></script>
    @Scripts.Render("~/bundles/scripts/main")
    @if (AlphaDefinitions.AppSettings.PiwikEnable)
    {
        <script type="text/javascript">
            var _pkUrl = '@AlphaDefinitions.AppSettings.PiwikUrl',
                _pkScript = '@AlphaDefinitions.AppSettings.PiwikScript',
                _pkSiteId = '@AlphaDefinitions.AppSettings.PiwikSiteId';
        </script>
        <script type="text/javascript" src="~/Content/Home/Scripts/piwikLoader.js"></script>
        <noscript><p><img src="@AlphaDefinitions.AppSettings.PiwikUrl?idsite=@AlphaDefinitions.AppSettings.PiwikSiteId" style="border:0;" alt="" /></p></noscript>
    }

    <script type="text/javascript">
        $.material.init();
        var baseMainApp='@Model.BaseUrl';
        var baseOldMainApp='@baseOldMainApp';
        var start = baseMainApp.indexOf('//') + 2;
        window.document.title = baseMainApp.substr(start, baseMainApp.length - start - 1);
        window.passwordHash = '@Model.PasswordHash';

        var contentFrame = "@contentFrame";
        var _resources = {
            language: '@currentUserSession.Language',
            onUserId: '@currentUserSession.OnUserId',
            cookieCurrentURLKey: '@Model.CookieCurrentURLKey',
            baseUrl: '@Model.BaseUrl',
            msgList: @Html.Raw(serializer.Serialize(Model.HotMessages)),

            months:@Html.Raw(serializer.Serialize(Model.MonthNames)),
            year: @DateTime.Now.Year,
            month:@DateTime.Now.Month,
            day:@DateTime.Now.Day,
            hrs:@DateTime.Now.Hour,
            min:@DateTime.Now.Minute,
            sec:@DateTime.Now.Second,
            PM:'@Resources.PM',
            AM:'@Resources.AM'
        };

    </script>
}
