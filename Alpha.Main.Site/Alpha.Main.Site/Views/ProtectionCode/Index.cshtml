@model Alpha.Main.Site.ViewModels.ProtectionCode.ProtectionCodeViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@Resources.ProtectionCode</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render($"/bundles/site-main/security/security-{Model.UserLevel}")
    @StaticResources.RenderStyles("~/Assets/bundles/protection-code/protection")
</head>
<body>
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation">
            <a href="@MicroSites.AccountInfoUrl($"~/ProfilePicture/")">@Resources.EditProfilePicture</a>
        </li>
        @if (Model.IsShowNicknameLink)
        {
            <li role="presentation">
                <a href="@MicroSites.OldMainUrl($"~/LoginOption/?custid={Model.CustId}")">@Resources.nickname</a>
            </li>
        }
        <li role="presentation">
            @Html.ActionLink("OTP", "SetUpOtp", "OTP")
        </li>
        <li role="presentation" class="active">
            <a href="#protectionCode" aria-controls="home" role="tab" data-toggle="tab">@Resources.ProtectionCode</a>
        </li>
    </ul>
    <div class="tab-content">
        <div role="tabpanel" class="tab-pane active" id="protectionCode">
            <div id="msg-content" class="msg-content hidden">
                <div id="msg" class="msg"></div>
            </div>
            @using (Html.BeginForm("Update", "ProtectionCode", FormMethod.Post, new { @class = "form-validation", id = "frmProtectionCode" }))
            {
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label for="txt-newProtectionCode">@Resources.NewProtectionCode</label>
                    <input type="text" autocomplete="off" maxlength="30" class="txt form-control" id="txt-newProtectionCode" />
                    <i class="validation"></i>
                </div>
                <div class="form-group">
                    <label for="txtConfirmProtectionCode">Confirm Protection Code</label>
                    <input type="text" autocomplete="off" maxlength="30" class="txt form-control" name="ConfirmProtectionCode" id="txtConfirmProtectionCode" />
                    <i class="validation"></i>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" id="chkShowProtectionCode" /> Show Protection Code</label>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn-submit" />
                    <input type="reset" value="@Security.Reset" />
                </div>
            }
            <div class="rules">
                <p>
                    <span class="note-red">*</span>
                    Protection Code must be at least 6 characters, CAN bet the same as your Security Code but CANNOT be the same as your password.
                </p>
                <a href="#" class="learn-more" data-toggle="modal" data-target="#learn-more-popup">@Security.LearnMore</a>
            </div>
        </div>
    </div>
    <div class="modal fade in" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="false" id="learn-more-popup">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="@Resources.close"><span aria-hidden="true"></span></button>
                    <h4 class="modal-title">Protection Code</h4>
                </div>
                <div class="modal-body">
                    @{ Html.RenderPartial($"_LearnMorePopup{Model.GetLearnMoreViewLang()}"); }
                </div>
            </div>
        </div>
    </div>
    @Html.Hidden("hashkey", Model.HashKey)
    @Html.Hidden("requiredNewProtectionCode", "Please enter New Protection Code.")
    @Html.Hidden("notMatchedConfirmProtectionCode", "The protection code is not correctly confirmed.")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    @StaticResources.RenderScripts("~/assets/bundles/protection-code/protection")
    @GoogleAnalyticHepler.Render()
</body>
</html>
