<?xml version="1.0" encoding="utf-8" ?>
<siteMap xmlns="http://schemas.microsoft.com/AspNet/SiteMap-File-1.0" enableLocalization="true">
  <siteMapNode title="Alpha Site">
    <!--Report-->
    <siteMapNode  resourceKey="reports" expand="1" menuItemType="ReportMenuItem" functionType="[E]">
      <siteMapNode resourceKey="memberOutstanding" appPath="ReportsAppPath" url="outstanding/member" roles="Agent"></siteMapNode>
      <siteMapNode resourceKey="agentOutstanding" appPath="ReportsAppPath" url="outstanding/agent" roles="Master"></siteMapNode>
      <siteMapNode resourceKey="masterOutstanding" appPath="ReportsAppPath" url="outstanding/master" roles="Super"></siteMapNode>

      <siteMapNode resourceKey="memberWinLoss" appPath="ReportsAppPath" url="enteredresult/member" roles="Agent"></siteMapNode>
