    <!--/Forecast-->

    <siteMapNode resourceKey="transfer" appPath="OldMainAppPath" menuItemType="TransferMenuItem" url="_Transfer/Agent/MemberList.aspx" functionType="[C]" roles="Agent"></siteMapNode>
    <siteMapNode resourceKey="transfer" appPath="OldMainAppPath" menuItemType="TransferMenuItem" url="_Transfer/Master/AgentList.aspx" functionType="[C]" roles="Master"></siteMapNode>
    <siteMapNode resourceKey="transfer" appPath="OldMainAppPath" menuItemType="TransferMenuItem" url="_Transfer/Super/MasterList.aspx" functionType="[C]" roles="Super"></siteMapNode>
    <siteMapNode resourceKey="viewLog" menuItemType="ViewLogMenuItem" functionType="[G]">
      <siteMapNode resourceKey="Setting" appPath="ViewLogsAppPath" url="Setting"></siteMapNode>
      <siteMapNode resourceKey="status" appPath="ViewLogsAppPath" url="Status"></siteMapNode>
      <siteMapNode resourceKey="credit" appPath="ViewLogsAppPath" url="Credit"></siteMapNode>
      <siteMapNode resourceKey="login" appPath="ViewLogsAppPath" url="Login"></siteMapNode>
    </siteMapNode>
    <siteMapNode resourceKey="announcements">
      <siteMapNode resourceKey="normal" url="Message/Index?messagetype=1" byPassAuthorization="true"></siteMapNode>
      <siteMapNode resourceKey="special"  url="Message/Index?messagetype=2" byPassAuthorization="true"></siteMapNode>
      <siteMapNode resourceKey="personalMessage" url="Message/Index?messagetype=0" byPassAuthorization="true"></siteMapNode>
