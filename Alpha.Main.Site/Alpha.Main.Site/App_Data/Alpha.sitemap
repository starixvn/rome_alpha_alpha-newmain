      <siteMapNode resourceKey="outRight" appPath="ExTotalBetsForecastAppPath" url="_TotalBets/OutRight.aspx"></siteMapNode>
      <siteMapNode resourceKey="htft" appPath="ExTotalBetsForecastAppPath" url="_TotalBets/HTFT.aspx"></siteMapNode>
      <siteMapNode resourceKey="fthtfglg" appPath="ExTotalBetsForecastAppPath" url="_TotalBets/FGLG.aspx"></siteMapNode>
      <siteMapNode resourceKey="BetType13" appPath="BetListsAppPath" url="betlistbybettype/Index?bettype=13"></siteMapNode>
      <siteMapNode resourceKey="BetType24" appPath="BetListsAppPath" url="betlistbybettype/Index?bettype=24"></siteMapNode>
      <siteMapNode resourceKey="homeDrawAwayNoBet" appPath="ExTotalBetsForecastAppPath" url="_TotalBets/HomeDrawAwayNoBet.aspx"></siteMapNode>
      <siteMapNode resourceKey="BetType26" appPath="BetListsAppPath" url="betlistbybettype/Index?bettype=26"></siteMapNode>
      <siteMapNode resourceKey="BetType27" appPath="BetListsAppPath" url="betlistbybettype/Index?bettype=27"></siteMapNode>
      <siteMapNode resourceKey="BetType28" appPath="BetListsAppPath" url="betlistbybettype/Index?bettype=28"></siteMapNode>
      <!--NG-->
      <siteMapNode menuItemType="NumberGameMenuItem" resourceKey="numbergame" appPath="ExTotalBetsForecastAppPath" url="_TotalBets/NumberGame.aspx"></siteMapNode>
      <!--/NG-->
      <!--HR-->
      <siteMapNode menuItemType="RacingMenuItem" resourceKey="hr" appPath="ExTotalBetsForecastAppPath" url="_TotalBets/Racing.aspx"></siteMapNode>
      <!--/HR-->
      <siteMapNode menuItemType="BullfightingMenuItem" resourceKey="Bullfighting" appPath="TotalbetsForecastSiteVirtualPath" url="~/Bullfighting"></siteMapNode>
