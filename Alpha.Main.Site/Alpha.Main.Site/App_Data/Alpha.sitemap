    <!--/Totalbets-->
    <!--Forecast-->
    <siteMapNode resourceKey="forecast" menuItemType="TotalBetsMenuItem">
      <siteMapNode resourceKey="HOUL" appPath="ExTotalBetsForecastAppPath" url="_Forecast/FCHDPOU.aspx"></siteMapNode>
      <siteMapNode resourceKey="lbl1x2" appPath="ExTotalBetsForecastAppPath" url="_Forecast/FC1X2.aspx"></siteMapNode>
      <siteMapNode resourceKey="scoreMap" appPath="ExTotalBetsForecastAppPath" url="ForecastScoreMap/Index"></siteMapNode>
