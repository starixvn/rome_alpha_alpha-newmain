<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    
    <section name="SecurityCodeSection" type="Fanex.Razorbill.Security.Configurations.SecurityCodeSection, Fanex.Razorbill.Security" />
    <section name="AlphaAuthSection" type="Alpha.Auth.Configurations.AlphaAuthSection, Alpha.Auth" />
  <section name="CustomerSettingConfiguration" type="Fanex.CustomerSetting.Client40.Configurations.CustomerSettingConfiguration, Fanex.CustomerSetting.Client40" /></configSections>

  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.18.200.124\private$\entlib" defaultCategory="Alpha-MBC-AF-LOCAL" />

  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="~/App_Data/SPNames/LOCAL/" enableWatching="1" ignoreExceptionIsNotParameters="true" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <SecurityCodeSection configSource="Web.Configuration\SecurityCode.config" />
  <AlphaAuthSection enableAntiXSRF="true" enableSessionValidation="true" enableKickOutWhenSessionInvalid="false" />

  <connectionStrings configSource="Web.ConnectionStrings.config" />

  <appSettings file="Web.AppSettings.config" />

  <system.web>    
    <pages buffer="true" enableViewState="false"></pages>
    <siteMap defaultProvider="AlphaSiteMap" enabled="true">     
      <providers>
        <add name="AlphaSiteMap" type="System.Web.XmlSiteMapProvider" siteMapFile="~/App_Data/Alpha.sitemap" />
      </providers>
    </siteMap>

    <compilation debug="true" targetFramework="4.6.1" />
    <httpRuntime enableVersionHeader="false" />
    <httpModules>
      <add name="SecurityCodeHttpModule" type="Alpha.SecurityCode.HttpModules.SecurityCodeHttpModule, Alpha.SecurityCode" />
    </httpModules>

    <authentication mode="Forms" >
      <forms loginUrl="/site-oldmain/_Authorization/SignIn.aspx" defaultUrl="~/Home" path="/" name=".AGENTFORMSAUTH" protection="All" cookieless="UseDeviceProfile" />
    </authentication>

    <authorization>
      <deny users="?" />
      <allow users="*" />
    </authorization>

    <sessionState mode="StateServer" timeout="10" cookieless="false" />

