<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H],[L]"
  custIdQueryStringParamNameMapping="custid,CustId,custId,targetCustId,id,cid,recommend,mrecommend,idagent,masterId,agentId,idAgent,idMaster,ibccustid,ACustID"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
  ignoreUrls="SignIn.aspx,ProcessAdminLogin.ashx,ProcessAfterLogin.ashx,Captcha.ashx,ChartImg.axd,ReCheckin.ashx,SecurityCode,Header.aspx,Index.aspx"
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!--
    [A]: Create
    [B]: Update
    [C]: Transfer
    [D]: Total Bets
    [E]: Reports
    [F]: Forcast
    [H]: Member Information
    [G]: View Log
    [L]: Bet Lists
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="2.01.01" permission="[A]" mainfuncname="Add New Customer" subfuncname="SC - Header page" url="_MemberInfo/SearchAndCopy/MasterPage.aspx" ischeckbelonging="true" />
      <add id="2.07.01" permission="[H]" mainfuncname="Sub Account" subfuncname="Sub Account List - View" url="_SubAcc/SubAccList.aspx" ischeckbelonging="true" />
      <add id="2.08.33" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Customer List" url="_MemberInfo/CustomerList/Agent/MemberList.aspx" ischeckbelonging="true" isallowtodobythemselves="true" />

      <add id="2.09.12" permission="[A],[B],[H]" mainfuncname="Position Taking" subfuncname="Sportsbook - PT list" url="_MemberInfo/PositionTakingList/Sportbook/SportbookPositionTakingList.aspx" ischeckbelonging="true" />
      <add id="2.09.16" permission="[A],[B],[H]" mainfuncname="Position Taking" subfuncname="Casino - PT list" url="_MemberInfo/PositionTakingList/Casino/CasinoPositionTakingList.aspx" ischeckbelonging="true" />
      <add id="2.10.01" permission="[A],[B],[H]" mainfuncname="Member Commision" subfuncname="Sportsbook" url="_MemberInfo/Commission/MemberCommissionSportbook.aspx" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="2.08.36" permission="[H]" mainfuncname="Member Info" subfuncname="Win Limit" url="MemberInformation/WinLimit/Index" ischeckbelonging="true" isallowtodobythemselves="true" />

      <add id="2.02.05" permission="[C]" mainfuncname="Transfer" subfuncname="Member List" url="_Transfer/Agent/MemberList.aspx" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="2.06.02" permission="[G]" mainfuncname="View Logs" subfuncname="Log Customer Setting" url="_ViewLog/LogCustomerSetting.aspx" />
      <add id="2.06.01" permission="[G]" mainfuncname="View Logs" subfuncname="Log Credit" url="_ViewLog/LogCredit.aspx" />

      <add id="2.06.03" permission="[G]" mainfuncname="View Logs" subfuncname="Log Customer Setting" url="_ViewLog/LogStatus.aspx" />
      <add id="2.06.04" permission="[G]" mainfuncname="View Logs" subfuncname="Log Login" url="_ViewLog/LogLogin.aspx" />
      <add id="2.13.12" permission="[A],[B],[C],[D],[E],[G],[H],[L]" mainfuncname="Main Page" subfuncname="New Message" url="Info/NewMessageForm.aspx" isallowtodobythemselves="true" />
      <add id="2.08.35" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Reset Secuirty Code" url="SecurityCode/ResetSecurityCode" ischeckbelonging="true" />
      <add id="2.08.31" permission="[B]" mainfuncname="Member Info" subfuncname="Reset Password downline" url="Password/ResetMainAccountPassword" ischeckbelonging="true" />

      <add id="2.15.01" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Reset otp downline" url="Otp/ResetOtp" ischeckbelonging="true" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
      <add id="3.01.01" permission="[A]" mainfuncname="Add New Customer" subfuncname="SC - Agent Info" url="_MemberInfo/SearchAndCopy/MasterPage.aspx" ischeckbelonging="true" />
      <add id="3.04.02" permission="[A],[B],[H]" mainfuncname="Member Info" subfuncname="Agent List" url="_MemberInfo/CustomerList/Master/AgentList.aspx" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="3.02.01" permission="[C]" mainfuncname="Transfer" subfuncname="Agent List" url="_Transfer/Master/AgentList.aspx" ischeckbelonging="true" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
      <add id="4.01.01" permission="[A]" mainfuncname="Add New Customer" subfuncname="SC - Master" url="_MemberInfo/SearchAndCopy/MasterPage.aspx" ischeckbelonging="true" />
      <add id="4.04.09" permission="[H]" mainfuncname="Member Info" subfuncname="Master List" url="_MemberInfo/CustomerList/Super/MasterList.aspx" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="4.02.01" permission="[C]" mainfuncname="Transfer" subfuncname="Master List" url="_Transfer/Super/MasterList.aspx" ischeckbelonging="true" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>