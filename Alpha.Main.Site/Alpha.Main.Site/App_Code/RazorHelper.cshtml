@helper DisplayLanguageDropdown(string selectedLangaugeCode = "en-US")
{
    <a href="javascript:;" data-target="#" class="dropdown-toggle withripple" data-toggle="dropdown">
        <span class="icon icon-flag language-selector langFlag_@selectedLangaugeCode.ToLowerInvariant()"></span>        
        <span class="language-text language-selector"></span>
    </a>
    <ul class="dropdown-menu list-language" id="language">      
        <li class="en-US"><a class="changelanguage-link" data-value="en-US"><span class="icon-flag langFlag_en"></span>English</a></li>
        <li class="zh-TW"><a class="changelanguage-link" data-value="zh-TW"><span class="icon-flag langFlag_zh"></span>繁體中文</a></li>
        <li class="zh-CN"><a class="changelanguage-link" data-value="zh-CN"><span class="icon-flag langFlag_zh"></span>简体中文</a></li>
        <li class="ja-JP"><a class="changelanguage-link" data-value="ja-JP"><span class="icon-flag langFlag_ja"></span>日本語</a></li>
        <li class="th-TH"><a class="changelanguage-link" data-value="th-TH"><span class="icon-flag langFlag_th"></span>ภาษาไทย</a></li>
        <li class="ko-KR"><a class="changelanguage-link" data-value="ko-KR"><span class="icon-flag langFlag_ko"></span>한국어</a></li>
        <li class="vi-VN"><a class="changelanguage-link" data-value="vi-VN"><span class="icon-flag langFlag_vi"></span>Tiếng Việt</a></li>
    </ul>
}