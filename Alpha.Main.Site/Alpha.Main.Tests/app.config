<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="CustomerSettingConfiguration" type="Fanex.CustomerSetting.Client40.Configurations.CustomerSettingConfiguration, Fanex.CustomerSetting.Client40" />
    <section name="ProductSection" type="Fanex.Products.Configurations.ProductSection, Fanex.Products, Version=1.0.0.0, Culture=neutral" />
  </configSections>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="$resourcePath_Value" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" />
  <CustomerSettingConfiguration System="1" ServiceUris="http://10.18.200.124:7577/api" CdnUris="http://10.18.200.124:7576" ClientLogCategory="DCS-Setting-Client-LOCAL" AccessDeniedAction="~/User/AccessDenied" SecretKey="U6BUFHtVcq5SPQcTl7tHLBG/LF6d5YVRKHrCHD9M+Vw=" />
  <ProductSection>
    <Products>
      <add id="23" name="NG2" active="true" statusHandlerType="Product_23" />
    </Products>
  </ProductSection>
  
  <system.web>
    <siteMap defaultProvider="AlphaSiteMap" enabled="true">
      <providers>
        <add name="AlphaSiteMap" type="System.Web.XmlSiteMapProvider" siteMapFile="TestData/Alpha.sitemap" />
      </providers>
    </siteMap>
  </system.web>
</configuration>