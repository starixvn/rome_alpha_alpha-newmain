<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Alpha.NetThrottling" type="Alpha.NetThrottling.NetThrottlingConfiguration, Alpha.NetThrottling" />
    <section name="Alpha.NetThrottling.Whitelist" type="Alpha.NetThrottling.WhitelistConfiguration, Alpha.NetThrottling" />
  </configSections>
  <Alpha.NetThrottling resolver="Alpha.NetThrottling.Resolvers.HttpErrorResolver, Alpha.NetThrottling" redisConfigurationOptionsKey="RedisConfigurationOptions:Alpha.NetThrottling">
    <keys>
      <add name="Main" path="*" method="*" maxRequests="30" throttleDuration="30" blockDuration="60" filter="Alpha.NetThrottling.Filters.WhitelistSessionFilter, Alpha.NetThrottling" />
    </keys>
  </Alpha.NetThrottling>
  <Alpha.NetThrottling.Whitelist custIds="17996464,21984259,20269385,15323100,14771858,24338704,19000014,19562449,19562472,27973467,26912753,23003140,14521687,39061067,27783723,26369026,4664545" />
  <system.web>
    <siteMap defaultProvider="AlphaSiteMap" enabled="true">
      <providers>
        <add name="AlphaSiteMap" type="System.Web.XmlSiteMapProvider" siteMapFile="TestData/Menus/EmptySiteMap.sitemap" />
      </providers>
    </siteMap>
  </system.web>

  <runtime>
