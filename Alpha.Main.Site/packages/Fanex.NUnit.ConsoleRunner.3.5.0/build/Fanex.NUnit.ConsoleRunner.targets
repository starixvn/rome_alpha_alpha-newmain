<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Condition="'$(RunNunitTests)' == ''">
    <RunNunitTests>false</RunNunitTests>
  </PropertyGroup>

  <PropertyGroup>
    <BuildDependsOn>$(BuildDependsOn);ExecuteNUnitTests</BuildDependsOn>
    <RebuildDependsOn>$(RebuildDependsOn);ExecuteNUnitTests</RebuildDependsOn>
  </PropertyGroup>
  
  <Target Name="ExecuteNUnitTests"  Condition="'$(RunNunitTests)' == 'true'" >
    <Exec Command="$(MSBuildThisFileDirectory)..\tools\nunit3-console.exe $(OutputPath)$(AssemblyName).dll" />
  </Target>
  
</Project>